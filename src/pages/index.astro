---
import PipelineHeader from '../components/PipelineHeader.astro';
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout>
	<PipelineHeader />

	<main id="main" class="home-page">
		<section class="samples-section" aria-label="Saved output samples">
			<div class="samples-head">
				<div>
					<p class="pipeline-eyebrow">Saved samples</p>
					<h2>Outputs from your project</h2>
				</div>
			</div>
			<p class="samples-status" data-samples-status aria-live="polite"></p>

			<div class="samples-grid">
				<article class="sample-panel stage1-panel">
					<header class="sample-header">
						<span class="sample-step">Stage 1</span>
						<h3>ChatGPT chat links <button class="info-tip" type="button" aria-label="Add and save ChatGPT chat links with titles."><span aria-hidden="true">i</span><span class="info-tip-text" role="tooltip">Add and save ChatGPT chat links with titles.</span></button></h3>
					</header>
					<div class="sample-body stage1-body">
						<p class="sample-empty">Save ChatGPT conversations you want to keep — each entry gets a title and a link.</p>
						<a class="stage1-open" href="/chat-links/">Open <span aria-hidden="true">&rarr;</span></a>
					</div>
				</article>

				<article class="sample-panel" data-sample-stage="frames">
					<header class="sample-header">
						<span class="sample-step">Stage 2</span>
						<h3>Source + frames <button class="info-tip" type="button" aria-label="Pair each saved sheet with its extracted frames from frames/."><span aria-hidden="true">i</span><span class="info-tip-text" role="tooltip">Pair each saved sheet with its extracted frames from <code>frames/</code>.</span></button></h3>
					</header>
					<div class="sample-body" data-sample-body></div>
				</article>

				<article class="sample-panel" data-sample-stage="sequence">
					<header class="sample-header">
						<span class="sample-step">Stage 3</span>
						<h3>Wrong vs corrected <button class="info-tip" type="button" aria-label="Raw order in sequence/wrong/, fixed version in sequence/corrected/."><span aria-hidden="true">i</span><span class="info-tip-text" role="tooltip">Raw order in <code>sequence/wrong/</code>, fixed version in <code>sequence/corrected/</code>.</span></button></h3>
					</header>
					<div class="sample-body" data-sample-body></div>
				</article>
			</div>
		</section>
	</main>

	<script is:inline>
		(() => {
			const IMAGE_RE = /\.(png|webp|jpe?g|gif|avif)$/i;
			const panels = Array.from(document.querySelectorAll('[data-sample-stage]'));
			const status = document.querySelector('[data-samples-status]');
			const fsSupported = !!window.SpriteAnimProject && 'showDirectoryPicker' in window;
			let directoryHandle = null;
			let objectUrls = [];

			const el = (tag, className, text) => {
				const node = document.createElement(tag);
				if (className) node.className = className;
				if (text) node.textContent = text;
				return node;
			};

			const naturalCompare = (a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' });
			const panelBody = (stage) => {
				const panel = panels.find((item) => item.dataset.sampleStage === stage);
				const body = panel.querySelector('[data-sample-body]');
				body.replaceChildren();
				return body;
			};
			const empty = (body, message) => body.append(el('p', 'sample-empty', message));
			const urlFor = (file) => {
				const url = URL.createObjectURL(file);
				objectUrls.push(url);
				return url;
			};
			const thumbFor = (file, className) => {
				const img = el('img', className);
				img.src = urlFor(file);
				img.alt = file.name;
				img.loading = 'lazy';
				return img;
			};
			const showcaseImg = (src, className, alt) => {
				const img = el('img', className);
				img.src = src;
				img.alt = alt || '';
				img.loading = 'lazy';
				return img;
			};

			const SHOWCASE_FRAMES = Array.from({ length: 7 }, (_, index) => ({
				name: `frame-${String(index + 1).padStart(3, '0')}.png`,
				src: `/assets/showcase/frames/frame-${String(index + 1).padStart(3, '0')}.png`,
			}));
			const SEQUENCE_WRONG_FRAMES = Array.from({ length: 7 }, (_, index) =>
				`/assets/showcase/sequence/wrong/frame-${String(index + 1).padStart(3, '0')}.png`);
			const SEQUENCE_CORRECTED_FRAMES = Array.from({ length: 7 }, (_, index) =>
				`/assets/showcase/sequence/corrected/frame-${String(index + 1).padStart(3, '0')}.png`);

			function renderShowcase() {
				const framesBody = panelBody('frames');
				const pair = el('section', 'sample-pair');
				const sourceSide = el('div', 'sample-pair-side');
				sourceSide.append(
					el('span', 'sample-pair-label', 'Sheet'),
					showcaseImg('/assets/showcase/generated/zombie-cycle.png', 'sample-pair-image', 'zombie-cycle.png'),
					el('span', 'sample-pair-name', 'zombie-cycle.png'),
				);
				const framesSide = el('div', 'sample-pair-side');
				framesSide.append(el('span', 'sample-pair-label', `${SHOWCASE_FRAMES.length} frames`));
				const grid = el('div', 'sample-frames-grid');
				SHOWCASE_FRAMES.forEach((frame) => grid.append(showcaseImg(frame.src, 'sample-frame', frame.name)));
				framesSide.append(grid);
				pair.append(sourceSide, framesSide);
				framesBody.append(pair);

				const sequenceBody = panelBody('sequence');
				const seqRow = el('article', 'sample-seq');
				const wrongSide = el('div', 'sample-seq-side');
				wrongSide.append(el('span', 'sample-pair-label', 'Wrong'));
				const wrongStrip = el('div', 'sample-seq-strip wrong');
				[3, 0, 4, 1, 5, 2, 6].forEach((index) => {
					wrongStrip.append(showcaseImg(SEQUENCE_WRONG_FRAMES[index], 'sample-seq-frame', `frame ${index + 1}`));
				});
				wrongSide.append(wrongStrip);
				const correctedSide = el('div', 'sample-seq-side');
				correctedSide.append(el('span', 'sample-pair-label', 'Corrected'));
				const correctedStrip = el('div', 'sample-seq-strip');
				SEQUENCE_CORRECTED_FRAMES.forEach((src, index) => {
					correctedStrip.append(showcaseImg(src, 'sample-seq-frame', `frame ${index + 1}`));
				});
				correctedSide.append(correctedStrip);
				seqRow.append(wrongSide, el('span', 'sample-seq-arrow', '→'), correctedSide);
				sequenceBody.append(seqRow);
			}

			const openDatabase = () => new Promise((resolve, reject) => {
				const request = indexedDB.open('spriteanim-v2-handles', 1);
				request.onupgradeneeded = () => {
					if (!request.result.objectStoreNames.contains('handles')) request.result.createObjectStore('handles');
				};
				request.onsuccess = () => resolve(request.result);
				request.onerror = () => reject(request.error);
			});

			const storedKey = () => window.SpriteAnimProject.getStorageKey('samples-directory');

			const getStoredHandle = async () => {
				try {
					const database = await openDatabase();
					return await new Promise((resolve, reject) => {
						const transaction = database.transaction('handles', 'readonly');
						const request = transaction.objectStore('handles').get(storedKey());
						request.onsuccess = () => resolve(request.result || null);
						request.onerror = () => reject(request.error);
					});
				} catch {
					return null;
				}
			};

			const ensurePermission = async (handle, request) => {
				const options = { mode: 'read' };
				if (await handle.queryPermission(options) === 'granted') return true;
				if (!request) return false;
				return (await handle.requestPermission(options)) === 'granted';
			};

			async function walk(directory, prefix, out) {
				for await (const entry of directory.values()) {
					const path = prefix ? `${prefix}/${entry.name}` : entry.name;
					if (entry.kind === 'directory') {
						out.push({ kind: 'directory', name: entry.name, path });
						await walk(entry, path, out);
					} else {
						const file = await entry.getFile();
						out.push({ kind: 'file', name: entry.name, path, file });
					}
				}
			}

			const images = (list) => list
				.filter((entry) => entry.kind === 'file' && IMAGE_RE.test(entry.name))
				.sort((a, b) => naturalCompare(a.name, b.name));
			const inDir = (list, dir) => list.filter((entry) => entry.path.startsWith(`${dir}/`));

			function groupFrames(list) {
				const groups = new Map();
				list.forEach((entry) => {
					const rest = entry.path.slice('frames/'.length);
					const slash = rest.indexOf('/');
					const group = slash === -1 ? '' : rest.slice(0, slash);
					if (!groups.has(group)) groups.set(group, []);
					groups.get(group).push(entry);
				});
				return Array.from(groups, ([name, files]) => ({ name, files }));
			}

			function buildPairs(sources, frames) {
				const groups = groupFrames(frames);
				const pairs = [];
				const usedStems = new Set();
				sources.forEach((source) => {
					const stem = source.name.replace(IMAGE_RE, '').toLowerCase();
					const group = groups.find((item) => item.name && item.name.toLowerCase() === stem);
					if (group) {
						pairs.push({ source, frames: group.files });
						usedStems.add(stem);
					}
				});
				const top = groups.find((item) => !item.name);
				if (top?.files.length) {
					const fallback = [...sources].reverse().find((source) => !usedStems.has(source.name.replace(IMAGE_RE, '').toLowerCase()))
						|| sources[sources.length - 1] || null;
					pairs.push({ source: fallback, frames: top.files });
				}
				return pairs;
			}

			function renderFrames(sources, frames, body) {
				const pairs = buildPairs(sources, frames);
				if (!pairs.length) {
					empty(body, 'No pairs yet. Save a sheet in generated/ and its extracted frames in frames/.');
					return;
				}
				pairs.forEach((pair) => {
					const block = el('section', 'sample-pair');
					const sourceSide = el('div', 'sample-pair-side');
					sourceSide.append(el('span', 'sample-pair-label', 'Sheet'));
					if (pair.source) {
						sourceSide.append(thumbFor(pair.source.file, 'sample-pair-image'), el('span', 'sample-pair-name', pair.source.name));
					} else {
						sourceSide.append(el('span', 'sample-empty', 'No saved source sheet.'));
					}
					const framesSide = el('div', 'sample-pair-side');
					framesSide.append(el('span', 'sample-pair-label', `${pair.frames.length} frame${pair.frames.length === 1 ? '' : 's'}`));
					const grid = el('div', 'sample-frames-grid');
					pair.frames.forEach((entry) => grid.append(thumbFor(entry.file, 'sample-frame')));
					framesSide.append(grid);
					block.append(sourceSide, framesSide);
					body.append(block);
				});
			}

			function renderSequence(wrong, corrected, body) {
				if (!wrong.length && !corrected.length) {
					empty(body, 'No sequence samples yet. Save raw frames in sequence/wrong/ and the fixed version in sequence/corrected/.');
					return;
				}
				const stems = new Set([...wrong, ...corrected].map((entry) => entry.name.replace(IMAGE_RE, '')));
				Array.from(stems).sort(naturalCompare).forEach((stem) => {
					const wrongEntry = wrong.find((entry) => entry.name.replace(IMAGE_RE, '') === stem);
					const fixedEntry = corrected.find((entry) => entry.name.replace(IMAGE_RE, '') === stem);
					const row = el('article', 'sample-seq');
					const wrongSide = el('div', 'sample-seq-side');
					wrongSide.append(el('span', 'sample-pair-label', 'Wrong'));
					wrongSide.append(wrongEntry ? thumbFor(wrongEntry.file, 'sample-seq-image') : el('span', 'sample-empty', 'Missing'));
					const arrow = el('span', 'sample-seq-arrow', '→');
					const fixedSide = el('div', 'sample-seq-side');
					fixedSide.append(el('span', 'sample-pair-label', 'Corrected'));
					fixedSide.append(fixedEntry ? thumbFor(fixedEntry.file, 'sample-seq-image') : el('span', 'sample-empty', 'Not saved yet'));
					row.append(wrongSide, arrow, fixedSide);
					body.append(row);
				});
			}

			const revokeAll = () => {
				objectUrls.forEach((url) => URL.revokeObjectURL(url));
				objectUrls = [];
			};

			async function renderSamples() {
				revokeAll();
				if (!directoryHandle) {
					renderShowcase();
					return;
				}
				const entries = [];
				await walk(directoryHandle, '', entries);
				const generated = images(inDir(entries, 'generated'));
				const frames = images(inDir(entries, 'frames'));
				const wrong = images(inDir(entries, 'sequence/wrong'));
				const corrected = images(inDir(entries, 'sequence/corrected'));
				if (!generated.length && !frames.length && !wrong.length && !corrected.length) {
					renderShowcase();
					status.textContent = `Showcase: zombie-jump — no saved samples in "${directoryHandle.name}" yet.`;
					return;
				}
				renderFrames(generated, frames, panelBody('frames'));
				renderSequence(wrong, corrected, panelBody('sequence'));
				status.textContent = `Folder: ${directoryHandle.name} — samples refresh on page reload.`;
			}

			async function init() {
				revokeAll();
				directoryHandle = null;
				if (!fsSupported) {
					status.textContent = 'Showcase: zombie-jump · jump-cycle — set a samples folder from the gear menu to view saved files.';
					renderShowcase();
					return;
				}
				const stored = await getStoredHandle();
				if (stored) {
					directoryHandle = stored;
					if (await ensurePermission(stored, false)) {
						await renderSamples();
						return;
					}
					status.textContent = 'Showcase: zombie-jump · jump-cycle — folder remembered; pick it once from the gear menu to refresh access.';
					renderShowcase();
					return;
				}
				status.textContent = 'Showcase: zombie-jump · jump-cycle — default folder D:\\SpriteAnimProjects\\anim-projects\\zombie-jump';
				renderShowcase();
			}

			window.addEventListener('spriteanim-project-change', () => void init());
			window.addEventListener('spriteanim-samples-folder-change', () => void init());

			void init();
		})();
	</script>

	<style is:global>
		.home-page {
			min-height: calc(100vh - 7.5rem);
			background:
				radial-gradient(circle at 88% 7%, rgba(255, 232, 244, 0.86), transparent 34rem),
				linear-gradient(180deg, #fafbfc 0%, #ffffff 58%, #fff6fb 100%);
			color: var(--color-ink);
			padding: 2rem clamp(1rem, 3vw, 2.65rem) 2.25rem;
		}

		.pipeline-eyebrow {
			margin: 0 0 0.4rem;
			color: var(--color-mute);
			font-family: var(--font-mono);
			font-size: 0.72rem;
			letter-spacing: 0.08em;
			text-transform: uppercase;
		}

		.samples-section {
			width: min(100%, 96.25rem);
			margin: 1.5rem auto 0;
		}

		.samples-head {
			display: flex;
			align-items: end;
			justify-content: space-between;
			gap: 1rem;
			flex-wrap: wrap;
			margin-bottom: 0.45rem;
		}

		.samples-head h2 {
			margin: 0;
			font-size: clamp(1.4rem, 2vw, 1.9rem);
			line-height: 1.15;
		}

		.samples-status {
			min-height: 1.4em;
			margin: 0 0 1rem;
			color: var(--color-mute);
			font-family: var(--font-mono);
			font-size: 0.72rem;
		}

		.samples-grid {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1rem;
			align-items: start;
		}

		.sample-panel {
			min-width: 0;
			overflow: hidden;
			border: 1px solid var(--color-hairline);
			border-radius: 0.75rem;
			background: #fff;
			box-shadow: 0 1px 1px rgba(0, 0, 0, 0.03), 0 2px 2px rgba(0, 0, 0, 0.04);
		}

		.sample-header {
			display: flex;
			align-items: center;
			gap: 0.65rem;
			padding: 0.9rem 1rem;
			border-bottom: 1px solid var(--color-hairline);
		}

		.sample-step {
			flex: 0 0 auto;
			display: grid;
			min-width: 1.6rem;
			height: 1.6rem;
			place-items: center;
			border-radius: 999px;
			background: #171917;
			color: #fff;
			font-family: var(--font-mono);
			font-size: 0.7rem;
			font-weight: 700;
		}

		.sample-header h3 {
			margin: 0;
			font-size: 0.88rem;
			line-height: 1.3;
		}

		.sample-body {
			padding: 1rem;
		}

		.sample-empty {
			margin: 0;
			color: var(--color-mute);
			font-size: 0.8rem;
			line-height: 1.5;
		}

		.stage1-body {
			display: grid;
			gap: 1rem;
			align-content: start;
		}

		.stage1-open {
			display: inline-flex;
			align-items: center;
			gap: 0.45rem;
			justify-self: start;
			border: 1px solid #d3d8d3;
			border-radius: 999px;
			background: #171917;
			color: #fff;
			padding: 0.55rem 0.95rem;
			font-size: 0.8rem;
			font-weight: 720;
			text-decoration: none;
			transition: background 140ms ease, border-color 140ms ease;
		}

		.stage1-open:hover,
		.stage1-open:focus-visible {
			border-color: #74a900;
			background: #2c312c;
			outline: none;
		}

		.sample-row {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr);
			gap: 0.75rem;
			align-items: center;
		}

		.sample-row-copy {
			display: grid;
			gap: 0.2rem;
			min-width: 0;
		}

		.sample-row-copy strong {
			overflow: hidden;
			font-size: 0.82rem;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.sample-row-copy span {
			overflow: hidden;
			color: var(--color-mute);
			font-family: var(--font-mono);
			font-size: 0.66rem;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.sample-thumb {
			width: 5.5rem;
			aspect-ratio: 16 / 10;
			object-fit: contain;
			border: 1px solid #e2e2e2;
			border-radius: 0.4rem;
			background-color: #fff;
			background-image:
				linear-gradient(45deg, #e9e9e9 25%, transparent 25%),
				linear-gradient(-45deg, #e9e9e9 25%, transparent 25%),
				linear-gradient(45deg, transparent 75%, #e9e9e9 75%),
				linear-gradient(-45deg, transparent 75%, #e9e9e9 75%);
			background-position: 0 0, 0 6px, 6px -6px, -6px 0;
			background-size: 12px 12px;
		}

		.sample-pair {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr);
			gap: 0.85rem;
			align-items: start;
		}

		.sample-pair-side {
			display: grid;
			gap: 0.45rem;
			min-width: 0;
		}

		.sample-pair-label {
			color: var(--color-mute);
			font-family: var(--font-mono);
			font-size: 0.66rem;
			letter-spacing: 0.05em;
			text-transform: uppercase;
		}

		.sample-pair-image {
			width: 100%;
			height: 6.5rem;
			object-fit: contain;
			border: 1px solid #e2e2e2;
			border-radius: 0.4rem;
			background-color: #fff;
			background-image:
				linear-gradient(45deg, #e9e9e9 25%, transparent 25%),
				linear-gradient(-45deg, #e9e9e9 25%, transparent 25%),
				linear-gradient(45deg, transparent 75%, #e9e9e9 75%),
				linear-gradient(-45deg, transparent 75%, #e9e9e9 75%);
			background-position: 0 0, 0 6px, 6px -6px, -6px 0;
			background-size: 12px 12px;
		}

		.sample-pair-name {
			overflow: hidden;
			font-family: var(--font-mono);
			font-size: 0.68rem;
			text-overflow: ellipsis;
			white-space: nowrap;
		}

		.sample-frames-grid {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(2.6rem, 1fr));
			gap: 0.35rem;
		}

		.sample-frame {
			width: 100%;
			aspect-ratio: 1;
			object-fit: contain;
			border: 1px solid #e2e2e2;
			border-radius: 0.3rem;
			background-color: #fff;
			background-image:
				linear-gradient(45deg, #e9e9e9 25%, transparent 25%),
				linear-gradient(-45deg, #e9e9e9 25%, transparent 25%),
				linear-gradient(45deg, transparent 75%, #e9e9e9 75%),
				linear-gradient(-45deg, transparent 75%, #e9e9e9 75%);
			background-position: 0 0, 0 6px, 6px -6px, -6px 0;
			background-size: 12px 12px;
		}

		.sample-seq {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
			align-items: center;
			gap: 0.6rem;
		}

		.sample-seq-side {
			display: grid;
			gap: 0.35rem;
			min-width: 0;
		}

		.sample-seq-image {
			width: 100%;
			height: 4.5rem;
			object-fit: contain;
			border: 1px solid #e2e2e2;
			border-radius: 0.35rem;
			background-color: #fff;
			background-image:
				linear-gradient(45deg, #e9e9e9 25%, transparent 25%),
				linear-gradient(-45deg, #e9e9e9 25%, transparent 25%),
				linear-gradient(45deg, transparent 75%, #e9e9e9 75%),
				linear-gradient(-45deg, transparent 75%, #e9e9e9 75%);
			background-position: 0 0, 0 6px, 6px -6px, -6px 0;
			background-size: 12px 12px;
		}

		.sample-seq-arrow {
			color: var(--color-mute);
			font-size: 1.05rem;
			font-weight: 800;
		}

		.sample-seq-strip {
			display: flex;
			gap: 0.25rem;
			overflow-x: auto;
			padding-bottom: 0.15rem;
		}

		.sample-seq-frame {
			flex: none;
			width: 2.4rem;
			height: 2.4rem;
			object-fit: contain;
			border: 1px solid #e2e2e2;
			border-radius: 0.3rem;
			background-color: #fff;
			background-image:
				linear-gradient(45deg, #e9e9e9 25%, transparent 25%),
				linear-gradient(-45deg, #e9e9e9 25%, transparent 25%),
				linear-gradient(45deg, transparent 75%, #e9e9e9 75%),
				linear-gradient(-45deg, transparent 75%, #e9e9e9 75%);
			background-position: 0 0, 0 6px, 6px -6px, -6px 0;
			background-size: 12px 12px;
		}

		.sample-seq-strip.wrong .sample-seq-frame:nth-child(even) {
			transform: rotate(-7deg) translateY(0.18rem);
		}

		.sample-seq-strip.wrong .sample-seq-frame:nth-child(3n) {
			transform: rotate(6deg) translateX(-0.25rem);
		}

		.info-tip {
