---
import PipelineHeader from '../components/PipelineHeader.astro';

const pageTitle = 'GIF to Frames · SpriteLab';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta
			name="description"
			content="Extract video frames or load an image folder, then remove backgrounds locally."
		/>
		<title>{pageTitle}</title>
		<style is:global>
			:root {
				font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				color: #171917;
				background: #f4f5f4;
				font-synthesis: none;
			}

			* { box-sizing: border-box; }

			body {
				min-width: 320px;
				min-height: 100vh;
				margin: 0;
				background: #f4f5f4;
			}

			button,
			input { font: inherit; }

			button { cursor: pointer; }

			button:disabled {
				cursor: not-allowed;
				opacity: 0.45;
			}

			button:focus-visible,
			input:focus-visible,
			label:focus-within {
				outline: 2px solid #171917;
				outline-offset: 2px;
			}

			.utility-bar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				height: 52px;
				padding: 0 clamp(16px, 3vw, 40px);
				color: #f8faf8;
				background: #171917;
			}

			.brand {
				margin: 0;
				font-size: 0.875rem;
				font-weight: 680;
				letter-spacing: 0;
			}

			.local-status {
				display: flex;
				align-items: center;
				gap: 8px;
				font-size: 0.75rem;
				color: #bec4be;
			}

			.local-dot {
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: #52d273;
				box-shadow: 0 0 0 3px rgba(82, 210, 115, 0.14);
			}

			main {
				width: min(1240px, calc(100% - 32px));
				margin: clamp(24px, 5vw, 64px) auto;
			}

			.workbench {
				border: 1px solid #d9ddd9;
				border-radius: 8px;
				background: #ffffff;
				box-shadow: 0 16px 48px rgba(20, 24, 20, 0.07);
			}

			.workbench-head {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				gap: 24px;
				padding: 24px 26px 20px;
				border-bottom: 1px solid #e4e7e4;
			}

			h1 {
				margin: 0;
				font-size: clamp(1.25rem, 2vw, 1.6rem);
				line-height: 1.2;
				letter-spacing: 0;
			}

			.info-tip {
				position: relative;
				display: inline-grid;
				width: 17px;
				height: 17px;
				place-items: center;
				margin-left: 7px;
				padding: 0;
				border: 1px solid #c9cec9;
				border-radius: 999px;
				background: #fff;
				color: #7a817a;
				font-size: 0.6rem;
				font-weight: 800;
				line-height: 1;
				vertical-align: middle;
				cursor: help;
			}

			.info-tip-text {
				position: absolute;
				z-index: 60;
				bottom: calc(100% + 7px);
				left: 50%;
				width: max-content;
				max-width: 250px;
				padding: 8px 10px;
				border: 1px solid #d9ddd9;
				border-radius: 6px;
				background: #fff;
				color: #4d534d;
				font-size: 0.72rem;
				font-weight: 500;
				line-height: 1.5;
				text-align: left;
				text-transform: none;
				letter-spacing: 0;
				box-shadow: 0 10px 30px rgba(20, 24, 20, 0.14);
				opacity: 0;
				visibility: hidden;
				transform: translate(-50%, 4px);
				transition: opacity 140ms ease, transform 140ms ease, visibility 0s linear 140ms;
				pointer-events: none;
			}

			.info-tip:hover .info-tip-text,
			.info-tip:focus-visible .info-tip-text,
			.info-tip:focus .info-tip-text {
				opacity: 1;
				visibility: visible;
				transform: translate(-50%, 0);
				transition-delay: 0s;
			}

			.info-tip.tip-down .info-tip-text {
				bottom: auto;
				top: calc(100% + 7px);
			}

			.clear-button {
				min-height: 36px;
				padding: 0 13px;
				border: 1px solid #d9ddd9;
				border-radius: 6px;
				color: #363a36;
				background: #ffffff;
				font-size: 0.8rem;
				font-weight: 620;
			}

			.clear-button:hover { border-color: #8d948d; }

			.setup {
				display: grid;
				grid-template-columns: minmax(250px, 1.4fr) minmax(430px, 2fr);
				gap: 18px;
				padding: 22px 26px;
				border-bottom: 1px solid #e4e7e4;
			}

			.drop-zone {
				display: flex;
				align-items: center;
				gap: 14px;
				min-height: 92px;
				padding: 15px 18px;
				border: 1px dashed #aeb4ae;
				border-radius: 6px;
				background: #fafbfa;
				transition: border-color 150ms ease, background 150ms ease;
			}

			.drop-zone:hover,
			.drop-zone[data-dragging="true"] {
				border-color: #238f43;
				background: #f3fbf5;
			}

			.upload-mark {
				display: grid;
				flex: 0 0 40px;
				width: 40px;
				height: 40px;
				place-items: center;
				border: 1px solid #d9ddd9;
				border-radius: 6px;
				background: #ffffff;
				font-size: 1.1rem;
				font-weight: 700;
			}

			.drop-copy { min-width: 0; }

			.file-name {
				display: block;
				overflow: hidden;
				margin-bottom: 4px;
				font-size: 0.875rem;
				font-weight: 650;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			.file-hint {
				display: block;
				font-size: 0.75rem;
				line-height: 1.45;
				color: #747a74;
			}

			.choose-label {
				border: 0;
				font: inherit;
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				min-height: 32px;
				margin-top: 9px;
				padding: 0 11px;
				border-radius: 5px;
				color: #ffffff;
				background: #252825;
				font-size: 0.75rem;
				font-weight: 650;
			}

			.source-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 8px;
			}

			.choose-label.secondary {
				border: 1px solid #cfd4cf;
				color: #363a36;
				background: #ffffff;
			}

			.choose-label.secondary:hover { border-color: #8d948d; }

			.file-input {
				position: absolute;
				width: 1px;
				height: 1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
			}

			.controls {
				display: grid;
				grid-template-columns: minmax(110px, 0.6fr) minmax(250px, 1.4fr) minmax(135px, 0.75fr);
				gap: 14px;
				align-items: end;
			}

			.control-label {
				display: block;
				margin-bottom: 7px;
				font-size: 0.72rem;
				font-weight: 680;
				color: #545954;
			}

			.number-input {
				width: 100%;
				height: 40px;
				padding: 0 11px;
				border: 1px solid #cfd4cf;
				border-radius: 5px;
				background: #ffffff;
			}

			.fixed-control { display: grid; height: 40px; place-items: center; border: 1px solid #cfd4cf; border-radius: 5px; background: #f5f6f5; color: #363a36; font-size: 0.78rem; font-weight: 650; }

			.segments {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				height: 40px;
				padding: 3px;
				border: 1px solid #cfd4cf;
				border-radius: 5px;
				background: #f5f6f5;
			}

			.segment {
				border: 0;
				border-radius: 3px;
				color: #656b65;
				background: transparent;
				font-size: 0.75rem;
				font-weight: 650;
			}

			.segment[aria-pressed="true"] {
				color: #171917;
				background: #ffffff;
				box-shadow: 0 1px 4px rgba(20, 24, 20, 0.12);
			}

			.extract-button {
				height: 40px;
				border: 1px solid #21853d;
				border-radius: 5px;
				color: #ffffff;
				background: #238f43;
				font-size: 0.8rem;
				font-weight: 700;
			}

			.extract-button:hover:not(:disabled) { background: #1d7c38; }

			.processing-row {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 20px;
				padding: 16px 26px;
				border-bottom: 1px solid #e4e7e4;
				background: #ffffff;
			}

			.background-settings,
			.processing-actions {
				display: flex;
				align-items: end;
				gap: 12px;
			}

			.color-input {
				display: block;
				width: 52px;
				height: 40px;
				padding: 4px;
				border: 1px solid #cfd4cf;
				border-radius: 5px;
				background: #ffffff;
			}

			.tolerance-input {
				width: 86px;
				height: 40px;
				padding: 0 10px;
				border: 1px solid #cfd4cf;
				border-radius: 5px;
				background: #ffffff;
			}

			.process-button,
			.save-button {
				height: 40px;
				padding: 0 15px;
				border-radius: 5px;
				font-size: 0.8rem;
				font-weight: 700;
				white-space: nowrap;
			}

			.process-button {
				border: 1px solid #303530;
				color: #ffffff;
				background: #303530;
			}

			.process-button:hover:not(:disabled) { background: #171917; }

			.save-button {
				border: 1px solid #21853d;
				color: #1d7034;
				background: #f2fbf4;
			}

			.save-button:hover:not(:disabled) { background: #e5f7e9; }

			.crop-launch { border-color: #7146c7; color: #5f35b2; }
			.crop-overlay { position: fixed; inset: 0; z-index: 100; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; padding: 18px; background: rgba(8, 10, 8, 0.96); color: #fff; }
			.crop-overlay[hidden] { display: none; }
			.crop-head, .crop-footer { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 10px 0; }
			.crop-head h2 { margin: 0; font-size: 1rem; }
			.crop-stage { position: relative; min-height: 0; overflow: hidden; touch-action: none; cursor: crosshair; }
			.crop-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; user-select: none; pointer-events: none; }
			.crop-selection { position: fixed; border: 2px solid #a8ee19; background: rgba(168, 238, 25, 0.12); box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.42); pointer-events: none; }
			.crop-footer { justify-content: flex-end; }
			.crop-size { margin-right: auto; color: #c8cec8; font-family: Consolas, monospace; font-size: 0.76rem; }
			.crop-overlay .button { min-height: 40px; padding: 0 16px; border: 1px solid #747a74; border-radius: 6px; color: #fff; background: #252925; font-weight: 700; }
			.crop-overlay .button.primary { border-color: #a8ee19; color: #111; background: #a8ee19; }
			.gif-library { padding: 18px 26px; border-bottom: 1px solid #e4e7e4; background: #fbfcfb; }
			.gif-library-head { margin-bottom: 12px; }
			.gif-library-controls { display: grid; grid-template-columns: minmax(180px, 1fr) minmax(180px, 1fr); gap: 10px; }
			.gif-project-select { min-width: 180px; height: 36px; border: 1px solid #cfd4cf; border-radius: 6px; background: #fff; padding: 0 9px; font-size: 0.76rem; }
			.gif-library-head h2 { margin: 0; font-size: 0.86rem; text-transform: uppercase; letter-spacing: 0.04em; }
			.gif-preview-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 12px; }
			.gif-preview-card { min-width: 0; border: 1px solid #d9ddd9; border-radius: 7px; background: #fff; overflow: hidden; }
			.gif-preview-title { display: block; overflow: hidden; padding: 9px 11px; border-bottom: 1px solid #e4e7e4; font-family: Consolas, monospace; font-size: 0.72rem; text-overflow: ellipsis; white-space: nowrap; }
			.gif-preview-media { display: grid; height: min(42vh, 390px); place-items: center; background: #171917; }
			.gif-preview-media img, .gif-preview-media video { display: block; max-width: 100%; max-height: 100%; object-fit: contain; }
			.gif-preview-empty { color: #aeb4ae; font-size: 0.76rem; }
			.library-empty { margin: 0; color: #747a74; font-size: 0.78rem; }
			.crop-summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 26px; border-bottom: 1px solid #e4e7e4; background: #fff; }
			.crop-summary .file-hint { font-size: 0.78rem; }
			.import-setup { grid-template-columns: 1fr; }
			.crop-summary { display: block; }
			.crop-summary-main { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
			.crop-summary .controls { margin-top: 14px; }
			.sheet-builder { padding: 22px 26px 26px; border-top: 1px solid #e4e7e4; background: #fff; }
			.sheet-builder h2 { margin: 0 0 6px; font-size: 1rem; }
			.sheet-builder-copy { margin: 0 0 16px; color: #747a74; font-size: 0.78rem; }
			.sheet-controls { display: grid; grid-template-columns: 90px 90px auto; align-items: end; justify-content: end; gap: 10px; }
			.sheet-field { display: grid; gap: 6px; min-width: 0; }
			.sheet-field span { color: #545954; font-size: 0.7rem; font-weight: 680; }
			.sheet-field select, .sheet-field input { width: 100%; height: 38px; min-width: 0; border: 1px solid #cfd4cf; border-radius: 5px; background: #fff; padding: 0 9px; font-size: 0.76rem; }
			.sheet-preview-wrap { display: grid; min-height: 180px; place-items: center; margin-top: 16px; overflow: auto; border: 1px dashed #c7ccc7; border-radius: 7px; background-color: #fff; background-image: linear-gradient(45deg,#eee 25%,transparent 25%),linear-gradient(-45deg,#eee 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#eee 75%),linear-gradient(-45deg,transparent 75%,#eee 75%); background-position: 0 0,0 8px,8px -8px,-8px 0; background-size: 16px 16px; }
			.sheet-preview { display: block; max-width: 100%; max-height: 520px; object-fit: contain; }
			.sheet-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 12px; }
			@media (max-width: 900px) { .sheet-controls { grid-template-columns: 1fr 1fr; } .sheet-controls .extract-button { grid-column: 1 / -1; } }

			.progress-row {
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				gap: 16px;
				align-items: center;
				min-height: 50px;
				padding: 10px 26px;
				border-bottom: 1px solid #e4e7e4;
				background: #fbfcfb;
			}

			.progress-stack {
				display: grid;
				grid-template-columns: minmax(120px, 190px) minmax(120px, 1fr);
				gap: 14px;
				align-items: center;
			}

			.status {
				overflow: hidden;
				font-size: 0.76rem;
				color: #555b55;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			.progress-track {
				height: 5px;
				overflow: hidden;
				border-radius: 5px;
				background: #e3e7e3;
			}

			.progress-fill {
				width: 0;
				height: 100%;
				background: #2db653;
				transition: width 120ms linear;
			}

			.summary {
				font-family: "SFMono-Regular", Consolas, monospace;
				font-size: 0.7rem;
				color: #747a74;
				white-space: nowrap;
			}

			.gallery-shell {
				padding: 20px 26px 26px;
			}

			.gallery {
				display: grid;
				grid-template-columns: repeat(var(--columns, 4), minmax(0, 1fr));
				gap: 12px;
				align-content: start;
				min-height: 390px;
				max-height: 61vh;
				overflow: auto;
				padding-right: 4px;
				scrollbar-gutter: stable;
			}

			.gallery[data-columns="auto"] {
				grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
			}

			.empty-state {
				display: grid;
				grid-column: 1 / -1;
				min-height: 390px;
				place-items: center;
				border: 1px solid #e1e4e1;
				background:
					linear-gradient(45deg, #f8f9f8 25%, transparent 25%),
					linear-gradient(-45deg, #f8f9f8 25%, transparent 25%),
					linear-gradient(45deg, transparent 75%, #f8f9f8 75%),
					linear-gradient(-45deg, transparent 75%, #f8f9f8 75%);
				background-position: 0 0, 0 10px, 10px -10px, -10px 0;
				background-size: 20px 20px;
				color: #747a74;
				text-align: center;
			}

			.empty-state strong {
				display: block;
				margin-bottom: 5px;
				color: #424742;
				font-size: 0.875rem;
			}

			.empty-state span { font-size: 0.78rem; }

			.frame {
				min-width: 0;
				margin: 0;
				border: 1px solid #dfe3df;
				border-radius: 5px;
				overflow: hidden;
				background: #ffffff;
			}

			.frame-image {
				display: block;
				width: 100%;
				aspect-ratio: 16 / 9;
				object-fit: contain;
				background-color: #ffffff;
				background-image:
					linear-gradient(45deg, #e5e8e5 25%, transparent 25%),
					linear-gradient(-45deg, #e5e8e5 25%, transparent 25%),
					linear-gradient(45deg, transparent 75%, #e5e8e5 75%),
					linear-gradient(-45deg, transparent 75%, #e5e8e5 75%);
				background-position: 0 0, 0 8px, 8px -8px, -8px 0;
				background-size: 16px 16px;
			}

			.frame[data-processed="true"] { border-color: #9fd9ad; }
			.frame { position: relative; cursor: pointer; }
			.frame[data-selected="true"] { border-color: #238f43; box-shadow: inset 0 0 0 2px #238f43; }
			.frame[data-selected="true"]::after { content: '✓'; position: absolute; top: 7px; right: 7px; display: grid; width: 25px; height: 25px; place-items: center; border-radius: 999px; background: #238f43; color: #fff; font-weight: 850; }
			.sequence-builder { padding: 22px 26px 26px; border-top: 1px solid #e4e7e4; background: #fbfcfb; }
			.sequence-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
			.sequence-head h2 { margin: 0; font-size: 1rem; }
			.sequence-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 10px; min-height: 150px; }
			.sequence-empty { grid-column: 1 / -1; display: grid; min-height: 150px; place-items: center; border: 1px dashed #c7ccc7; border-radius: 7px; color: #747a74; font-size: 0.78rem; }
			.sequence-card { position: relative; margin: 0; overflow: hidden; border: 1px solid #9fd9ad; border-radius: 6px; background: #fff; }
			.sequence-card img { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: contain; background: #eef1ee; }
			.sequence-order { position: absolute; top: 6px; left: 6px; min-width: 25px; padding: 5px; border-radius: 4px; background: #252925; color: #fff; font: 700 0.68rem Consolas, monospace; text-align: center; }
			.sequence-buttons { position: absolute; top: 6px; right: 6px; display: flex; gap: 4px; }
			.sequence-buttons button { width: 27px; height: 27px; padding: 0; border: 0; border-radius: 4px; background: #303530; color: #fff; font-weight: 800; }
			.sequence-buttons .drag-handle { cursor: grab; font-size: 1rem; line-height: 1; }
			.sequence-buttons .drag-handle:active { cursor: grabbing; }
			.sequence-caption { display: block; overflow: hidden; padding: 7px 9px; font: 0.67rem Consolas, monospace; text-overflow: ellipsis; white-space: nowrap; }
			.saved-sheets { padding: 22px 26px 26px; border-top: 1px solid #e4e7e4; background: #fbfcfb; }
			.saved-sheets h2 { margin: 0 0 6px; font-size: 1rem; }
			.saved-sheets-copy { margin: 0 0 14px; color: #747a74; font-size: 0.78rem; }
			.saved-sheets-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
			.saved-sheet-card { min-width: 0; margin: 0; overflow: hidden; border: 1px solid #d9ddd9; border-radius: 7px; background: #fff; }
			.saved-sheet-card img { display: block; width: 100%; height: 180px; object-fit: contain; background-color: #fff; background-image: linear-gradient(45deg,#eee 25%,transparent 25%),linear-gradient(-45deg,#eee 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#eee 75%),linear-gradient(-45deg,transparent 75%,#eee 75%); background-position: 0 0,0 8px,8px -8px,-8px 0; background-size: 16px 16px; }
			.saved-sheet-card figcaption { display: grid; gap: 3px; padding: 8px 10px; }
			.saved-sheet-name { overflow: hidden; font: 0.7rem Consolas, monospace; text-overflow: ellipsis; white-space: nowrap; }
			.saved-sheet-meta { color: #747a74; font-size: 0.68rem; }
			.saved-sheet-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 0 10px 10px; }
			.saved-sheet-actions button { min-height: 34px; border: 1px solid #cfd4cf; border-radius: 5px; background: #fff; color: #363a36; font-size: 0.72rem; font-weight: 700; }
			.saved-sheet-actions button:hover { border-color: #74a900; color: #111; }

			.frame-caption {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 8px;
				padding: 8px 9px;
				font-family: "SFMono-Regular", Consolas, monospace;
				font-size: 0.67rem;
				color: #626862;
			}

			.frame-number { color: #222522; }

			.frame-source {
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			.hidden-media {
				position: fixed;
				left: -10000px;
				top: 0;
				width: 1px;
				height: 1px;
				opacity: 0;
				pointer-events: none;
			}

			@media (max-width: 900px) {
				.setup { grid-template-columns: 1fr; }
				.gallery { grid-template-columns: repeat(3, minmax(0, 1fr)); }
			}

			@media (max-width: 640px) {
				main {
					width: min(100% - 20px, 1240px);
					margin: 10px auto 24px;
				}

				.utility-bar { padding: 0 14px; }
				.workbench-head,
				.setup,
				.gallery-shell { padding-left: 15px; padding-right: 15px; }
				.workbench-head { align-items: center; }
				.controls { grid-template-columns: 88px minmax(0, 1fr); }
				.extract-button { grid-column: 1 / -1; }
				.progress-row { grid-template-columns: 1fr; padding: 10px 15px; }
				.progress-stack { grid-template-columns: 1fr; gap: 7px; }
				.summary { display: none; }
				.processing-row { align-items: stretch; padding: 14px 15px; }
				.processing-row,
				.background-settings,
				.processing-actions { flex-wrap: wrap; }
				.processing-actions { width: 100%; }
				.process-button,
				.save-button { flex: 1 1 145px; }
				.gallery,
				.gallery[data-columns="auto"] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
				.gallery { gap: 8px; min-height: 330px; max-height: 66vh; }
				.empty-state { min-height: 330px; padding: 24px; }
			}

			@media (prefers-reduced-motion: reduce) {
				* { transition-duration: 0.001ms !important; }
			}
		</style>
	</head>
	<body>
		<PipelineHeader active="gif" showProjects={false} />

		<main>
			<frame-grid-app class="workbench">
				<div class="workbench-head">
					<h1>GIF to frames <button class="info-tip tip-down" type="button" aria-label="Import a GIF or video into its own GIF project folder, crop GIFs, and extract frames locally."><span aria-hidden="true">i</span><span class="info-tip-text" role="tooltip">Import a GIF or video into its own GIF project folder, crop GIFs, and extract frames locally.</span></button></h1>
					<button data-clear class="clear-button" type="button" disabled>Clear</button>
				</div>

				<section class="setup import-setup" aria-label="Import GIF or video">
					<div data-drop-zone class="drop-zone">
						<div class="upload-mark" aria-hidden="true">+</div>
						<div class="drop-copy">
							<strong class="file-name">Drop a GIF or video</strong>
							<span class="file-hint">A project folder named after the file will be created automatically</span>
							<div class="source-actions">
								<button data-video-picker class="choose-label" type="button">Choose GIF</button>
								<input data-file-input class="file-input" type="file" accept="image/gif,.gif,video/*" hidden />
								<input data-folder-input class="file-input" type="file" hidden />
							</div>
						</div>
					</div>

				</section>

				<section class="gif-library" aria-label="Saved GIF projects">
					<div class="gif-library-head"><h2>GIF project preview</h2></div>
					<div class="gif-library-controls">
						<select data-gif-project-select class="gif-project-select" aria-label="GIF project"><option value="">Projects</option></select>
						<select data-gif-crop-select class="gif-project-select" aria-label="Crop under selected GIF project"><option value="">Crops</option></select>
					</div>
					<div class="gif-preview-grid">
						<article class="gif-preview-card"><span data-project-preview-title class="gif-preview-title">Project source</span><div data-project-preview class="gif-preview-media"><span class="gif-preview-empty">No project selected</span></div></article>
						<article class="gif-preview-card"><span data-crop-preview-title class="gif-preview-title">Cropped GIF</span><div data-crop-preview class="gif-preview-media"><span class="gif-preview-empty">No crop selected</span></div></article>
					</div>
				</section>

				<section class="crop-summary" aria-label="Current GIF crop controls">
					<div class="crop-summary-main">
						<strong data-file-name class="file-name" hidden>Current GIF</strong>
						<span data-file-hint class="file-hint">No GIF selected</span>
						<button data-crop-gif class="choose-label crop-launch" type="button" disabled>Crop GIF</button>
					</div>
					<div class="controls">
						<label><span class="control-label">Number of frames</span><input data-fps class="number-input" type="number" min="1" step="1" value="24" inputmode="numeric" /></label>
						<div><span class="control-label">Grid columns</span><div class="fixed-control">Auto</div></div>
						<button data-extract class="extract-button" type="button" disabled>Extract frames</button>
					</div>
				</section>

				<div class="progress-row">
					<div class="progress-stack">
						<div data-status class="status" aria-live="polite">Waiting for a GIF or video</div>
						<div class="progress-track" aria-hidden="true"><div data-progress class="progress-fill"></div></div>
					</div>
					<div data-summary class="summary">0 frames</div>
				</div>

				<div class="processing-row">
					<div class="background-settings">
						<label>
							<span class="control-label">Background</span>
							<input data-bg-color class="color-input" type="color" value="#00ff00" aria-label="Background color" />
						</label>
						<label>
							<span class="control-label">Tolerance</span>
							<input data-bg-tolerance class="tolerance-input" type="number" min="0" max="220" step="1" value="72" inputmode="numeric" />
						</label>
					</div>
					<div class="processing-actions">
						<button data-remove-bg class="process-button" type="button" disabled>Remove background</button>
						<button data-save-frames class="save-button" type="button" disabled>Save frames</button>
					</div>
				</div>

				<section class="gallery-shell" aria-label="Animation frames">
					<div data-gallery class="gallery" data-columns="auto">
						<div data-empty class="empty-state">
							<p><strong>No frames loaded</strong><span>Choose or drop a GIF or video to populate the grid.</span></p>
						</div>
					</div>
				</section>

				<section class="sequence-builder" aria-label="Selected frame sequence">
					<div class="sequence-head"><h2>Selected frame sequence</h2><div class="processing-actions"><span data-sequence-count class="status">0 selected</span><button data-clear-sequence class="clear-button" type="button" disabled>Clear selection</button></div></div>
					<div data-sequence-list class="sequence-list"><div class="sequence-empty">Click frames above to select them. Shift-click the last frame to select a range.</div></div>
				</section>

				<section class="sheet-builder" aria-label="Frame-sheet builder">
					<h2>Build a frame-sheet</h2>
					<p class="sheet-builder-copy">Uses the selected frames above in exactly the same order. Arrange them into a row × column PNG sheet.</p>
					<div class="sheet-controls">
						<select data-sheet-crop hidden><option value=""></option></select>
						<select data-sheet-save hidden><option value=""></option></select>
						<label class="sheet-field"><span>Rows</span><input data-sheet-rows type="number" min="0" step="1" value="0" title="Use 0 for automatic" /></label>
						<label class="sheet-field"><span>Columns</span><input data-sheet-cols type="number" min="0" step="1" value="0" title="Use 0 for automatic" /></label>
						<button data-build-sheet class="extract-button" type="button" disabled>Build sheet</button>
					</div>
					<div class="sheet-preview-wrap"><img data-sheet-preview class="sheet-preview" alt="Generated frame-sheet preview" hidden /></div>
					<div class="sheet-actions">
						<span data-sheet-status class="status">Select a crop with saved frames</span>
						<div class="processing-actions">
							<button data-copy-sheet class="save-button" type="button" disabled>Copy frame-sheet</button>
							<button data-save-sheet class="save-button" type="button" disabled>Save frame-sheet</button>
						</div>
					</div>
				</section>

				<section class="saved-sheets" aria-label="Previously saved frame-sheets">
					<h2>Saved frame-sheets</h2>
					<p data-saved-sheets-copy class="saved-sheets-copy">Newest sheets from the current project or crop appear first.</p>
					<div data-saved-sheets class="saved-sheets-grid"><div class="sequence-empty">No saved frame-sheets found.</div></div>
				</section>

				<video data-video class="hidden-media" muted playsinline preload="metadata"></video>
				<canvas data-canvas class="hidden-media"></canvas>
				<div data-crop-overlay class="crop-overlay" hidden>
					<div class="crop-head"><h2>Select a region across the whole GIF</h2><button data-crop-close class="button" type="button">Close</button></div>
					<div data-crop-stage class="crop-stage"><img data-crop-image class="crop-image" alt="Animated GIF crop preview" /><div data-crop-selection class="crop-selection"></div></div>
					<div class="crop-footer"><span data-crop-size class="crop-size">Drag over the GIF to select a region</span><button data-save-crop class="button primary" type="button">Save cropped GIF</button></div>
				</div>
			</frame-grid-app>
		</main>

		<script>
			import { decompressFrames, parseGIF } from 'gifuct-js';
			import { GIFEncoder, quantize, applyPalette } from 'gifenc';

			class FrameGridApp extends HTMLElement {
				file = null;
				videoUrl = '';
				cancelToken = 0;
				frames = [];
				workspaceReady = false;
				workspaceSaveTimer = 0;
				gifPreviewUrl = '';
				cropRect = null;
				cropNumber = 0;
				gifWorkspaceFile = null;
				gifWorkspaceFolder = null;

				connectedCallback() {
					this.videoPicker = this.querySelector('[data-video-picker]');
					this.fileInput = this.querySelector('[data-file-input]');
					this.folderInput = this.querySelector('[data-folder-input]');
					this.dropZone = this.querySelector('[data-drop-zone]');
					this.fileName = this.querySelector('[data-file-name]');
					this.fileHint = this.querySelector('[data-file-hint]');
					this.fpsInput = this.querySelector('[data-fps]');
					this.extractButton = this.querySelector('[data-extract]');
					this.removeBgButton = this.querySelector('[data-remove-bg]');
					this.saveFramesButton = this.querySelector('[data-save-frames]');
					this.bgColorInput = this.querySelector('[data-bg-color]');
					this.bgToleranceInput = this.querySelector('[data-bg-tolerance]');
					this.clearButton = this.querySelector('[data-clear]');
					this.status = this.querySelector('[data-status]');
					this.progress = this.querySelector('[data-progress]');
					this.summary = this.querySelector('[data-summary]');
					this.gallery = this.querySelector('[data-gallery]');
					this.video = this.querySelector('[data-video]');
					this.canvas = this.querySelector('[data-canvas]');
					this.cropButton = this.querySelector('[data-crop-gif]');
					this.cropOverlay = this.querySelector('[data-crop-overlay]');
					this.cropStage = this.querySelector('[data-crop-stage]');
					this.cropImage = this.querySelector('[data-crop-image]');
					this.cropSelection = this.querySelector('[data-crop-selection]');
					this.cropSize = this.querySelector('[data-crop-size]');
					this.gifProjectSelect = this.querySelector('[data-gif-project-select]');
					this.gifCropSelect = this.querySelector('[data-gif-crop-select]');
					this.projectPreview = this.querySelector('[data-project-preview]');
					this.projectPreviewTitle = this.querySelector('[data-project-preview-title]');
					this.cropPreview = this.querySelector('[data-crop-preview]');
					this.cropPreviewTitle = this.querySelector('[data-crop-preview-title]');
					this.sequenceList = this.querySelector('[data-sequence-list]');
					this.sequenceCount = this.querySelector('[data-sequence-count]');
					this.clearSequenceButton = this.querySelector('[data-clear-sequence]');
					this.sheetCrop = this.querySelector('[data-sheet-crop]');
					this.sheetSave = this.querySelector('[data-sheet-save]');
					this.sheetRows = this.querySelector('[data-sheet-rows]');
					this.sheetCols = this.querySelector('[data-sheet-cols]');
					this.sheetBuildButton = this.querySelector('[data-build-sheet]');
					this.sheetCopyButton = this.querySelector('[data-copy-sheet]');
					this.sheetSaveButton = this.querySelector('[data-save-sheet]');
					this.sheetPreview = this.querySelector('[data-sheet-preview]');
					this.sheetStatus = this.querySelector('[data-sheet-status]');
					this.savedSheets = this.querySelector('[data-saved-sheets]');
					this.savedSheetsCopy = this.querySelector('[data-saved-sheets-copy]');

					this.videoPicker?.addEventListener('click', () => this.chooseVideo());

					this.fileInput?.addEventListener('change', (event) => {
						const input = event.currentTarget;
						if (input instanceof HTMLInputElement && input.files?.[0]) void this.loadFile(input.files[0], { persistFile: true });
					});

					for (const eventName of ['dragenter', 'dragover']) {
						this.dropZone?.addEventListener(eventName, (event) => {
							event.preventDefault();
							this.dropZone?.setAttribute('data-dragging', 'true');
						});
					}

					for (const eventName of ['dragleave', 'drop']) {
						this.dropZone?.addEventListener(eventName, (event) => {
							event.preventDefault();
							this.dropZone?.removeAttribute('data-dragging');
						});
					}

					this.dropZone?.addEventListener('drop', (event) => {
						const file = event.dataTransfer?.files?.[0];
						if (file) void this.loadFile(file, { persistFile: true });
					});

					this.fpsInput?.addEventListener('input', () => this.updateCurrentSourceStats());
					this.fpsInput?.addEventListener('change', () => this.scheduleWorkspaceSave());
					this.bgColorInput?.addEventListener('change', () => this.scheduleWorkspaceSave());
					this.bgToleranceInput?.addEventListener('change', () => this.scheduleWorkspaceSave());

					this.extractButton?.addEventListener('click', () => this.extractFrames());
					this.removeBgButton?.addEventListener('click', () => this.removeBackgroundFromFrames());
					this.saveFramesButton?.addEventListener('click', () => this.saveProcessedFrames());
					this.clearSequenceButton?.addEventListener('click', () => this.clearSelectedSequence());
					this.clearButton?.addEventListener('click', () => void this.clear());
					this.cropButton?.addEventListener('click', () => this.openCropper());
					this.querySelector('[data-crop-close]')?.addEventListener('click', () => this.closeCropper());
					this.querySelector('[data-save-crop]')?.addEventListener('click', () => void this.saveCroppedGif());
					this.gifProjectSelect?.addEventListener('change', () => {
						if (this.gifProjectSelect.value) localStorage.setItem('spriteanim-active-gif-project', this.gifProjectSelect.value);
						void this.refreshSelectedGifProject();
					});
					this.gifCropSelect?.addEventListener('change', () => void this.refreshSelectedCropPreview());
					this.sheetCrop?.addEventListener('change', () => void this.refreshFramesheetSaves());
					this.sheetSave?.addEventListener('change', () => this.resetFramesheetPreview());
					this.sheetBuildButton?.addEventListener('click', () => void this.buildFramesheet());
					this.sheetCopyButton?.addEventListener('click', () => void this.copyFramesheet());
					this.sheetSaveButton?.addEventListener('click', () => void this.saveFramesheet());
					this.cropStage?.addEventListener('pointerdown', (event) => this.startCropSelection(event));
					this.cropStage?.addEventListener('pointermove', (event) => this.updateCropSelection(event));
					this.cropStage?.addEventListener('pointerup', (event) => this.finishCropSelection(event));
					window.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !this.cropOverlay?.hidden) this.closeCropper(); });
					window.addEventListener('pagehide', () => void this.persistWorkspaceState());
					void this.restoreWorkspace();
					void this.refreshGifLibrary(false);
				}

				async chooseVideo() {
					if (!('showOpenFilePicker' in window)) {
						this.fileInput?.click();
						return;
					}
					try {
						const [handle] = await window.showOpenFilePicker({
							multiple: false,
								types: [
									{ description: 'Animated GIF', accept: { 'image/gif': ['.gif'] } },
									{ description: 'Video', accept: { 'video/*': ['.mp4', '.webm', '.mov', '.m4v', '.avi'] } },
								],
						});
						this.videoHandle = handle;
						this.framesDirectoryHandle = null;
						await this.storeValue('frame-grid-video-handle', handle);
						await this.deleteValue('frame-grid-folder-handle');
						await this.loadFile(await handle.getFile(), { importSource: true });
					} catch (error) {
						if (!(error instanceof DOMException && error.name === 'AbortError')) this.setStatus('Could not open the GIF or video.');
					}
				}

				async chooseFramesDirectory() {
					if (!('showDirectoryPicker' in window)) {
						this.folderInput?.click();
						return;
					}
					try {
						const handle = await window.showDirectoryPicker({ mode: 'readwrite' });
						this.framesDirectoryHandle = handle;
						this.videoHandle = null;
						await this.storeValue('frame-grid-folder-handle', handle);
						await this.deleteValue('frame-grid-video-handle');
						const files = [];
						await this.collectDirectoryImages(handle, '', files);
						await this.loadFramesFolder(files, { folderName: handle.name });
					} catch (error) {
						if (!(error instanceof DOMException && error.name === 'AbortError')) this.setStatus('Could not open the frames folder.');
					}
				}

				async collectDirectoryImages(directory, prefix, files) {
					for await (const entry of directory.values()) {
						const path = prefix ? `${prefix}/${entry.name}` : entry.name;
						if (entry.kind === 'directory') {
							await this.collectDirectoryImages(entry, path, files);
						} else if (entry.kind === 'file' && /\.(png|webp|jpe?g|gif)$/i.test(entry.name)) {
							const file = await entry.getFile();
							Object.defineProperty(file, 'workspaceRelativePath', { value: path });
							files.push(file);
						}
					}
				}

				async ensurePermission(handle, mode, request = false) {
					const options = { mode };
					if (await handle.queryPermission(options) === 'granted') return true;
					return request && await handle.requestPermission(options) === 'granted';
				}

				openDatabase() {
					return new Promise((resolve, reject) => {
						const request = indexedDB.open('spriteanim-v2-handles', 1);
						request.onupgradeneeded = () => {
							if (!request.result.objectStoreNames.contains('handles')) request.result.createObjectStore('handles');
						};
						request.onsuccess = () => resolve(request.result);
						request.onerror = () => reject(request.error);
					});
				}

				storageKey(key) {
					return window.SpriteAnimProject?.getStorageKey?.(key) || key;
				}

				async storeValue(key, value) {
					const storedKey = this.storageKey(key);
					const database = await this.openDatabase();
					await new Promise((resolve, reject) => {
						const transaction = database.transaction('handles', 'readwrite');
						transaction.objectStore('handles').put(value, storedKey);
						transaction.oncomplete = () => resolve();
						transaction.onerror = () => reject(transaction.error);
					});
					database.close();
				}

				async getStoredValue(key) {
					const storedKey = this.storageKey(key);
					const database = await this.openDatabase();
					const value = await new Promise((resolve, reject) => {
						const request = database.transaction('handles').objectStore('handles').get(storedKey);
						request.onsuccess = () => resolve(request.result || null);
						request.onerror = () => reject(request.error);
					});
					database.close();
					return value;
				}

				async deleteValue(key) {
					const storedKey = this.storageKey(key);
					const database = await this.openDatabase();
					await new Promise((resolve, reject) => {
						const transaction = database.transaction('handles', 'readwrite');
						transaction.objectStore('handles').delete(storedKey);
						transaction.oncomplete = () => resolve();
						transaction.onerror = () => reject(transaction.error);
					});
					database.close();
				}

				async restoreWorkspace() {
					try {
						const state = await this.getStoredValue('frame-grid-workspace');
						if (state) {
							this.fpsInput.value = String(state.frameCount || state.fps || 24);
							this.bgColorInput.value = state.bgColor || '#00ff00';
							this.bgToleranceInput.value = String(state.bgTolerance ?? 72);
						}
						this.gallery.dataset.columns = 'auto';
						this.gallery.style.removeProperty('--columns');

						const videoHandle = await this.getStoredValue('frame-grid-video-handle');
						if (videoHandle) {
							this.videoHandle = videoHandle;
							if (await this.ensurePermission(videoHandle, 'read')) {
								await this.loadFile(await videoHandle.getFile(), { skipSnapshot: true });
								return;
							}
							this.fileName.textContent = videoHandle.name;
							this.fileHint.textContent = 'Source remembered. Choose GIF once if browser permission expired.';
							this.clearButton.disabled = false;
							return;
						}

						const videoFile = await this.getStoredValue('frame-grid-video-file');
						if (videoFile) await this.loadFile(videoFile, { skipSnapshot: true });
					} catch {
						this.setStatus('Saved workspace could not be restored.');
					}
				}

				scheduleWorkspaceSave() {
					if (!this.workspaceReady) return;
					window.clearTimeout(this.workspaceSaveTimer);
					this.workspaceSaveTimer = window.setTimeout(() => void this.persistWorkspaceState(), 120);
				}

				async persistWorkspaceState() {
					if (!this.workspaceReady) return;
					try {
						await this.storeValue('frame-grid-workspace', {
							frameCount: Number(this.fpsInput.value) || 24,
							columns: 'auto',
							bgColor: this.bgColorInput.value,
							bgTolerance: Number(this.bgToleranceInput.value) || 0,
						});
					} catch {}
				}

				async persistFramesSnapshot() {
					if (!this.workspaceReady || this.frames.length === 0) return;
					try {
						await this.storeValue('frame-grid-frames', {
							sourceName: this.fileName.textContent || '',
							frames: this.frames.map((frame) => ({
								number: frame.number,
								time: frame.time,
								sourceName: frame.sourceName,
								outputName: frame.outputName,
								sourceBlob: frame.sourceBlob,
								processedBlob: frame.processedBlob,
							})),
						});
					} catch {}
				}

				async restoreFramesSnapshot(sourceName) {
					const snapshot = await this.getStoredValue('frame-grid-frames');
					if (!snapshot || snapshot.sourceName !== sourceName || !snapshot.frames?.length) return;
					this.resetGallery(false);
					for (const item of snapshot.frames) {
						const frame = this.createFrame(item.sourceBlob, item.number, item.time, item.sourceName);
						frame.outputName = item.outputName || frame.outputName;
						if (item.processedBlob) {
							frame.processedBlob = item.processedBlob;
							frame.processedUrl = URL.createObjectURL(item.processedBlob);
							frame.image.src = frame.processedUrl;
							frame.figure.dataset.processed = 'true';
						}
						this.frames.push(frame);
						this.gallery.append(frame.figure);
					}
					this.summary.textContent = `${this.frames.length} frame${this.frames.length === 1 ? '' : 's'}`;
					this.removeBgButton.disabled = false;
					this.saveFramesButton.disabled = this.frames.length === 0;
					this.setStatus('Saved workspace restored');
				}

				async loadFile(file, options = {}) {
					if (file.type === 'image/gif' || /\.gif$/i.test(file.name)) {
						await this.loadGif(file, options);
						return;
					}
					if (!file.type.startsWith('video/')) {
						this.setStatus('Choose a valid GIF or video file.');
						return;
					}

					this.cancelToken += 1;
					this.workspaceReady = false;
					this.file = file;
					if (options.persistFile || options.importSource) {
						this.gifWorkspaceFile = file;
						this.gifWorkspaceFolder = null;
						this.currentCropFolder = null;
					}
					this.folderInput.value = '';
					if (this.videoUrl) URL.revokeObjectURL(this.videoUrl);
					this.videoUrl = URL.createObjectURL(file);
					this.video.src = this.videoUrl;
					this.fileName.textContent = file.name;
					this.fileHint.textContent = `${this.formatBytes(file.size)} - reading metadata`;
					this.extractButton.disabled = true;
					this.removeBgButton.disabled = true;
					this.saveFramesButton.disabled = true;
					this.cropButton.disabled = true;
					this.clearButton.disabled = false;
					this.resetGallery();

					try {
						await this.once(this.video, 'loadedmetadata');
						if (this.video.readyState < 2) await this.once(this.video, 'loadeddata');
						this.currentSourceStats = { size: file.size, width: this.video.videoWidth, height: this.video.videoHeight, duration: this.video.duration, sourceFrames: null };
						this.updateCurrentSourceStats();
						this.extractButton.disabled = false;
						this.setStatus('Ready to extract');
						this.workspaceReady = true;
						if (this.gifWorkspaceFile === file) await this.prepareGifWorkspace();
						if (options.persistFile) {
							try {
								await this.storeValue('frame-grid-video-file', file);
								await this.deleteValue('frame-grid-folder-files');
								await this.deleteValue('frame-grid-video-handle');
								await this.deleteValue('frame-grid-folder-handle');
							} catch {}
						}
						if (!options.skipSnapshot) await this.deleteValue('frame-grid-frames');
						await this.restoreFramesSnapshot(file.name);
						this.scheduleWorkspaceSave();
					} catch {
						this.setStatus('This browser could not read the selected video.');
					}
				}

				async loadGif(file, options = {}) {
					if (!options.preserveGifWorkspace && (options.persistFile || options.importSource)) {
						this.gifWorkspaceFile = file;
						this.gifWorkspaceFolder = null;
						this.currentCropFolder = null;
					}
					const token = ++this.cancelToken;
					this.workspaceReady = false;
					this.file = file;
					this.fileInput.value = '';
					this.folderInput.value = '';
					this.video.removeAttribute('src');
					this.video.load();
					if (this.videoUrl) URL.revokeObjectURL(this.videoUrl);
					this.videoUrl = '';
					this.resetGallery(false);
					this.fileName.textContent = file.name;
					this.fileHint.textContent = `${this.formatBytes(file.size)} - decoding GIF`;
					this.extractButton.disabled = true;
					this.removeBgButton.disabled = true;
					this.saveFramesButton.disabled = true;
					this.clearButton.disabled = false;
					this.progress.style.width = '0%';
					this.cropButton.disabled = true;
					if (this.gifPreviewUrl) URL.revokeObjectURL(this.gifPreviewUrl);
					this.gifPreviewUrl = URL.createObjectURL(file);
					this.cropImage.src = this.gifPreviewUrl;

					try {
						const gif = parseGIF(await file.arrayBuffer());
						const decodedFrames = decompressFrames(gif, true);
						if (decodedFrames.length === 0) throw new Error('GIF contains no image frames.');
						const sourceFrameCount = decodedFrames.length;
						const requested = options.requestedFrameCount == null
							? sourceFrameCount
							: Math.max(1, Math.floor(Number(options.requestedFrameCount) || sourceFrameCount));
						const targetFrameCount = Math.min(sourceFrameCount, requested);
						this.fpsInput.value = String(targetFrameCount);
						const selectedIndices = targetFrameCount === 1
							? [0]
							: Array.from({ length: targetFrameCount }, (_, index) => Math.round(index * (sourceFrameCount - 1) / (targetFrameCount - 1)));
						const selectedIndexMap = new Map(selectedIndices.map((sourceIndex, outputIndex) => [sourceIndex, outputIndex]));
						const frameStarts = [];
						let totalDurationMs = 0;
						for (const decoded of decodedFrames) {
							frameStarts.push(totalDurationMs);
							totalDurationMs += Math.max(10, decoded.delay || 100);
						}
						const width = gif.lsd.width;
						const height = gif.lsd.height;
						this.canvas.width = width;
						this.canvas.height = height;
						const context = this.canvas.getContext('2d', { alpha: true });
						if (!context) throw new Error('Canvas is unavailable.');
						context.clearRect(0, 0, width, height);
						const patchCanvas = document.createElement('canvas');
						const patchContext = patchCanvas.getContext('2d', { alpha: true });
						if (!patchContext) throw new Error('Canvas is unavailable.');
						for (let index = 0; index < decodedFrames.length; index += 1) {
							if (token !== this.cancelToken) return;
							const decoded = decodedFrames[index];
							const { left, top, width: patchWidth, height: patchHeight } = decoded.dims;
							const restoreImage = decoded.disposalType === 3
								? context.getImageData(0, 0, width, height)
								: null;
							const patch = new ImageData(new Uint8ClampedArray(decoded.patch), patchWidth, patchHeight);
							patchCanvas.width = patchWidth;
							patchCanvas.height = patchHeight;
							patchContext.putImageData(patch, 0, 0);
							context.drawImage(patchCanvas, left, top);
							const outputIndex = selectedIndexMap.get(index);
							if (outputIndex != null) {
								const sourceBlob = await this.canvasToBlob(this.canvas, 'image/png');
								const outputName = `${this.safeBaseName(file.name)}-frame-${String(outputIndex + 1).padStart(3, '0')}.png`;
								const frame = this.createFrame(sourceBlob, outputIndex + 1, frameStarts[index] / 1000, outputName);
								const nextSourceIndex = selectedIndices[outputIndex + 1];
								frame.delay = nextSourceIndex == null ? totalDurationMs - frameStarts[index] : frameStarts[nextSourceIndex] - frameStarts[index];
								frame.outputName = outputName;
								this.frames.push(frame);
								this.gallery.append(frame.figure);
								this.setStatus(`Extracting selected frame ${outputIndex + 1} of ${targetFrameCount}`);
							}

							if (decoded.disposalType === 2) context.clearRect(left, top, patchWidth, patchHeight);
							else if (decoded.disposalType === 3 && restoreImage) context.putImageData(restoreImage, 0, 0);
							this.progress.style.width = `${((index + 1) / decodedFrames.length) * 100}%`;
						}

						this.currentSourceStats = { size: file.size, width, height, duration: totalDurationMs / 1000, sourceFrames: sourceFrameCount };
						this.updateCurrentSourceStats();
						this.summary.textContent = `${targetFrameCount} frame${targetFrameCount === 1 ? '' : 's'}`;
						this.removeBgButton.disabled = false;
						this.saveFramesButton.disabled = false;
						this.cropButton.disabled = false;
						this.extractButton.disabled = false;
						this.setStatus(targetFrameCount === sourceFrameCount
							? `Extracted all ${sourceFrameCount} GIF frames`
							: `Extracted ${targetFrameCount} evenly sampled frames from ${sourceFrameCount} source frames`);
						this.workspaceReady = true;
						if (this.gifWorkspaceFile === file) await this.prepareGifWorkspace();
						if (options.persistFile) {
							try {
								await this.storeValue('frame-grid-video-file', file);
								await this.deleteValue('frame-grid-folder-files');
								await this.deleteValue('frame-grid-video-handle');
								await this.deleteValue('frame-grid-folder-handle');
							} catch {}
						}
						if (!options.skipSnapshot) await this.persistFramesSnapshot();
						this.scheduleWorkspaceSave();
					} catch (error) {
						this.setStatus(error instanceof Error ? error.message : 'Could not decode this GIF.');
					}
				}

				openCropper() {
					if (!this.gifPreviewUrl || this.frames.length === 0) return;
					this.cropOverlay.hidden = false;
					document.body.style.overflow = 'hidden';
					requestAnimationFrame(() => {
						const bounds = this.getCropImageBounds();
						this.cropRect = { x: 0, y: 0, width: bounds.naturalWidth, height: bounds.naturalHeight };
						this.renderCropSelection();
					});
				}

				closeCropper() {
					this.cropOverlay.hidden = true;
					document.body.style.overflow = '';
					this.cropDrag = null;
				}

				getCropImageBounds() {
					const stage = this.cropStage.getBoundingClientRect();
					const naturalWidth = this.cropImage.naturalWidth || this.canvas.width || 1;
					const naturalHeight = this.cropImage.naturalHeight || this.canvas.height || 1;
					const scale = Math.min(stage.width / naturalWidth, stage.height / naturalHeight);
					const width = naturalWidth * scale;
					const height = naturalHeight * scale;
					return { left: stage.left + (stage.width - width) / 2, top: stage.top + (stage.height - height) / 2, width, height, naturalWidth, naturalHeight, scale };
				}

				cropPoint(event) {
					const bounds = this.getCropImageBounds();
					return {
						x: Math.max(0, Math.min(bounds.naturalWidth, (event.clientX - bounds.left) / bounds.scale)),
						y: Math.max(0, Math.min(bounds.naturalHeight, (event.clientY - bounds.top) / bounds.scale)),
					};
				}

				startCropSelection(event) {
					const point = this.cropPoint(event);
					this.cropDrag = { start: point, pointerId: event.pointerId };
					this.cropStage.setPointerCapture(event.pointerId);
					this.cropRect = { x: point.x, y: point.y, width: 1, height: 1 };
					this.renderCropSelection();
				}

				updateCropSelection(event) {
					if (!this.cropDrag || this.cropDrag.pointerId !== event.pointerId) return;
					const point = this.cropPoint(event);
					const start = this.cropDrag.start;
					this.cropRect = { x: Math.min(start.x, point.x), y: Math.min(start.y, point.y), width: Math.max(1, Math.abs(point.x - start.x)), height: Math.max(1, Math.abs(point.y - start.y)) };
					this.renderCropSelection();
				}

				finishCropSelection(event) {
					this.updateCropSelection(event);
					this.cropDrag = null;
				}

				renderCropSelection() {
					if (!this.cropRect) return;
					const bounds = this.getCropImageBounds();
					const rect = this.cropRect;
					Object.assign(this.cropSelection.style, {
						left: `${bounds.left + rect.x * bounds.scale}px`, top: `${bounds.top + rect.y * bounds.scale}px`,
						width: `${rect.width * bounds.scale}px`, height: `${rect.height * bounds.scale}px`,
					});
					this.cropSize.textContent = `${Math.round(rect.width)} x ${Math.round(rect.height)} px`;
				}

				async getGifProjectsRoot() {
					let root = await this.getGlobalValue('spriteanim-root-handle');
					if (!root || !await this.ensurePermission(root, 'readwrite', true)) {
						root = await window.showDirectoryPicker({ mode: 'readwrite' });
						await this.storeGlobalValue('spriteanim-root-handle', root);
					}
					return root.getDirectoryHandle('gif-projects', { create: true });
				}

				async getGlobalValue(key) {
					const database = await this.openDatabase();
					const value = await new Promise((resolve, reject) => {
						const request = database.transaction('handles').objectStore('handles').get(key);
						request.onsuccess = () => resolve(request.result || null);
						request.onerror = () => reject(request.error);
					});
					database.close();
					return value;
				}

				async storeGlobalValue(key, value) {
					const database = await this.openDatabase();
					await new Promise((resolve, reject) => {
						const transaction = database.transaction('handles', 'readwrite');
						transaction.objectStore('handles').put(value, key);
						transaction.oncomplete = () => resolve();
						transaction.onerror = () => reject(transaction.error);
					});
					database.close();
				}

				async directoryEntries(directory, kind = 'directory') {
					const entries = [];
					for await (const entry of directory.values()) if (entry.kind === kind) entries.push(entry);
					return entries.sort((a, b) => b.name.localeCompare(a.name, undefined, { numeric: true, sensitivity: 'base' }));
				}

				async discoverGifWorkspaces(directory, prefix = '', depth = 0) {
					const workspaces = [];
					for (const entry of await this.directoryEntries(directory)) {
						if (/^crop\d+-/.test(entry.name)) continue;
						const children = await this.directoryEntries(entry);
						const crops = children.filter((child) => /^crop\d+-/.test(child.name));
						const path = prefix ? `${prefix} / ${entry.name}` : entry.name;
						if (crops.length) {
							workspaces.push({ name: path, handle: entry, crops });
						} else if (depth < 2) {
							const nested = await this.discoverGifWorkspaces(entry, path, depth + 1);
							if (nested.length) workspaces.push(...nested);
							else if (children.length === 0) workspaces.push({ name: path, handle: entry, crops: [] });
						}
					}
					return workspaces;
				}

				async refreshGifLibrary(requestPermission = false) {
					try {
						const root = await this.getGlobalValue('spriteanim-root-handle');
						if (!root || !await this.ensurePermission(root, 'read', requestPermission)) {
							this.gifProjectSelect.replaceChildren(new Option('Connect D:\\SpriteAnimProjects', ''));
							this.gifCropSelect.replaceChildren(new Option('Crops', ''));
							return;
						}
						const gifProjects = await root.getDirectoryHandle('gif-projects', { create: false });
						const projects = [];
						for (const handle of await this.directoryEntries(gifProjects)) {
							const source = await this.latestMediaFile(handle, /\.(gif|mp4|webm|mov|m4v|avi)$/i);
							const crops = (await this.directoryEntries(handle)).filter((entry) => /^crop\d+-/.test(entry.name));
							projects.push({ name: handle.name, handle, source, crops, modified: source?.lastModified || 0 });
						}
						projects.sort((a, b) => b.modified - a.modified || b.name.localeCompare(a.name, undefined, { numeric: true, sensitivity: 'base' }));
						if (projects.length === 0) {
							this.gifProjectSelect.replaceChildren(new Option('No GIF projects', ''));
							this.gifCropSelect.replaceChildren(new Option('No crops', ''));
							this.refreshFramesheetCrops([]);
							return;
						}
						this.gifProjects = projects;
						this.gifProjectSelect.replaceChildren(...projects.map((project, index) => new Option(project.name, String(index))));
						this.gifProjectSelect.value = '0';
						await this.refreshSelectedGifProject();
						this.refreshFramesheetCrops(projects);
					} catch (error) {
						this.projectPreview.replaceChildren(Object.assign(document.createElement('span'), { className: 'gif-preview-empty', textContent: `Could not read GIF projects: ${error?.message || error}` }));
					}
				}

				async latestMediaFile(directory, pattern) {
					const files = [];
					for await (const entry of directory.values()) {
						if (entry.kind === 'file' && pattern.test(entry.name)) files.push(await entry.getFile());
					}
					return files.sort((a, b) => b.lastModified - a.lastModified)[0] || null;
				}

				async refreshSelectedGifProject() {
					const project = this.gifProjects?.[Number(this.gifProjectSelect.value)];
					if (!project) return;
					this.currentPreviewProject = project;
					localStorage.setItem('spriteanim-active-gif-project', project.name);
					this.renderLibraryMedia(this.projectPreview, this.projectPreviewTitle, project.source, project.name);
					this.gifCropSelect.replaceChildren();
					this.gifCropHandles = new Map();
					for (let index = 0; index < project.crops.length; index += 1) {
						this.gifCropHandles.set(String(index), project.crops[index]);
						this.gifCropSelect.add(new Option(project.crops[index].name, String(index)));
					}
					if (!project.crops.length) {
						this.gifCropSelect.add(new Option('No crops saved', ''));
						this.gifCropSelect.disabled = true;
					} else {
						this.gifCropSelect.disabled = false;
						this.gifCropSelect.value = '0';
					}
					await this.refreshSelectedCropPreview();
				}

				async refreshSelectedCropPreview() {
					const project = this.gifProjects?.[Number(this.gifProjectSelect.value)];
					const crop = this.gifCropHandles?.get(this.gifCropSelect.value);
					this.currentPreviewCrop = crop || null;
					const file = crop ? await this.latestMediaFile(crop, /\.gif$/i) : null;
					this.renderLibraryMedia(this.cropPreview, this.cropPreviewTitle, file, crop?.name || 'Cropped GIF');
					const extractionFile = file || project?.source || null;
					if (project && extractionFile) await this.loadPreviewSelectionIntoExtractor(project, file ? crop : null, extractionFile);
					await this.refreshSavedSheets();
				}

				async collectSavedSheets(directory, prefix, results, depth = 0) {
					if (!directory || depth > 4) return;
					for await (const entry of directory.values()) {
						const path = prefix ? `${prefix} / ${entry.name}` : entry.name;
						if (entry.kind === 'directory') await this.collectSavedSheets(entry, path, results, depth + 1);
						else if (/^frame-sheet-.*\.png$/i.test(entry.name)) results.push({ file: await entry.getFile(), path });
					}
				}

				async refreshSavedSheets() {
					if (!this.savedSheets) return;
					const directory = this.currentPreviewCrop || this.currentPreviewProject?.handle;
					if (!directory) {
						this.savedSheets.innerHTML = '<div class="sequence-empty">No project selected.</div>';
						return;
					}
					try {
						const results = [];
						await this.collectSavedSheets(directory, '', results);
						results.sort((a, b) => b.file.lastModified - a.file.lastModified || b.file.name.localeCompare(a.file.name));
						for (const url of this.savedSheetUrls || []) URL.revokeObjectURL(url);
						this.savedSheetUrls = [];
						this.savedSheetsCopy.textContent = this.currentPreviewCrop
							? `Newest first · ${this.currentPreviewProject?.name || ''} / ${this.currentPreviewCrop.name}`
							: `Newest first · ${this.currentPreviewProject?.name || ''}`;
						if (!results.length) {
							this.savedSheets.innerHTML = '<div class="sequence-empty">No saved frame-sheets found.</div>';
							return;
						}
						const cards = results.map(({ file, path }) => {
							const url = URL.createObjectURL(file);
							this.savedSheetUrls.push(url);
							const card = document.createElement('figure');
							card.className = 'saved-sheet-card';
							const image = document.createElement('img');
							image.src = url;
							image.alt = file.name;
							const caption = document.createElement('figcaption');
							const name = document.createElement('span');
							name.className = 'saved-sheet-name';
							name.textContent = file.name;
							name.title = path;
							const meta = document.createElement('span');
							meta.className = 'saved-sheet-meta';
							meta.textContent = `${new Date(file.lastModified).toLocaleString()} · ${this.formatBytes(file.size)}`;
							caption.append(name, meta);
							const actions = document.createElement('div');
							actions.className = 'saved-sheet-actions';
							const copy = Object.assign(document.createElement('button'), { type: 'button', textContent: 'Copy file' });
							const open = Object.assign(document.createElement('button'), { type: 'button', textContent: 'Open folder' });
							copy.addEventListener('click', () => void this.copySavedSheet(file, copy));
							open.addEventListener('click', () => void this.openSavedSheetFolder(path, open));
							actions.append(copy, open);
							card.append(image, caption, actions);
							return card;
						});
						this.savedSheets.replaceChildren(...cards);
					} catch (error) {
						this.savedSheets.innerHTML = `<div class="sequence-empty">Could not read saved frame-sheets: ${error?.message || error}</div>`;
					}
				}

				async copySavedSheet(file, button) {
					button.disabled = true;
					try {
						if (!navigator.clipboard?.write || typeof ClipboardItem === 'undefined') throw new Error('Image clipboard is unavailable in this browser.');
						await navigator.clipboard.write([new ClipboardItem({ 'image/png': file })]);
						this.savedSheetsCopy.textContent = `${file.name} copied. Paste it directly into ChatGPT.`;
					} catch (error) {
						this.savedSheetsCopy.textContent = error?.message || 'Could not copy the saved frame-sheet.';
					} finally {
						button.disabled = false;
					}
				}

				async openSavedSheetFolder(relativePath, button) {
					button.disabled = true;
					try {
						const segments = [
							this.currentPreviewProject?.name,
							...(this.currentPreviewCrop ? [this.currentPreviewCrop.name] : []),
							...relativePath.split(' / '),
						].filter(Boolean);
						const response = await fetch('/api/reveal-frame-sheet', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ segments }),
						});
						if (!response.ok) throw new Error((await response.text()) || 'Could not open File Explorer.');
						this.savedSheetsCopy.textContent = 'Opened File Explorer with the frame-sheet selected.';
					} catch (error) {
						this.savedSheetsCopy.textContent = error?.message || 'Could not open the source folder.';
					} finally {
						button.disabled = false;
					}
				}

				async loadPreviewSelectionIntoExtractor(project, crop, file) {
					const selectionKey = `${project.name}/${crop?.name || 'source'}/${file.name}/${file.lastModified}`;
					if (this.extractionSelectionKey === selectionKey) return;
					const alreadyLoaded = this.file?.name === file.name
						&& (crop ? this.currentCropFolder?.name === crop.name : !this.currentCropFolder);
					this.extractionSelectionKey = selectionKey;
					this.gifWorkspaceFolder = project.handle;
					this.gifWorkspaceFile = project.source || file;
					this.currentCropFolder = crop || null;
					if (alreadyLoaded) return;
					if (file.type === 'image/gif' || /\.gif$/i.test(file.name)) {
						await this.loadGif(file, { skipSnapshot: true, preserveGifWorkspace: true });
					} else {
						await this.loadFile(file, { skipSnapshot: true });
					}
					this.currentCropFolder = crop || null;
				}

				renderLibraryMedia(container, title, file, fallbackTitle) {
					const urlKey = container === this.projectPreview ? 'projectLibraryUrl' : 'cropLibraryUrl';
					if (this[urlKey]) URL.revokeObjectURL(this[urlKey]);
					this[urlKey] = '';
					title.textContent = file?.name || fallbackTitle;
					if (!file) {
						container.replaceChildren(Object.assign(document.createElement('span'), { className: 'gif-preview-empty', textContent: 'No preview available' }));
						return;
					}
					this[urlKey] = URL.createObjectURL(file);
					const media = file.type.startsWith('video/') || /\.(mp4|webm|mov|m4v|avi)$/i.test(file.name)
						? document.createElement('video') : document.createElement('img');
					media.src = this[urlKey];
					if (media instanceof HTMLVideoElement) { media.controls = true; media.loop = true; media.muted = true; media.autoplay = true; }
					else media.alt = file.name;
					container.replaceChildren(media);
				}

				refreshFramesheetCrops(projects) {
					const previous = this.sheetCrop.value;
					this.sheetCrop.replaceChildren();
					this.sheetCropHandles = new Map();
					for (let projectIndex = 0; projectIndex < projects.length; projectIndex += 1) {
						const project = projects[projectIndex];
						for (let cropIndex = 0; cropIndex < project.crops.length; cropIndex += 1) {
							const crop = project.crops[cropIndex];
							const key = `${projectIndex}:${cropIndex}`;
							this.sheetCropHandles.set(key, { project, crop });
							this.sheetCrop.add(new Option(`${project.name} / ${crop.name}`, key));
						}
					}
					if (this.sheetCrop.options.length === 0) {
						this.sheetCrop.add(new Option('No crops available', ''));
						this.sheetCrop.disabled = true;
						this.sheetBuildButton.disabled = true;
						void this.refreshFramesheetSaves();
						return;
					}
					this.sheetCrop.disabled = false;
					if (this.sheetCropHandles.has(previous)) this.sheetCrop.value = previous;
					else if (this.currentCropFolder) {
						const match = [...this.sheetCropHandles].find(([, value]) => value.crop.name === this.currentCropFolder.name);
						if (match) this.sheetCrop.value = match[0];
					}
					void this.refreshFramesheetSaves();
				}

				async refreshFramesheetSaves() {
					this.resetFramesheetPreview();
					this.sheetSave.replaceChildren();
					this.sheetSaveHandles = new Map();
					const selected = this.sheetCropHandles?.get(this.sheetCrop.value);
					if (!selected) {
						this.sheetSave.add(new Option('No frame saves', ''));
						this.sheetSave.disabled = true;
						this.sheetBuildButton.disabled = true;
						return;
					}
					const saves = (await this.directoryEntries(selected.crop)).filter((entry) => entry.name === 'frames' || /-frames$/.test(entry.name));
					for (const save of saves) {
						this.sheetSaveHandles.set(save.name, save);
						this.sheetSave.add(new Option(save.name, save.name));
					}
					if (!saves.length) {
						this.sheetSave.add(new Option('No frame saves', ''));
						this.sheetSave.disabled = true;
						this.sheetBuildButton.disabled = true;
						this.sheetStatus.textContent = 'This crop has no saved frame folders yet';
						return;
					}
					this.sheetSave.disabled = false;
					this.sheetSave.value = saves[0].name;
					this.sheetBuildButton.disabled = false;
					this.sheetStatus.textContent = `Latest save selected: ${saves[0].name}`;
				}

				resetFramesheetPreview() {
					this.framesheetBlob = null;
					this.framesheetDirectory = null;
					this.sheetCopyButton.disabled = true;
					this.sheetSaveButton.disabled = true;
					if (this.framesheetUrl) URL.revokeObjectURL(this.framesheetUrl);
					this.framesheetUrl = '';
					this.sheetPreview.removeAttribute('src');
					this.sheetPreview.hidden = true;
				}

				async buildFramesheet() {
					const selectedFrames = this.selectedFrames || [];
					if (!selectedFrames.length) return;
					const directory = this.sheetSaveHandles?.get(this.sheetSave.value) || this.currentCropFolder || this.gifWorkspaceFolder || null;
					this.sheetBuildButton.disabled = true;
					this.sheetStatus.textContent = 'Stitching selected frames…';
					try {
						const blobs = selectedFrames.map((frame) => frame.processedBlob || frame.sourceBlob);
						const bitmaps = [];
						let cellWidth = 1;
						let cellHeight = 1;
						for (const blob of blobs) {
							const bitmap = await createImageBitmap(blob);
							bitmaps.push(bitmap);
							cellWidth = Math.max(cellWidth, bitmap.width);
							cellHeight = Math.max(cellHeight, bitmap.height);
						}
						let rows = Math.max(0, Math.floor(Number(this.sheetRows.value) || 0));
						let columns = Math.max(0, Math.floor(Number(this.sheetCols.value) || 0));
						if (!rows && !columns) columns = Math.ceil(Math.sqrt(blobs.length));
						if (!columns) columns = Math.ceil(blobs.length / rows);
						if (!rows) rows = Math.ceil(blobs.length / columns);
						if (rows * columns < blobs.length) rows = Math.ceil(blobs.length / columns);
						this.sheetRows.value = String(rows);
						this.sheetCols.value = String(columns);
						const canvas = document.createElement('canvas');
						canvas.width = columns * cellWidth;
						canvas.height = rows * cellHeight;
						const context = canvas.getContext('2d', { alpha: true });
						for (let index = 0; index < bitmaps.length; index += 1) {
							const bitmap = bitmaps[index];
							const x = (index % columns) * cellWidth + Math.floor((cellWidth - bitmap.width) / 2);
							const y = Math.floor(index / columns) * cellHeight + Math.floor((cellHeight - bitmap.height) / 2);
							context.drawImage(bitmap, x, y);
							bitmap.close();
						}
						this.framesheetBlob = await this.canvasToBlob(canvas, 'image/png');
						this.framesheetDirectory = directory;
						this.framesheetName = `frame-sheet-${rows}x${columns}-${this.fileTimestamp()}.png`;
						this.framesheetUrl = URL.createObjectURL(this.framesheetBlob);
						this.sheetPreview.src = this.framesheetUrl;
						this.sheetPreview.hidden = false;
						this.sheetCopyButton.disabled = false;
						this.sheetSaveButton.disabled = false;
						this.sheetStatus.textContent = `${blobs.length} selected frames → ${rows} × ${columns} grid · ${canvas.width} × ${canvas.height}px`;
					} catch (error) {
						this.sheetStatus.textContent = error?.message || 'Could not build the frame-sheet.';
					} finally {
						this.sheetBuildButton.disabled = !(this.selectedFrames?.length);
					}
				}

				async copyFramesheet() {
					if (!this.framesheetBlob) return;
					this.sheetCopyButton.disabled = true;
					try {
						if (!navigator.clipboard?.write || typeof ClipboardItem === 'undefined') throw new Error('Image clipboard is unavailable in this browser.');
						await navigator.clipboard.write([new ClipboardItem({ 'image/png': this.framesheetBlob })]);
						this.sheetStatus.textContent = 'Frame-sheet copied. Paste it directly into ChatGPT.';
					} catch (error) {
						this.sheetStatus.textContent = error?.message || 'Could not copy the frame-sheet.';
					} finally {
						this.sheetCopyButton.disabled = false;
					}
				}

				async saveFramesheet() {
					if (!this.framesheetBlob) return;
					this.sheetSaveButton.disabled = true;
					try {
						if (!this.framesheetDirectory) this.framesheetDirectory = await window.showDirectoryPicker({ mode: 'readwrite' });
						await this.writeBlob(this.framesheetDirectory, this.framesheetName, this.framesheetBlob);
						this.sheetStatus.textContent = `Saved ${this.framesheetName} inside ${this.framesheetDirectory.name}`;
						await this.refreshSavedSheets();
					} catch (error) {
						this.sheetStatus.textContent = error?.message || 'Could not save the frame-sheet.';
					} finally {
						this.sheetSaveButton.disabled = false;
					}
				}

				async loadSavedFrameRun(project, crop, save) {
					const files = [];
					await this.collectDirectoryImages(save, '', files);
					for (let index = files.length - 1; index >= 0; index -= 1) if (/^frame-sheet-/i.test(files[index].name)) files.splice(index, 1);
					if (!files.length) {
						this.setStatus(`${save.name} contains no image frames`);
						return;
					}
					this.currentCropFolder = crop;
					await this.loadFramesFolder(files, { folderName: `${project.name} / ${crop.name} / ${save.name}` });
					this.cropButton.disabled = true;
					this.setStatus(`Loaded ${files.length} frames from ${save.name}`);
				}

				async writeBlob(directory, name, blob) {
					const handle = await directory.getFileHandle(name, { create: true });
					const writable = await handle.createWritable();
					await writable.write(blob);
					await writable.close();
				}

				async prepareGifWorkspace() {
					if (!this.gifWorkspaceFile || this.gifWorkspaceFolder) return this.gifWorkspaceFolder;
					try {
						const gifProjects = await this.getGifProjectsRoot();
						const sourceName = this.safeBaseName(this.gifWorkspaceFile.name);
						this.gifWorkspaceFolder = await gifProjects.getDirectoryHandle(sourceName, { create: true });
						await this.writeBlob(this.gifWorkspaceFolder, this.gifWorkspaceFile.name, this.gifWorkspaceFile);
						localStorage.setItem('spriteanim-active-gif-project', sourceName);
						void this.refreshGifLibrary(false);
						return this.gifWorkspaceFolder;
					} catch (error) {
						if (error?.name !== 'AbortError') this.setStatus(`Frames extracted, but the GIF workspace could not be created: ${error?.message || error}`);
						return null;
					}
				}

				fileTimestamp() {
					return new Date().toISOString().replace(/[:.]/g, '-');
				}

				async createCroppedGif(rect) {
					const width = Math.max(1, Math.round(rect.width));
					const height = Math.max(1, Math.round(rect.height));
					const canvas = document.createElement('canvas');
					canvas.width = width;
					canvas.height = height;
					const context = canvas.getContext('2d', { willReadFrequently: true });
					const gif = GIFEncoder();
					for (let index = 0; index < this.frames.length; index += 1) {
						const bitmap = await createImageBitmap(this.frames[index].sourceBlob);
						context.clearRect(0, 0, width, height);
						context.drawImage(bitmap, Math.round(rect.x), Math.round(rect.y), width, height, 0, 0, width, height);
						bitmap.close();
						const pixels = context.getImageData(0, 0, width, height).data;
						const palette = quantize(pixels, 256, { format: 'rgba4444', oneBitAlpha: true });
						const indexed = applyPalette(pixels, palette, 'rgba4444');
						gif.writeFrame(indexed, width, height, { palette, delay: this.frames[index].delay || 100, transparent: true, transparentIndex: palette.length });
						this.setStatus(`Encoding crop ${index + 1} of ${this.frames.length}`);
					}
					gif.finish();
					return new Blob([gif.bytes()], { type: 'image/gif' });
				}

				async saveCroppedGif() {
					if (!this.cropRect || !this.file) return;
					const saveButton = this.querySelector('[data-save-crop]');
					saveButton.disabled = true;
					try {
						const blob = await this.createCroppedGif(this.cropRect);
						const gifFolder = await this.prepareGifWorkspace();
						if (!gifFolder) return;
						const sourceName = this.safeBaseName(this.gifWorkspaceFile?.name || this.file.name);
						const existing = [];
						for await (const entry of gifFolder.values()) if (entry.kind === 'directory' && /^crop\d+-/.test(entry.name)) existing.push(entry.name);
						this.cropNumber = existing.reduce((highest, name) => Math.max(highest, Number(name.match(/^crop(\d+)/)?.[1]) || 0), 0) + 1;
						const timestamp = this.fileTimestamp();
						const cropName = `crop${this.cropNumber}-${timestamp}`;
						const cropFolder = await gifFolder.getDirectoryHandle(cropName, { create: true });
						const croppedName = `${sourceName}-${timestamp}.gif`;
						await this.writeBlob(cropFolder, croppedName, blob);
						this.currentCropFolder = cropFolder;
						this.outputDirectoryHandle = null;
						this.closeCropper();
						const croppedFile = new File([blob], croppedName, { type: 'image/gif' });
						await this.loadGif(croppedFile, { skipSnapshot: true, preserveGifWorkspace: true });
						this.setStatus(`Saved ${cropName}; each Save frames run creates a new timestamped frames folder`);
					} catch (error) {
						if (error?.name !== 'AbortError') this.setStatus(`Could not save crop: ${error?.message || error}`);
					} finally {
						saveButton.disabled = false;
					}
				}

				async loadFramesFolder(files, options = {}) {
					const imageFiles = Array.from(files)
						.filter((file) => file.type.startsWith('image/') || /\.(png|webp|jpe?g|gif)$/i.test(file.name))
						.sort((a, b) => this.naturalCompare(a.workspaceRelativePath || a.webkitRelativePath || a.name, b.workspaceRelativePath || b.webkitRelativePath || b.name));

					if (imageFiles.length === 0) {
						this.setStatus('Selected folder contains no supported image frames.');
						return;
					}

					this.cancelToken += 1;
					this.workspaceReady = false;
					this.file = null;
					this.fileInput.value = '';
					this.video.removeAttribute('src');
					this.video.load();
					if (this.videoUrl) URL.revokeObjectURL(this.videoUrl);
					this.videoUrl = '';
					this.resetGallery(false);

					const firstPath = imageFiles[0].workspaceRelativePath || imageFiles[0].webkitRelativePath || '';
					const folderName = options.folderName || (firstPath.includes('/') ? firstPath.split('/')[0] : 'Selected frames');
					const totalBytes = imageFiles.reduce((total, file) => total + file.size, 0);
					this.fileName.textContent = folderName;
					this.fileHint.textContent = `${imageFiles.length} image frame${imageFiles.length === 1 ? '' : 's'} - ${this.formatBytes(totalBytes)}`;

					for (let index = 0; index < imageFiles.length; index += 1) {
						const source = imageFiles[index];
						const frame = this.createFrame(source, index + 1, null, source.name);
						this.frames.push(frame);
						this.gallery.append(frame.figure);
					}

					this.extractButton.disabled = true;
					this.removeBgButton.disabled = false;
					this.saveFramesButton.disabled = false;
					this.clearButton.disabled = false;
					this.summary.textContent = `${imageFiles.length} frame${imageFiles.length === 1 ? '' : 's'}`;
					this.setStatus('Frames folder ready for background removal');
					this.workspaceReady = true;
					if (options.persistFiles) {
						try {
							await this.storeValue('frame-grid-folder-files', imageFiles);
							await this.deleteValue('frame-grid-video-file');
							await this.deleteValue('frame-grid-video-handle');
							await this.deleteValue('frame-grid-folder-handle');
						} catch {}
					}
					if (!options.skipSnapshot) await this.persistFramesSnapshot();
					else await this.restoreFramesSnapshot(folderName);
					this.scheduleWorkspaceSave();
				}

				async extractFrames() {
					if (this.file && (this.file.type === 'image/gif' || /\.gif$/i.test(this.file.name))) {
						const requestedFrameCount = Math.max(1, Math.floor(Number(this.fpsInput.value) || this.frames.length || 1));
						await this.loadGif(this.file, { skipSnapshot: true, preserveGifWorkspace: true, requestedFrameCount });
						return;
					}
					if (!this.file || !Number.isFinite(this.video.duration) || this.video.duration <= 0) return;
					const requestedCount = Math.max(1, Math.floor(Number(this.fpsInput.value) || 24));
					const frameCount = Math.min(240, requestedCount);
					this.fpsInput.value = String(frameCount);
					const token = ++this.cancelToken;

					this.resetGallery(false);
					this.extractButton.disabled = true;
					this.removeBgButton.disabled = true;
					this.saveFramesButton.disabled = true;
					this.clearButton.disabled = false;
					this.progress.style.width = '0%';
					this.setStatus(`Extracting 0 of ${frameCount}`);

					const sourceWidth = this.video.videoWidth;
					const sourceHeight = this.video.videoHeight;
					const scale = Math.min(1, 720 / sourceWidth);
					this.canvas.width = Math.max(1, Math.round(sourceWidth * scale));
					this.canvas.height = Math.max(1, Math.round(sourceHeight * scale));
					const context = this.canvas.getContext('2d', { alpha: true });
					if (!context) return;

					for (let index = 0; index < frameCount; index += 1) {
						if (token !== this.cancelToken) return;
						const time = frameCount === 1 ? 0 : Math.min((index / (frameCount - 1)) * this.video.duration, Math.max(0, this.video.duration - 0.001));
						await this.seek(time);
						context.clearRect(0, 0, this.canvas.width, this.canvas.height);
						context.drawImage(this.video, 0, 0, this.canvas.width, this.canvas.height);
						const sourceBlob = await this.canvasToBlob(this.canvas, 'image/jpeg', 0.86);
						const frame = this.createFrame(sourceBlob, index + 1, time);
						this.frames.push(frame);
						this.gallery.append(frame.figure);
						const complete = index + 1;
						this.progress.style.width = `${(complete / frameCount) * 100}%`;
						this.setStatus(`Extracting ${complete} of ${frameCount}`);
						this.summary.textContent = `${complete} frame${complete === 1 ? '' : 's'}`;
					}

					const capped = requestedCount > frameCount ? ' - capped at 240' : '';
					this.setStatus(`Extraction complete${capped}`);
					this.extractButton.disabled = false;
					this.removeBgButton.disabled = this.frames.length === 0;
					this.saveFramesButton.disabled = this.frames.length === 0;
					await this.persistFramesSnapshot();
				}

				createFrame(sourceBlob, number, time, sourceName = '') {
					const sourceUrl = URL.createObjectURL(sourceBlob);
					const figure = document.createElement('figure');
					figure.className = 'frame';
					const image = document.createElement('img');
					image.className = 'frame-image';
					image.src = sourceUrl;
					image.alt = sourceName || `Frame ${number} at ${this.formatTime(time)}`;
					const caption = document.createElement('figcaption');
					caption.className = 'frame-caption';
					const label = document.createElement('span');
					label.className = 'frame-number';
					label.textContent = `Frame ${String(number).padStart(3, '0')}`;
					const timestamp = document.createElement('span');
					timestamp.className = 'frame-source';
					timestamp.textContent = sourceName || this.formatTime(time);
					caption.append(label, timestamp);
					figure.append(image, caption);
					const frame = {
						figure,
						image,
						number,
						time,
						sourceName,
						outputName: sourceName ? `${String(number).padStart(3, '0')}-${this.safeBaseName(sourceName)}.png` : '',
						sourceBlob,
						sourceUrl,
						processedBlob: null,
						processedUrl: '',
					};
					figure.tabIndex = 0;
					figure.setAttribute('role', 'button');
					figure.setAttribute('aria-label', `Select frame ${number}`);
					figure.addEventListener('click', (event) => this.toggleFrameSelection(frame, event.shiftKey));
					figure.addEventListener('keydown', (event) => {
						if (event.key === 'Enter' || event.key === ' ') {
							event.preventDefault();
							this.toggleFrameSelection(frame, event.shiftKey);
						}
					});
					return frame;
				}

				toggleFrameSelection(frame, shiftKey = false) {
					this.selectedFrames ||= [];
					const index = this.frames.indexOf(frame);
					if (index < 0) return;
					if (shiftKey && this.lastSelectedFrameIndex != null) {
						const start = Math.min(this.lastSelectedFrameIndex, index);
						const end = Math.max(this.lastSelectedFrameIndex, index);
						this.selectedFrames = this.frames.slice(start, end + 1);
					} else {
						const selectedIndex = this.selectedFrames.indexOf(frame);
						if (selectedIndex >= 0) this.selectedFrames.splice(selectedIndex, 1);
						else this.selectedFrames.push(frame);
						this.lastSelectedFrameIndex = index;
					}
					this.renderSelectedSequence();
				}

				clearSelectedSequence() {
					this.selectedFrames = [];
					this.lastSelectedFrameIndex = null;
					this.renderSelectedSequence();
				}

				moveSelectedFrame(from, to) {
					if (to < 0 || to >= this.selectedFrames.length || from === to) return;
					const [frame] = this.selectedFrames.splice(from, 1);
					this.selectedFrames.splice(to, 0, frame);
					this.renderSelectedSequence();
				}

				renderSelectedSequence() {
					this.selectedFrames ||= [];
					const selected = new Set(this.selectedFrames);
					for (const frame of this.frames) {
						frame.figure.dataset.selected = String(selected.has(frame));
						frame.figure.setAttribute('aria-pressed', String(selected.has(frame)));
					}
					this.sequenceCount.textContent = `${this.selectedFrames.length} selected`;
					this.clearSequenceButton.disabled = this.selectedFrames.length === 0;
					this.sheetBuildButton.disabled = this.selectedFrames.length === 0;
					this.resetFramesheetPreview();
					if (!this.selectedFrames.length) {
						this.sequenceList.innerHTML = '<div class="sequence-empty">Click frames above to select them. Shift-click the last frame to select a range.</div>';
						this.sheetStatus.textContent = 'Select frames above to build a frame-sheet';
						return;
					}
					const cards = this.selectedFrames.map((frame, index) => {
						const card = document.createElement('figure');
						card.className = 'sequence-card';
						const image = document.createElement('img');
						image.src = frame.processedUrl || frame.sourceUrl;
						image.alt = `Selected frame ${frame.number}`;
						const order = document.createElement('span');
						order.className = 'sequence-order';
						order.textContent = String(index + 1);
						const buttons = document.createElement('div');
						buttons.className = 'sequence-buttons';
						const drag = Object.assign(document.createElement('button'), { type: 'button', textContent: '⠿', title: 'Drag and place frame' });
						drag.className = 'drag-handle';
						drag.draggable = true;
						const remove = Object.assign(document.createElement('button'), { type: 'button', textContent: '×', title: 'Remove from selection' });
						drag.addEventListener('dragstart', (event) => { this.draggedSequenceIndex = index; event.dataTransfer?.setData('text/plain', String(index)); });
						remove.addEventListener('click', () => { this.selectedFrames.splice(index, 1); this.renderSelectedSequence(); });
						buttons.append(drag, remove);
						const caption = document.createElement('span');
						caption.className = 'sequence-caption';
						caption.textContent = frame.sourceName || `Frame ${String(frame.number).padStart(3, '0')}`;
						card.addEventListener('dragover', (event) => event.preventDefault());
						card.addEventListener('drop', (event) => { event.preventDefault(); this.moveSelectedFrame(this.draggedSequenceIndex, index); });
						card.append(image, order, buttons, caption);
						return card;
					});
					this.sequenceList.replaceChildren(...cards);
					this.sheetStatus.textContent = `${this.selectedFrames.length} selected frames ready for stitching`;
				}

				async removeBackgroundFromFrames() {
					if (this.frames.length === 0) return;
					const token = ++this.cancelToken;
					this.extractButton.disabled = true;
					this.removeBgButton.disabled = true;
					this.saveFramesButton.disabled = true;
					this.clearButton.disabled = true;
					this.progress.style.width = '0%';

					try {
						const context = this.canvas.getContext('2d', { alpha: true });
						if (!context) throw new Error('Canvas context unavailable.');
						let changedFrames = 0;

						for (let index = 0; index < this.frames.length; index += 1) {
							if (token !== this.cancelToken) return;
							const frame = this.frames[index];
							const bitmap = await createImageBitmap(frame.sourceBlob);
							this.canvas.width = bitmap.width;
							this.canvas.height = bitmap.height;
							context.clearRect(0, 0, bitmap.width, bitmap.height);
							context.drawImage(bitmap, 0, 0);
							bitmap.close();

							const imageData = context.getImageData(0, 0, this.canvas.width, this.canvas.height);
							if (this.removeBackgroundPixels(imageData.data)) changedFrames += 1;
							context.clearRect(0, 0, this.canvas.width, this.canvas.height);
							context.putImageData(imageData, 0, 0);

							const processedBlob = await this.canvasToBlob(this.canvas, 'image/png');
							if (frame.processedUrl) URL.revokeObjectURL(frame.processedUrl);
							frame.processedBlob = processedBlob;
							frame.processedUrl = URL.createObjectURL(processedBlob);
							frame.image.src = frame.processedUrl;
							frame.figure.dataset.processed = 'true';

							const complete = index + 1;
							this.progress.style.width = `${(complete / this.frames.length) * 100}%`;
							this.setStatus(`Removing background ${complete} of ${this.frames.length}`);
						}

						this.summary.textContent = `${this.frames.length} transparent frame${this.frames.length === 1 ? '' : 's'}`;
						this.setStatus(changedFrames > 0
							? `Background removed from ${changedFrames} frame${changedFrames === 1 ? '' : 's'}`
							: 'Processing complete - no matching background pixels found');
						this.saveFramesButton.disabled = false;
						this.renderSelectedSequence();
						await this.persistFramesSnapshot();
					} catch (error) {
						this.setStatus(error instanceof Error ? error.message : 'Background removal failed.');
					} finally {
						this.extractButton.disabled = false;
						this.removeBgButton.disabled = false;
						this.clearButton.disabled = false;
					}
				}

				removeBackgroundPixels(data) {
					const key = this.hexToRgb(this.bgColorInput.value || '#00ff00');
					const tolerance = Math.min(220, Math.max(0, Number(this.bgToleranceInput.value) || 72));
					const softness = 24;
					let changed = false;

					for (let index = 0; index < data.length; index += 4) {
						const originalAlpha = data[index + 3];
						if (originalAlpha === 0) continue;
						const dr = data[index] - key.r;
						const dg = data[index + 1] - key.g;
						const db = data[index + 2] - key.b;
						const distance = Math.sqrt(dr * dr + dg * dg + db * db);
						if (distance <= tolerance) {
							data[index + 3] = 0;
							changed = true;
						} else if (distance <= tolerance + softness) {
							data[index + 3] = Math.min(originalAlpha, Math.round(((distance - tolerance) / softness) * 255));
							changed = true;
						}
					}

					return changed;
				}

				async saveProcessedFrames() {
					const exportFrames = this.frames;
					if (exportFrames.length === 0) return;
					this.saveFramesButton.disabled = true;
					this.removeBgButton.disabled = true;
					const baseName = this.safeBaseName(this.file?.name || 'video');

					try {
						if ('showDirectoryPicker' in window) {
							let directory;
							if (this.currentCropFolder) {
								directory = await this.currentCropFolder.getDirectoryHandle(`${this.fileTimestamp()}-frames`, { create: true });
							} else {
								directory = this.outputDirectoryHandle || await this.getStoredValue('frame-grid-output-handle');
								if (!directory || !await this.ensurePermission(directory, 'readwrite', true)) {
									directory = await window.showDirectoryPicker({ mode: 'readwrite' });
								}
								this.outputDirectoryHandle = directory;
								await this.storeValue('frame-grid-output-handle', directory);
							}
							for (let index = 0; index < exportFrames.length; index += 1) {
								const frame = exportFrames[index];
								const name = frame.outputName || `${baseName}-frame-${String(frame.number).padStart(3, '0')}.png`;
								const fileHandle = await directory.getFileHandle(name, { create: true });
								const writable = await fileHandle.createWritable();
								await writable.write(frame.processedBlob || frame.sourceBlob);
								await writable.close();
								this.setStatus(`Saving frame ${index + 1} of ${exportFrames.length}`);
							}
						} else {
							for (const frame of exportFrames) {
								const link = document.createElement('a');
								link.href = frame.processedUrl || frame.sourceUrl;
								link.download = frame.outputName || `${baseName}-frame-${String(frame.number).padStart(3, '0')}.png`;
								link.click();
								await new Promise((resolve) => window.setTimeout(resolve, 120));
							}
						}
						this.setStatus(`Saved ${exportFrames.length} PNG frame${exportFrames.length === 1 ? '' : 's'}${this.currentCropFolder ? ' in a new timestamped frames folder' : ''}`);
						if (this.currentCropFolder) void this.refreshGifLibrary(false);
					} catch (error) {
						this.setStatus(error?.name === 'AbortError' ? 'Save canceled' : 'Could not save processed frames.');
					} finally {
						this.saveFramesButton.disabled = false;
						this.removeBgButton.disabled = false;
					}
				}

				canvasToBlob(canvas, type, quality) {
					return new Promise((resolve, reject) => {
						canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error('Frame image export failed.')), type, quality);
					});
				}

				hexToRgb(hex) {
					const normalized = /^#[0-9a-f]{6}$/i.test(hex) ? hex : '#00ff00';
					const value = Number.parseInt(normalized.slice(1), 16);
					return { r: (value >> 16) & 255, g: (value >> 8) & 255, b: value & 255 };
				}

				safeBaseName(name) {
					return name.replace(/\.[^.]+$/, '').replace(/[^a-z0-9_-]+/gi, '-').replace(/^-+|-+$/g, '') || 'video';
				}

				naturalCompare(a, b) {
					return a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' });
				}

				seek(time) {
					const target = time <= 0
						? Math.min(0.001, Math.max(0, this.video.duration - 0.001))
						: time;
					if (Math.abs(this.video.currentTime - target) < 0.0001 && this.video.readyState >= 2) {
						return this.waitForVideoFrame();
					}
					const complete = this.once(this.video, 'seeked');
					this.video.currentTime = target;
					return complete.then(() => this.waitForVideoFrame());
				}

				waitForVideoFrame() {
					return new Promise((resolve) => requestAnimationFrame(() => requestAnimationFrame(resolve)));
				}

				once(target, eventName) {
					return new Promise((resolve, reject) => {
						const timeout = window.setTimeout(() => {
							target.removeEventListener(eventName, done);
							reject(new Error(`Timed out waiting for ${eventName}`));
						}, 15000);
						const done = () => {
							window.clearTimeout(timeout);
							resolve();
						};
						target.addEventListener(eventName, done, { once: true });
					});
				}

				resetGallery(showEmpty = true) {
					for (const frame of this.frames) {
						URL.revokeObjectURL(frame.sourceUrl);
						if (frame.processedUrl) URL.revokeObjectURL(frame.processedUrl);
					}
					this.frames = [];
					this.selectedFrames = [];
					this.lastSelectedFrameIndex = null;
					this.renderSelectedSequence();
					this.gallery.replaceChildren();
					if (showEmpty) {
						const empty = document.createElement('div');
						empty.className = 'empty-state';
						empty.innerHTML = '<p><strong>No frames loaded</strong><span>Choose or drop a GIF or video to populate the grid.</span></p>';
						this.gallery.append(empty);
					}
					this.summary.textContent = '0 frames';
					this.progress.style.width = '0%';
					this.removeBgButton.disabled = true;
					this.saveFramesButton.disabled = true;
				}

				async clear() {
					this.cancelToken += 1;
					this.workspaceReady = false;
					window.clearTimeout(this.workspaceSaveTimer);
					try { await Promise.all([
						'frame-grid-video-handle',
						'frame-grid-folder-handle',
						'frame-grid-output-handle',
						'frame-grid-video-file',
						'frame-grid-folder-files',
						'frame-grid-workspace',
						'frame-grid-frames',
					].map((key) => this.deleteValue(key))); } catch {}
					this.file = null;
					this.videoHandle = null;
					this.framesDirectoryHandle = null;
					this.outputDirectoryHandle = null;
					this.video.removeAttribute('src');
					this.video.load();
					if (this.videoUrl) URL.revokeObjectURL(this.videoUrl);
					this.videoUrl = '';
					if (this.gifPreviewUrl) URL.revokeObjectURL(this.gifPreviewUrl);
					this.gifPreviewUrl = '';
					this.gifWorkspaceFile = null;
					this.gifWorkspaceFolder = null;
					this.currentCropFolder = null;
					this.fileInput.value = '';
					this.folderInput.value = '';
					this.fileName.textContent = 'Current GIF';
					this.fileHint.textContent = 'No GIF selected';
					this.currentSourceStats = null;
					this.extractButton.disabled = true;
					this.removeBgButton.disabled = true;
					this.saveFramesButton.disabled = true;
					this.clearButton.disabled = true;
					this.cropButton.disabled = true;
					this.setStatus('Waiting for a GIF or video');
					this.resetGallery();
				}

				setStatus(message) { this.status.textContent = message; }

				updateCurrentSourceStats() {
					if (!this.currentSourceStats) return;
					const { size, width, height, duration, sourceFrames } = this.currentSourceStats;
					const requested = Math.max(1, Math.floor(Number(this.fpsInput.value) || 1));
					const extracting = sourceFrames == null ? Math.min(240, requested) : Math.min(sourceFrames, requested);
					const sourceLabel = sourceFrames == null ? 'Source frames: unavailable for video' : `Source frames: ${sourceFrames}`;
					this.fileHint.textContent = `${this.formatBytes(size)} - ${width}x${height} - ${this.formatTime(duration)} - ${sourceLabel} - Extracting: ${extracting}`;
				}

				formatBytes(bytes) {
					if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
					return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
				}

				formatTime(seconds) {
					const safe = Number.isFinite(seconds) ? Math.max(0, seconds) : 0;
					const minutes = Math.floor(safe / 60);
					const remainder = (safe % 60).toFixed(2).padStart(5, '0');
					return `${String(minutes).padStart(2, '0')}:${remainder}`;
				}
			}

			customElements.define('frame-grid-app', FrameGridApp);
		</script>
	</body>
</html>
