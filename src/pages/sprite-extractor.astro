					this.querySelector('[data-frame-status]').textContent = `${this.frames.length} frame${this.frames.length === 1 ? '' : 's'}`;
					this.querySelector('[data-play]').disabled = this.frames.length === 0;
					this.querySelector('[data-save]').disabled = this.frames.length === 0;
					if (!this.frames.length) this.frameList.innerHTML = '<div class="frame-list-empty">Detected and hand-drawn frames appear here. Select a frame to resize or inspect it.</div>';
					else this.frameList.innerHTML = this.frames.map((frame, index) => `<article class="frame-item" data-frame-id="${frame.id}" data-active="${frame.id === this.activeId}"><canvas class="frame-thumb" width="140" height="140"></canvas><div class="frame-info"><div class="frame-title"><button type="button" data-action="select">Frame ${String(index + 1).padStart(2, '0')}</button><span class="frame-actions"><button class="mini-button" data-action="up" type="button" title="Move earlier">&uarr;</button><button class="mini-button" data-action="down" type="button" title="Move later">&darr;</button><button class="mini-button" data-action="delete" type="button" title="Delete">x</button></span></div><div class="frame-size"><input data-size="width" type="number" min="1" max="4096" value="${frame.outputWidth}" aria-label="Crop width"/><span class="status">x</span><input data-size="height" type="number" min="1" max="4096" value="${frame.outputHeight}" aria-label="Crop height"/></div><div class="frame-offset"><span class="axis-label">X</span><input data-offset="x" type="number" min="-4096" max="4096" value="${frame.offsetX}" aria-label="Scene offset X"/><span class="axis-label">Y</span><input data-offset="y" type="number" min="-4096" max="4096" value="${frame.offsetY}" aria-label="Scene offset Y"/></div></div></article>`).join('');
