					this.querySelector('[data-empty-canvas]').hidden = false;
					this.querySelector('[data-auto-detect]').disabled = true;
					this.querySelector('[data-pick-background]').disabled = true;
					this.querySelector('[data-remove-background]').disabled = true;
					this.querySelector('[data-reset-background]').disabled = true;
					this.querySelector('[data-clear]').disabled = true;
					this.querySelector('[data-stage-label]').textContent = 'Canvas ready';
