---
const pageTitle = 'Sprite Sheet Extractor';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Extract, resize, preview, and save animation frames from one image." />
		<title>{pageTitle}</title>
		<style is:global>
			:root {
				font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				color: #171917;
				background: #f4f5f4;
				font-synthesis: none;
			}

			* { box-sizing: border-box; }
			[hidden] { display: none !important; }

			body {
				min-width: 320px;
				min-height: 100vh;
				margin: 0;
				background: #f4f5f4;
			}

			button,
			input { font: inherit; }
			button { cursor: pointer; }
			button:disabled { cursor: not-allowed; opacity: 0.45; }
			button:focus-visible,
			input:focus-visible,
			label:focus-within { outline: 2px solid #171917; outline-offset: 2px; }

			.utility-bar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				height: 52px;
				padding: 0 clamp(16px, 3vw, 40px);
				color: #f8faf8;
				background: #171917;
			}

			.brand-link { color: inherit; text-decoration: none; }
			.brand { margin: 0; font-size: 0.875rem; font-weight: 680; }
			.local-status { display: flex; align-items: center; gap: 8px; font-size: 0.75rem; color: #bec4be; }
			.local-dot { width: 7px; height: 7px; border-radius: 50%; background: #52d273; box-shadow: 0 0 0 3px rgba(82, 210, 115, 0.14); }

			main { width: min(1500px, calc(100% - 28px)); margin: clamp(18px, 3vw, 38px) auto; }
			.workbench { overflow: hidden; border: 1px solid #d9ddd9; border-radius: 8px; background: #fff; box-shadow: 0 16px 48px rgba(20, 24, 20, 0.07); }
			.workbench-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; padding: 22px 24px 18px; border-bottom: 1px solid #e4e7e4; }
			h1, h2, p { margin-top: 0; }
			h1 { margin-bottom: 0; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.2; }
			.intro { max-width: 710px; margin: 7px 0 0; color: #656b65; font-size: 0.875rem; line-height: 1.55; }

			.button,
			.tool-button {
				display: inline-flex;
				min-height: 36px;
				align-items: center;
				justify-content: center;
				gap: 7px;
				padding: 0 13px;
				border: 1px solid #cfd4cf;
				border-radius: 6px;
				color: #363a36;
				background: #fff;
				font-size: 0.78rem;
				font-weight: 650;
			}

			.button:hover:not(:disabled), .tool-button:hover:not(:disabled) { border-color: #8d948d; }
			.button.primary { border-color: #21853d; color: #fff; background: #238f43; }
			.button.primary:hover:not(:disabled) { background: #1d7938; }
			.button.dark { border-color: #171917; color: #fff; background: #171917; }
			.button.danger { color: #a52727; }
			.tool-button[aria-pressed="true"] { border-color: #238f43; color: #176b30; background: #eef8f0; box-shadow: inset 0 0 0 1px #238f43; }

			.source-bar { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 14px 24px; border-bottom: 1px solid #e4e7e4; background: #fbfcfb; }
			.source-copy { min-width: 0; }
			.source-name { display: block; overflow: hidden; max-width: 640px; margin-bottom: 3px; font-size: 0.84rem; font-weight: 680; text-overflow: ellipsis; white-space: nowrap; }
			.source-meta, .status { color: #747a74; font-family: "SFMono-Regular", Consolas, monospace; font-size: 0.68rem; line-height: 1.45; }
			.source-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }
			.file-input { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }

			.editor-grid { display: grid; grid-template-columns: 244px minmax(420px, 1fr) 310px; height: clamp(620px, calc(100vh - 190px), 760px); }
			.sidebar { min-width: 0; background: #fbfcfb; }
			.sidebar.left { border-right: 1px solid #e4e7e4; }
			.sidebar.right { display: grid; min-height: 0; grid-template-rows: auto minmax(210px, 1fr) auto; border-left: 1px solid #e4e7e4; }
			.panel-section { padding: 17px 16px; border-bottom: 1px solid #e4e7e4; }
			.panel-section h2 { margin-bottom: 12px; font-size: 0.78rem; letter-spacing: 0.01em; text-transform: uppercase; }
			.tool-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
			.tool-grid .tool-button:first-child { grid-column: 1 / -1; }
			.field-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
			.field { display: block; min-width: 0; }
			.field.wide { grid-column: 1 / -1; }
			.field-label { display: block; margin-bottom: 6px; color: #545954; font-size: 0.7rem; font-weight: 680; }
			.number-input, .text-input { width: 100%; height: 36px; padding: 0 9px; border: 1px solid #cfd4cf; border-radius: 5px; color: #171917; background: #fff; font-size: 0.78rem; }
			.range-input { width: 100%; accent-color: #238f43; }
			.check-row { display: flex; align-items: flex-start; gap: 9px; color: #4d534d; font-size: 0.74rem; line-height: 1.45; }
			.check-row input { flex: 0 0 auto; margin-top: 2px; accent-color: #238f43; }
			.hint { margin: 8px 0 0; color: #747a74; font-size: 0.69rem; line-height: 1.5; }
			.color-input { width: 100%; height: 36px; padding: 3px; border: 1px solid #cfd4cf; border-radius: 5px; background: #fff; }
			.action-stack { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 10px; }

			.stage { display: grid; min-width: 0; grid-template-rows: auto minmax(420px, 1fr) auto; background: #e9ebe9; }
			.stage-toolbar, .stage-status { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 10px 14px; border-bottom: 1px solid #d7dbd7; background: #f8f9f8; }
			.stage-status { border-top: 1px solid #d7dbd7; border-bottom: 0; }
			.zoom-actions { display: flex; gap: 6px; }
			.icon-button { width: 32px; height: 30px; border: 1px solid #cfd4cf; border-radius: 5px; background: #fff; font-weight: 700; }
			.canvas-shell { position: relative; min-height: 0; overflow: hidden; }
			.editor-canvas { display: block; width: 100%; height: 100%; touch-action: none; }
			.empty-canvas { position: absolute; inset: 0; display: grid; place-items: center; padding: 32px; pointer-events: none; }
			.empty-card { max-width: 360px; padding: 24px; border: 1px dashed #aeb4ae; border-radius: 7px; color: #656b65; background: rgba(255,255,255,0.88); text-align: center; }
			.empty-card strong { display: block; margin-bottom: 7px; color: #171917; font-size: 0.9rem; }

			.frames-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 15px 14px 12px; border-bottom: 1px solid #e4e7e4; }
			.frames-head h2 { margin: 0; font-size: 0.86rem; }
			.count-badge { min-width: 25px; padding: 3px 7px; border-radius: 999px; color: #176b30; background: #e9f7ed; font-size: 0.68rem; font-weight: 700; text-align: center; }
			.frame-list { min-height: 0; overflow: auto; padding: 10px; }
			.frame-list-empty { padding: 28px 14px; color: #747a74; font-size: 0.75rem; line-height: 1.55; text-align: center; }
			.frame-item { display: grid; grid-template-columns: 70px minmax(0, 1fr); gap: 10px; margin-bottom: 8px; padding: 8px; border: 1px solid #d9ddd9; border-radius: 6px; background: #fff; }
			.frame-item[data-active="true"] { border-color: #238f43; box-shadow: inset 0 0 0 1px #238f43; }
			.frame-thumb { display: block; width: 70px; height: 70px; border: 1px solid #e0e3e0; border-radius: 4px; background-color: #fff; background-image: linear-gradient(45deg,#e8e8e8 25%,transparent 25%),linear-gradient(-45deg,#e8e8e8 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#e8e8e8 75%),linear-gradient(-45deg,transparent 75%,#e8e8e8 75%); background-position: 0 0,0 6px,6px -6px,-6px 0; background-size: 12px 12px; }
			.frame-info { min-width: 0; }
			.frame-title { display: flex; align-items: center; justify-content: space-between; gap: 5px; margin-bottom: 7px; }
			.frame-title button { overflow: hidden; padding: 0; border: 0; color: #171917; background: transparent; font-size: 0.75rem; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
			.frame-actions { display: flex; gap: 3px; }
			.mini-button { width: 24px; height: 23px; padding: 0; border: 1px solid #d9ddd9; border-radius: 4px; color: #505650; background: #fff; font-size: 0.65rem; }
			.frame-size { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 5px; }
			.frame-size input { width: 100%; height: 29px; padding: 0 5px; border: 1px solid #d9ddd9; border-radius: 4px; font-size: 0.68rem; }
			.frame-offset { display: grid; grid-template-columns: auto 1fr auto 1fr; align-items: center; gap: 4px; margin-top: 6px; }
			.frame-offset input { width: 100%; min-width: 0; height: 27px; padding: 0 4px; border: 1px solid #d9ddd9; border-radius: 4px; font-size: 0.65rem; }
			.axis-label { color: #747a74; font-family: "SFMono-Regular", Consolas, monospace; font-size: 0.62rem; }

			.preview-panel { padding: 14px; border-top: 1px solid #e4e7e4; background: #fff; }
			.preview-panel h2 { margin-bottom: 10px; font-size: 0.82rem; }
			.preview-canvas { display: block; width: 100%; height: 150px; border: 1px solid #d9ddd9; border-radius: 6px; background-color: #fff; background-image: linear-gradient(45deg,#e8e8e8 25%,transparent 25%),linear-gradient(-45deg,#e8e8e8 25%,transparent 25%),linear-gradient(45deg,transparent 75%,#e8e8e8 75%),linear-gradient(-45deg,transparent 75%,#e8e8e8 75%); background-position: 0 0,0 8px,8px -8px,-8px 0; background-size: 16px 16px; }
			.preview-canvas[data-aligning="true"] { cursor: grabbing; }
			.scene-grid { display: grid; grid-template-columns: 1fr 1fr auto; align-items: end; gap: 8px; margin-bottom: 10px; }
			.nudge-grid { display: grid; grid-template-columns: repeat(3, 31px); grid-template-rows: repeat(3, 28px); justify-content: center; gap: 4px; margin-top: 10px; }
			.nudge-button { padding: 0; border: 1px solid #cfd4cf; border-radius: 4px; color: #363a36; background: #fff; font-size: 0.72rem; font-weight: 700; }
			.nudge-button[data-nudge="up"] { grid-column: 2; grid-row: 1; }
			.nudge-button[data-nudge="left"] { grid-column: 1; grid-row: 2; }
			.nudge-button[data-action="center-frame"] { grid-column: 2; grid-row: 2; font-size: 0.58rem; }
			.nudge-button[data-nudge="right"] { grid-column: 3; grid-row: 2; }
			.nudge-button[data-nudge="down"] { grid-column: 2; grid-row: 3; }
			.alignment-note { margin: 8px 0 0; color: #747a74; font-size: 0.68rem; line-height: 1.45; text-align: center; }
			.playback-row { display: grid; grid-template-columns: auto 1fr auto; align-items: end; gap: 8px; margin-top: 10px; }
			.playback-row .button { min-width: 66px; }
			.save-stack { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 12px; }
			.save-stack .status { grid-column: 1 / -1; min-height: 1.5em; margin: 0; }

			@media (max-width: 1120px) {
				.editor-grid { height: auto; min-height: 620px; grid-template-columns: 220px minmax(380px, 1fr); }
				.sidebar.right { grid-column: 1 / -1; grid-template-columns: minmax(0, 1fr) 310px; grid-template-rows: auto minmax(220px, 360px); border-top: 1px solid #e4e7e4; border-left: 0; }
				.sidebar.right .frames-head { grid-column: 1; }
				.sidebar.right .frame-list { grid-column: 1; }
				.preview-panel { grid-column: 2; grid-row: 1 / 3; border-top: 0; border-left: 1px solid #e4e7e4; }
			}

			@media (max-width: 760px) {
				main { width: min(100% - 16px, 1500px); margin: 8px auto; }
				.workbench-head, .source-bar { align-items: stretch; flex-direction: column; }
				.source-actions { justify-content: stretch; }
				.source-actions .button { flex: 1; }
				.editor-grid { display: block; }
				.sidebar.left { border-right: 0; border-bottom: 1px solid #e4e7e4; }
				.stage { min-height: 580px; }
				.sidebar.right { display: grid; grid-template-columns: 1fr; grid-template-rows: auto 330px auto; }
				.preview-panel { grid-column: 1; grid-row: auto; border-top: 1px solid #e4e7e4; border-left: 0; }
			}
		</style>
	</head>
	<body>
		<header class="utility-bar">
			<a class="brand-link" href="/"><p class="brand">Video to Animation / Sprite Sheet Extractor</p></a>
			<div class="local-status"><span class="local-dot"></span><span>Local only</span></div>
		</header>

		<main>
			<sprite-extractor-app class="workbench">
				<section class="workbench-head">
					<div>
						<h1>Sprite Sheet Extractor</h1>
						<p class="intro">Load one image with scattered poses. Detect frames automatically, refine them with rectangle or lasso selections, resize each output, preview the loop, then save PNGs to a folder.</p>
					</div>
					<button data-clear class="button danger" type="button" disabled>Clear Project</button>
				</section>

				<section class="source-bar">
					<div class="source-copy">
						<span data-source-name class="source-name">No image selected</span>
						<span data-source-meta class="source-meta">PNG, WebP, or JPEG. Processing stays in this browser.</span>
					</div>
					<div class="source-actions">
						<label class="button dark" for="sprite-source">Choose Image</label>
						<input data-file-input class="file-input" id="sprite-source" type="file" accept="image/png,image/webp,image/jpeg" />
						<button data-load-example class="button" type="button">Load Example</button>
						<button data-auto-detect class="button primary" type="button" disabled>Auto Detect</button>
					</div>
				</section>

				<div class="editor-grid">
					<aside class="sidebar left">
						<section class="panel-section">
							<h2>Selection Tools</h2>
							<div class="tool-grid">
								<button data-tool="select" class="tool-button" type="button" aria-pressed="true">Select</button>
								<button data-tool="rectangle" class="tool-button" type="button" aria-pressed="false">Rectangle</button>
								<button data-tool="lasso" class="tool-button" type="button" aria-pressed="false">Lasso</button>
							</div>
							<p class="hint">Draw around one pose. Lasso exports pixels inside the freehand path only.</p>
						</section>

						<section class="panel-section">
							<h2>Framesheet Background</h2>
							<div class="field-grid">
								<label class="field"><span class="field-label">Background color</span><input data-bg-color class="color-input" type="color" value="#ffffff" /></label>
								<label class="field"><span class="field-label">Tolerance</span><input data-bg-tolerance class="number-input" type="number" min="0" max="255" value="36" /></label>
							</div>
							<div class="action-stack">
								<button data-pick-background class="button" type="button" disabled>Pick Color</button>
								<button data-remove-background class="button primary" type="button" disabled>Remove</button>
								<button data-reset-background class="button wide" style="grid-column:1 / -1" type="button" disabled>Reset Background</button>
							</div>
							<p class="hint">Pick a background pixel from the sheet. Only matching pixels connected to image edges are removed, protecting enclosed light details.</p>
						</section>

						<section class="panel-section">
							<h2>Auto Detection</h2>
							<div class="field-grid">
								<label class="field"><span class="field-label">Light cutoff</span><input data-light-cutoff class="number-input" type="number" min="160" max="254" value="225" /></label>
								<label class="field"><span class="field-label">Padding</span><input data-padding class="number-input" type="number" min="0" max="128" value="12" /></label>
								<label class="field wide"><span class="field-label">Minimum object area</span><input data-min-area class="range-input" type="range" min="20" max="2000" value="180" /></label>
							</div>
							<p class="hint">Transparent images use alpha. Opaque checkerboard images use brightness and color contrast.</p>
						</section>

						<section class="panel-section">
							<h2>Extracted Frame Size</h2>
							<div class="field-grid">
								<label class="field"><span class="field-label">Width</span><input data-default-width class="number-input" type="number" min="1" max="4096" value="256" /></label>
								<label class="field"><span class="field-label">Height</span><input data-default-height class="number-input" type="number" min="1" max="4096" value="256" /></label>
							</div>
							<label class="check-row" style="margin-top:12px"><input data-preserve-ratio type="checkbox" checked /> Preserve crop aspect ratio while resizing each extracted frame</label>
							<label class="check-row" style="margin-top:10px"><input data-remove-light type="checkbox" checked /> Fallback: remove light crop-edge background when full sheet removal is off</label>
						</section>
					</aside>

					<section class="stage">
						<div class="stage-toolbar">
							<span data-stage-label class="status">Canvas ready</span>
							<div class="zoom-actions">
								<button data-zoom-out class="icon-button" type="button" aria-label="Zoom out">-</button>
								<button data-fit class="button" type="button">Fit</button>
								<button data-zoom-in class="icon-button" type="button" aria-label="Zoom in">+</button>
							</div>
						</div>
						<div data-canvas-shell class="canvas-shell">
							<canvas data-editor-canvas class="editor-canvas"></canvas>
							<div data-empty-canvas class="empty-canvas"><div class="empty-card"><strong>Choose an image to begin</strong>Auto Detect works with transparent sprites and light checkerboard backgrounds.</div></div>
						</div>
						<div class="stage-status">
							<span data-pointer-status class="status">X 0 / Y 0</span>
							<span data-frame-status class="status" aria-live="polite">0 frames</span>
						</div>
					</section>

					<aside class="sidebar right">
						<div class="frames-head"><h2>Detected Frames</h2><span data-count class="count-badge">0</span></div>
						<div data-frame-list class="frame-list"><div class="frame-list-empty">Detected and hand-drawn frames appear here. Select a frame to resize or inspect it.</div></div>
						<section class="preview-panel">
							<h2>Animation Preview</h2>
							<div class="scene-grid">
								<label class="field"><span class="field-label">Scene width</span><input data-scene-width class="number-input" type="number" min="1" max="4096" value="512" /></label>
								<label class="field"><span class="field-label">Scene height</span><input data-scene-height class="number-input" type="number" min="1" max="4096" value="512" /></label>
								<button data-action="fit-scene" class="button" type="button">Fit</button>
							</div>
							<canvas data-preview-canvas class="preview-canvas" tabindex="0" aria-label="Scene alignment canvas. Drag selected frame or use arrow keys to reposition it."></canvas>
							<div class="nudge-grid" aria-label="Frame position controls">
								<button data-nudge="up" class="nudge-button" type="button" title="Move frame up">&uarr;</button>
								<button data-nudge="left" class="nudge-button" type="button" title="Move frame left">&larr;</button>
								<button data-action="center-frame" class="nudge-button" type="button" title="Center active frame">Center</button>
								<button data-nudge="right" class="nudge-button" type="button" title="Move frame right">&rarr;</button>
								<button data-nudge="down" class="nudge-button" type="button" title="Move frame down">&darr;</button>
							</div>
							<p class="alignment-note">Select a frame, then drag it inside the scene or use arrow controls. Shift = 10 px.</p>
							<div class="playback-row">
								<button data-play class="button dark" type="button" disabled>Play</button>
								<label class="field"><span class="field-label">FPS</span><input data-fps class="number-input" type="number" min="1" max="60" value="12" /></label>
								<span data-preview-count class="status">0 / 0</span>
							</div>
							<div class="save-stack">
								<button data-folder class="button" type="button">Choose Folder</button>
								<button data-save class="button primary" type="button" disabled>Save All Frames</button>
								<p data-save-status class="status" aria-live="polite">No output folder selected.</p>
							</div>
						</section>
					</aside>
				</div>
			</sprite-extractor-app>
		</main>

		<script>
			class SpriteExtractorApp extends HTMLElement {
				image = null;
				imageUrl = '';
				frames = [];
				activeId = '';
				tool = 'select';
				drawing = null;
				viewZoom = 1;
				view = { x: 0, y: 0, scale: 1 };
				directoryHandle = null;
				animationTimer = null;
				previewIndex = 0;
				frameCounter = 0;
				previewDrag = null;
				previewView = { x: 0, y: 0, scale: 1 };
				sourceCanvas = null;
				backgroundRemoved = false;

				connectedCallback() {
					this.fileInput = this.querySelector('[data-file-input]');
					this.canvas = this.querySelector('[data-editor-canvas]');
					this.canvasShell = this.querySelector('[data-canvas-shell]');
					this.previewCanvas = this.querySelector('[data-preview-canvas]');
					this.frameList = this.querySelector('[data-frame-list]');
					this.fileInput?.addEventListener('change', (event) => this.loadFile(event.target.files?.[0]));
					this.querySelector('[data-load-example]')?.addEventListener('click', () => this.loadExample());
					this.querySelector('[data-auto-detect]')?.addEventListener('click', () => this.autoDetect());
					this.querySelector('[data-clear]')?.addEventListener('click', () => this.clearProject());
					this.querySelector('[data-pick-background]')?.addEventListener('click', () => this.setTool('background'));
					this.querySelector('[data-remove-background]')?.addEventListener('click', () => this.removeFramesheetBackground());
					this.querySelector('[data-reset-background]')?.addEventListener('click', () => this.resetFramesheetBackground());
					this.querySelector('[data-fit]')?.addEventListener('click', () => { this.viewZoom = 1; this.drawEditor(); });
					this.querySelector('[data-zoom-in]')?.addEventListener('click', () => { this.viewZoom = Math.min(4, this.viewZoom * 1.2); this.drawEditor(); });
					this.querySelector('[data-zoom-out]')?.addEventListener('click', () => { this.viewZoom = Math.max(0.35, this.viewZoom / 1.2); this.drawEditor(); });
					this.querySelector('[data-play]')?.addEventListener('click', () => this.togglePlayback());
					this.querySelector('[data-fps]')?.addEventListener('change', () => { if (this.animationTimer) { this.stopPlayback(false); this.startPlayback(); } });
