					this.drawPreview(); this.drawEditor();
				}

				onFrameListClick(event) {
					const action = event.target.closest('[data-action]'); const item = event.target.closest('[data-frame-id]');
					if (!action || !item) return;
					const index = this.frames.findIndex((frame) => frame.id === item.dataset.frameId); if (index < 0) return;
					if (action.dataset.action === 'select') { this.activeId = this.frames[index].id; this.previewIndex = index; this.stopPlayback(); }
					if (action.dataset.action === 'delete') { this.frames.splice(index, 1); if (this.activeId === item.dataset.frameId) this.activeId = this.frames[Math.min(index, this.frames.length - 1)]?.id || ''; }
					if (action.dataset.action === 'up' && index > 0) [this.frames[index - 1], this.frames[index]] = [this.frames[index], this.frames[index - 1]];
					if (action.dataset.action === 'down' && index < this.frames.length - 1) [this.frames[index + 1], this.frames[index]] = [this.frames[index], this.frames[index + 1]];
					this.renderFrames();
				}

				onFrameSizeChange(event) {
					const input = event.target.closest('[data-size]'); const item = event.target.closest('[data-frame-id]'); if (!input || !item) return;
					const frame = this.frames.find((candidate) => candidate.id === item.dataset.frameId); if (!frame) return;
					const value = Math.max(1, Math.min(4096, Number(input.value) || 1)); const preserve = this.querySelector('[data-preserve-ratio]').checked;
					if (input.dataset.size === 'width') { frame.outputWidth = value; if (preserve) frame.outputHeight = Math.max(1, Math.round(value * frame.h / frame.w)); }
					else { frame.outputHeight = value; if (preserve) frame.outputWidth = Math.max(1, Math.round(value * frame.w / frame.h)); }
					const counterpart = item.querySelector(input.dataset.size === 'width' ? '[data-size="height"]' : '[data-size="width"]');
					if (counterpart) counterpart.value = input.dataset.size === 'width' ? frame.outputHeight : frame.outputWidth;
					this.drawPreview();
				}

				onFrameOffsetChange(event) {
					const input = event.target.closest('[data-offset]'); const item = event.target.closest('[data-frame-id]'); if (!input || !item) return;
					const frame = this.frames.find((candidate) => candidate.id === item.dataset.frameId); if (!frame) return;
					const value = Math.max(-4096, Math.min(4096, Math.round(Number(input.value) || 0)));
					if (input.dataset.offset === 'x') frame.offsetX = value; else frame.offsetY = value;
					this.activeId = frame.id; this.previewIndex = this.frames.indexOf(frame); this.stopPlayback(); this.drawPreview();
				}

				drawFrameIntoCanvas(frame, canvas, useOutputSize = true) {
					if (!frame || !canvas || !this.image) return;
					const width = useOutputSize ? frame.outputWidth : canvas.width; const height = useOutputSize ? frame.outputHeight : canvas.height;
					if (useOutputSize) { canvas.width = width; canvas.height = height; }
					const context = canvas.getContext('2d', { alpha: true }); context.clearRect(0, 0, canvas.width, canvas.height); context.save();
					const scaleX = canvas.width / frame.w; const scaleY = canvas.height / frame.h;
					if (frame.polygon?.length) { context.beginPath(); const first = frame.polygon[0]; context.moveTo((first.x - frame.x) * scaleX, (first.y - frame.y) * scaleY); for (const point of frame.polygon.slice(1)) context.lineTo((point.x - frame.x) * scaleX, (point.y - frame.y) * scaleY); context.closePath(); context.clip(); }
					context.drawImage(this.sourceCanvas || this.image, frame.x, frame.y, frame.w, frame.h, 0, 0, canvas.width, canvas.height); context.restore();
					if (!this.backgroundRemoved && this.querySelector('[data-remove-light]').checked) this.removeLightBackground(context, canvas.width, canvas.height);
				}

				removeLightBackground(context, width, height) {
					const cutoff = Number(this.querySelector('[data-light-cutoff]').value) || 225; const imageData = context.getImageData(0, 0, width, height); const data = imageData.data;
					const candidates = new Uint8Array(width * height); const queue = new Int32Array(width * height); let head = 0; let tail = 0;
					for (let pixel = 0, offset = 0; pixel < candidates.length; pixel += 1, offset += 4) { const min = Math.min(data[offset], data[offset + 1], data[offset + 2]); const chroma = Math.max(data[offset], data[offset + 1], data[offset + 2]) - min; candidates[pixel] = min >= cutoff && chroma < 24 ? 1 : 0; }
					const enqueue = (index) => { if (candidates[index] !== 1) return; candidates[index] = 2; queue[tail++] = index; };
					for (let x = 0; x < width; x += 1) { enqueue(x); enqueue((height - 1) * width + x); }
					for (let y = 1; y < height - 1; y += 1) { enqueue(y * width); enqueue(y * width + width - 1); }
					while (head < tail) { const index = queue[head++]; const x = index % width; const y = (index / width) | 0; if (x > 0) enqueue(index - 1); if (x + 1 < width) enqueue(index + 1); if (y > 0) enqueue(index - width); if (y + 1 < height) enqueue(index + width); }
					for (let pixel = 0, offset = 3; pixel < candidates.length; pixel += 1, offset += 4) if (candidates[pixel] === 2) data[offset] = 0;
					context.putImageData(imageData, 0, 0);
				}

				getSceneSize() {
					return {
						width: Math.max(1, Math.min(4096, Math.round(Number(this.querySelector('[data-scene-width]').value) || 512))),
						height: Math.max(1, Math.min(4096, Math.round(Number(this.querySelector('[data-scene-height]').value) || 512))),
					};
				}

				createSceneCanvas(frame) {
					const scene = this.getSceneSize(); const canvas = document.createElement('canvas'); canvas.width = scene.width; canvas.height = scene.height;
					if (!frame || !this.image) return canvas;
					const sprite = document.createElement('canvas'); this.drawFrameIntoCanvas(frame, sprite, true);
					const context = canvas.getContext('2d', { alpha: true }); context.imageSmoothingEnabled = false;
					context.drawImage(sprite, Math.round((scene.width - sprite.width) / 2 + frame.offsetX), Math.round((scene.height - sprite.height) / 2 + frame.offsetY));
					return canvas;
				}

				fitSceneToFrames() {
					if (!this.frames.length) return;
					let width = 1; let height = 1;
					for (const frame of this.frames) { width = Math.max(width, frame.outputWidth + Math.abs(frame.offsetX) * 2); height = Math.max(height, frame.outputHeight + Math.abs(frame.offsetY) * 2); }
					this.querySelector('[data-scene-width]').value = String(Math.min(4096, Math.ceil((width + 32) / 16) * 16));
					this.querySelector('[data-scene-height]').value = String(Math.min(4096, Math.ceil((height + 32) / 16) * 16));
					this.drawPreview();
				}

				activeFrame() {
					return this.frames.find((frame) => frame.id === this.activeId) || this.frames[this.previewIndex] || null;
				}

				centerActiveFrame() {
					const frame = this.activeFrame(); if (!frame) return;
					frame.offsetX = 0; frame.offsetY = 0; this.syncOffsetInputs(frame); this.stopPlayback(); this.drawPreview();
				}

				nudgeActiveFrame(direction, amount = 1) {
					const frame = this.activeFrame(); if (!frame) return;
					if (direction === 'left') frame.offsetX -= amount; if (direction === 'right') frame.offsetX += amount;
					if (direction === 'up') frame.offsetY -= amount; if (direction === 'down') frame.offsetY += amount;
					this.syncOffsetInputs(frame); this.stopPlayback(); this.drawPreview();
				}

				syncOffsetInputs(frame) {
					const item = this.frameList.querySelector(`[data-frame-id="${CSS.escape(frame.id)}"]`); if (!item) return;
					const x = item.querySelector('[data-offset="x"]'); const y = item.querySelector('[data-offset="y"]');
					if (x) x.value = String(frame.offsetX); if (y) y.value = String(frame.offsetY);
				}

				previewScenePoint(event) {
					const rect = this.previewCanvas.getBoundingClientRect();
					return { x: (event.clientX - rect.left - this.previewView.x) / this.previewView.scale, y: (event.clientY - rect.top - this.previewView.y) / this.previewView.scale };
				}

				onPreviewPointerDown(event) {
					if (this.animationTimer) this.stopPlayback();
					const frame = this.activeFrame(); if (!frame || !this.previewView.scale) return;
					this.previewCanvas.setPointerCapture?.(event.pointerId); const point = this.previewScenePoint(event);
					this.previewDrag = { pointerId: event.pointerId, x: point.x, y: point.y, offsetX: frame.offsetX, offsetY: frame.offsetY, frame };
					this.previewCanvas.dataset.aligning = 'true';
				}

				onPreviewPointerMove(event) {
					if (!this.previewDrag || event.pointerId !== this.previewDrag.pointerId) return;
					const point = this.previewScenePoint(event); const frame = this.previewDrag.frame;
					frame.offsetX = Math.round(this.previewDrag.offsetX + point.x - this.previewDrag.x); frame.offsetY = Math.round(this.previewDrag.offsetY + point.y - this.previewDrag.y);
					this.syncOffsetInputs(frame); this.drawPreview();
				}

				onPreviewPointerUp(event) {
					if (this.previewDrag && event.pointerId === this.previewDrag.pointerId) this.endPreviewDrag();
				}

				endPreviewDrag() {
					this.previewDrag = null; delete this.previewCanvas.dataset.aligning;
				}

				drawPreview() {
					const { context, width, height } = this.sizeCanvas(this.previewCanvas); context.clearRect(0, 0, width, height);
					if (!this.frames.length || !this.image) { this.querySelector('[data-preview-count]').textContent = '0 / 0'; return; }
					const frame = this.frames[this.previewIndex % this.frames.length]; const buffer = this.createSceneCanvas(frame);
					const scale = Math.min((width - 18) / buffer.width, (height - 18) / buffer.height); const drawWidth = buffer.width * scale; const drawHeight = buffer.height * scale; const x = (width - drawWidth) / 2; const y = (height - drawHeight) / 2;
					this.previewView = { x, y, scale };
					context.imageSmoothingEnabled = false; context.drawImage(buffer, x, y, drawWidth, drawHeight);
					context.save(); context.strokeStyle = 'rgba(35,143,67,.42)'; context.lineWidth = 1; context.setLineDash([4, 4]); context.beginPath(); context.moveTo(width / 2, y); context.lineTo(width / 2, y + drawHeight); context.moveTo(x, height / 2); context.lineTo(x + drawWidth, height / 2); context.stroke(); context.restore();
					this.querySelector('[data-preview-count]').textContent = `${this.previewIndex + 1} / ${this.frames.length}`;
				}

				togglePlayback() { this.animationTimer ? this.stopPlayback() : this.startPlayback(); }
				startPlayback() {
					if (!this.frames.length) return; const fps = Math.max(1, Math.min(60, Number(this.querySelector('[data-fps]').value) || 12));
					this.querySelector('[data-play]').textContent = 'Pause'; this.animationTimer = window.setInterval(() => { this.previewIndex = (this.previewIndex + 1) % this.frames.length; this.drawPreview(); }, 1000 / fps);
				}
				stopPlayback(resetLabel = true) { if (this.animationTimer) window.clearInterval(this.animationTimer); this.animationTimer = null; if (resetLabel) this.querySelector('[data-play]').textContent = 'Play'; }

				async chooseFolder() {
					const status = this.querySelector('[data-save-status]');
					if (!('showDirectoryPicker' in window)) { status.textContent = 'Folder API unavailable. Save uses browser downloads.'; return null; }
					try { this.directoryHandle = await window.showDirectoryPicker({ mode: 'readwrite' }); status.textContent = `Folder: ${this.directoryHandle.name}`; return this.directoryHandle; }
					catch (error) { if (error?.name !== 'AbortError') status.textContent = `Folder error: ${error.message}`; return null; }
				}

				async frameBlob(frame) {
					const canvas = this.createSceneCanvas(frame);
					return new Promise((resolve, reject) => canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error('PNG export failed.')), 'image/png'));
				}

				async saveAll() {
					if (!this.frames.length) return;
					const status = this.querySelector('[data-save-status]'); const button = this.querySelector('[data-save]'); button.disabled = true;
					try {
						let directory = this.directoryHandle;
						if (!directory && 'showDirectoryPicker' in window) directory = await this.chooseFolder();
						for (let index = 0; index < this.frames.length; index += 1) {
							status.textContent = `Saving ${index + 1} of ${this.frames.length}...`; const blob = await this.frameBlob(this.frames[index]); const name = `frame-${String(index + 1).padStart(3, '0')}.png`;
							if (directory) { const file = await directory.getFileHandle(name, { create: true }); const writable = await file.createWritable(); await writable.write(blob); await writable.close(); }
							else { const url = URL.createObjectURL(blob); const link = document.createElement('a'); link.href = url; link.download = name; link.click(); window.setTimeout(() => URL.revokeObjectURL(url), 1000); await new Promise((resolve) => setTimeout(resolve, 140)); }
						}
						status.textContent = directory ? `${this.frames.length} PNG frames saved to ${directory.name}.` : `${this.frames.length} PNG downloads started.`;
					} catch (error) { status.textContent = error?.name === 'AbortError' ? 'Save cancelled.' : `Save failed: ${error.message}`; }
					finally { button.disabled = false; }
				}
			}

			customElements.define('sprite-extractor-app', SpriteExtractorApp);
		</script>
	</body>
</html>
