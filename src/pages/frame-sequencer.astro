---
import PipelineHeader from '../components/PipelineHeader.astro';

const pageTitle = 'Frame Sequencer · SpriteLab';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="description" content="Load, select, reorder, and play local animation frames." />
		<title>{pageTitle}</title>
		<style is:global>
			:root {
				font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				color: #171917;
				background: #f4f5f4;
				font-synthesis: none;
			}

			* { box-sizing: border-box; }
			[hidden] { display: none !important; }

			body {
				min-width: 320px;
				min-height: 100vh;
				margin: 0;
				background: #f4f5f4;
			}

			button,
			input { font: inherit; }

			button { cursor: pointer; }

			button:disabled {
				cursor: not-allowed;
				opacity: 0.45;
			}

			button:focus-visible,
			input:focus-visible,
			label:focus-within {
				outline: 2px solid #171917;
				outline-offset: 2px;
			}

			.utility-bar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				height: 52px;
				padding: 0 clamp(16px, 3vw, 40px);
				color: #f8faf8;
				background: #171917;
			}

			.brand {
				margin: 0;
				font-size: 0.875rem;
				font-weight: 680;
			}

			.local-status {
				display: flex;
				align-items: center;
				gap: 8px;
				font-size: 0.75rem;
				color: #bec4be;
			}

			.local-dot {
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: #52d273;
				box-shadow: 0 0 0 3px rgba(82, 210, 115, 0.14);
			}

			main {
				width: min(1240px, calc(100% - 32px));
				margin: clamp(24px, 5vw, 64px) auto;
			}

			.workbench {
				border: 1px solid #d9ddd9;
				border-radius: 8px;
				background: #ffffff;
				box-shadow: 0 16px 48px rgba(20, 24, 20, 0.07);
			}

			.section-head {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 20px;
			}

			h1,
			h2,
			p { margin-top: 0; }

			h1 {
				margin-bottom: 0;
				font-size: clamp(1.25rem, 2vw, 1.6rem);
				line-height: 1.2;
			}

			h2 {
				margin-bottom: 0;
				font-size: 0.95rem;
				line-height: 1.3;
			}

			.info-tip {
				position: relative;
				display: inline-grid;
				width: 17px;
				height: 17px;
				place-items: center;
				margin-left: 7px;
				padding: 0;
				border: 1px solid #c9cec9;
				border-radius: 999px;
				background: #fff;
				color: #7a817a;
				font-size: 0.6rem;
				font-weight: 800;
				line-height: 1;
				vertical-align: middle;
				cursor: help;
			}

			.info-tip-text {
				position: absolute;
				z-index: 60;
				bottom: calc(100% + 7px);
				left: 50%;
				width: max-content;
				max-width: 250px;
				padding: 8px 10px;
				border: 1px solid #d9ddd9;
				border-radius: 6px;
				background: #fff;
				color: #4d534d;
				font-size: 0.72rem;
				font-weight: 500;
				line-height: 1.5;
				text-align: left;
				text-transform: none;
				letter-spacing: 0;
				box-shadow: 0 10px 30px rgba(20, 24, 20, 0.14);
				opacity: 0;
				visibility: hidden;
				transform: translate(-50%, 4px);
				transition: opacity 140ms ease, transform 140ms ease, visibility 0s linear 140ms;
				pointer-events: none;
			}

			.info-tip:hover .info-tip-text,
			.info-tip:focus-visible .info-tip-text,
			.info-tip:focus .info-tip-text {
				opacity: 1;
				visibility: visible;
				transform: translate(-50%, 0);
				transition-delay: 0s;
			}

			.info-tip.tip-down .info-tip-text {
				bottom: auto;
				top: calc(100% + 7px);
			}

			.utility-button {
				min-height: 36px;
				padding: 0 13px;
				border: 1px solid #d9ddd9;
				border-radius: 6px;
				color: #363a36;
				background: #ffffff;
				font-size: 0.78rem;
				font-weight: 650;
			}

			.utility-button:hover:not(:disabled) { border-color: #8d948d; }

			.save-sequence-button {
				background: #171917;
				color: #fff;
				border-color: #171917;
			}

			.save-sequence-button:hover:not(:disabled) {
				background: #2c312c;
				border-color: #2c312c;
			}

			.panel {
				padding: 20px 26px 26px;
				border-bottom: 1px solid #e4e7e4;
			}

			.panel:last-child { border-bottom: 0; }

			.section-head {
				margin-bottom: 14px;
			}

			.section-actions {
				display: flex;
				gap: 8px;
				align-items: center;
			}

			.count {
				font-family: "SFMono-Regular", Consolas, monospace;
				font-size: 0.7rem;
				color: #6f756f;
				white-space: nowrap;
			}

			.version-picker {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				color: #6f756f;
				font-size: 0.72rem;
				font-weight: 650;
				white-space: nowrap;
			}

			.version-picker select {
				height: 30px;
				max-width: 200px;
				padding: 0 6px;
				border: 1px solid #d9ddd9;
				border-radius: 6px;
				background: #fff;
				color: #333933;
				font-size: 0.72rem;
			}

			.frame-grid {
				display: grid;
				grid-template-columns: repeat(5, minmax(0, 1fr));
				gap: 10px;
				align-content: start;
				min-height: 330px;
				max-height: 54vh;
				overflow: auto;
				padding: 2px 4px 2px 2px;
				scrollbar-gutter: stable;
			}

			.empty-state {
				display: grid;
				grid-column: 1 / -1;
				min-height: 326px;
				place-items: center;
				border: 1px solid #e1e4e1;
				background:
					linear-gradient(45deg, #f8f9f8 25%, transparent 25%),
					linear-gradient(-45deg, #f8f9f8 25%, transparent 25%),
					linear-gradient(45deg, transparent 75%, #f8f9f8 75%),
					linear-gradient(-45deg, transparent 75%, #f8f9f8 75%);
				background-position: 0 0, 0 10px, 10px -10px, -10px 0;
				background-size: 20px 20px;
				color: #747a74;
				text-align: center;
			}

			.empty-state strong {
				display: block;
				margin-bottom: 5px;
				color: #424742;
				font-size: 0.875rem;
			}

			.empty-state span { font-size: 0.78rem; }

			.source-frame,
			.sequence-frame {
				position: relative;
				min-width: 0;
				margin: 0;
				padding: 0;
				border: 1px solid #dfe3df;
				border-radius: 5px;
				overflow: hidden;
				color: #171917;
				background: #ffffff;
				text-align: left;
			}

			.source-frame {
				transition: border-color 130ms ease, box-shadow 130ms ease, background 130ms ease;
			}

			.source-frame:hover { border-color: #8d948d; }

			.source-frame[aria-pressed="true"] {
				border-color: #238f43;
				background: #f3fbf5;
				box-shadow: 0 0 0 2px rgba(35, 143, 67, 0.18);
			}

			.selection-check {
				position: absolute;
				top: 7px;
				right: 7px;
				display: none;
				min-width: 28px;
				height: 22px;
				padding: 0 6px;
				place-items: center;
				border-radius: 4px;
				color: #ffffff;
				background: #238f43;
				font-size: 0.72rem;
				font-weight: 800;
				box-shadow: 0 1px 4px rgba(0, 0, 0, 0.22);
			}

			.source-frame[aria-pressed="true"] .selection-check { display: grid; }

			.frame-image {
				display: block;
				width: 100%;
				object-fit: contain;
				background-color: #ffffff;
				background-image:
					linear-gradient(45deg, #e5e8e5 25%, transparent 25%),
					linear-gradient(-45deg, #e5e8e5 25%, transparent 25%),
					linear-gradient(45deg, transparent 75%, #e5e8e5 75%),
					linear-gradient(-45deg, transparent 75%, #e5e8e5 75%);
				background-position: 0 0, 0 8px, 8px -8px, -8px 0;
				background-size: 16px 16px;
			}

			.frame-image { aspect-ratio: 16 / 10; }

			.frame-caption {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 8px;
				padding: 7px 8px;
				border-top: 1px solid #e4e7e4;
				font-family: "SFMono-Regular", Consolas, monospace;
				font-size: 0.65rem;
				color: #626862;
			}

			.frame-file {
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			.sequence-layout {
				display: grid;
				grid-template-columns: minmax(0, 1.55fr) minmax(280px, 0.7fr);
				gap: 18px;
				align-items: start;
			}

			.sequence-grid {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 10px;
				align-content: start;
				min-height: 310px;
				max-height: 54vh;
				overflow: auto;
				padding: 2px 4px 2px 2px;
				scrollbar-gutter: stable;
			}

			.sequence-grid .empty-state { min-height: 306px; }

			.sequence-frame {
				cursor: grab;
				touch-action: none;
				user-select: none;
				transition: opacity 120ms ease, transform 120ms ease, border-color 120ms ease;
			}

			.sequence-frame:active { cursor: grabbing; }

			.sequence-frame[data-dragging="true"] {
				opacity: 0.4;
				transform: scale(0.98);
			}

			.sequence-frame[data-drop-target="true"] {
				border-color: #238f43;
				box-shadow: 0 0 0 2px rgba(35, 143, 67, 0.18);
			}

			.sequence-frame[data-current="true"] {
				border-color: #238f43;
				box-shadow: 0 0 0 2px rgba(35, 143, 67, 0.16);
			}

			.order-badge,
			.drag-handle,
			.remove-frame {
				position: absolute;
				top: 7px;
				z-index: 1;
				display: grid;
				height: 23px;
				place-items: center;
				border-radius: 4px;
				color: #ffffff;
				background: rgba(23, 25, 23, 0.84);
				font-family: "SFMono-Regular", Consolas, monospace;
				font-size: 0.65rem;
			}

			.order-badge {
				left: 7px;
				min-width: 26px;
				padding: 0 6px;
			}

			.drag-handle {
				right: 38px;
				width: 27px;
				font-weight: 800;
			}

			.remove-frame {
				right: 7px;
				width: 27px;
				padding: 0;
				border: 0;
				font-family: inherit;
				font-size: 0.82rem;
				font-weight: 760;
			}

			.remove-frame:hover { background: #a12828; }

			.preview-panel {
				position: sticky;
				top: 16px;
				border: 1px solid #dfe3df;
				border-radius: 6px;
				overflow: hidden;
				background: #ffffff;
			}

			.preview-stage {
				display: grid;
				position: relative;
				aspect-ratio: 1 / 1;
				place-items: center;
				isolation: isolate;
				overflow: hidden;
				touch-action: none;
				user-select: none;
				background-color: #ffffff;
				background-image:
					linear-gradient(45deg, #e5e8e5 25%, transparent 25%),
					linear-gradient(-45deg, #e5e8e5 25%, transparent 25%),
					linear-gradient(45deg, transparent 75%, #e5e8e5 75%),
					linear-gradient(-45deg, transparent 75%, #e5e8e5 75%);
				background-position: 0 0, 0 10px, 10px -10px, -10px 0;
				background-size: 20px 20px;
			}

			.preview-scene {
				position: relative;
				grid-area: 1 / 1;
				width: 100%;
				height: 100%;
				z-index: 1;
			}

			.sprite-layer {
				position: absolute;
				inset: 0;
				pointer-events: none;
				will-change: transform;
			}

			.sprite-box {
				position: absolute;
				left: 50%;
				top: 50%;
				transform: translate(-50%, -50%);
				transform-origin: center;
				will-change: transform;
			}

			.preview-image,
			.onion-image {
				display: block;
				width: 100%;
				height: 100%;
				background: transparent !important;
				object-fit: fill;
			}

			.preview-layer { z-index: 3; }

			.preview-image {
				pointer-events: auto;
				cursor: grab;
			}

			.preview-image:active { cursor: grabbing; }

			.onion-layer {
				z-index: 1;
				opacity: 0.24;
			}

			.onion-previous {
				filter: sepia(1) saturate(7) hue-rotate(305deg);
			}

			.onion-next {
				filter: sepia(1) saturate(7) hue-rotate(75deg);
			}

			.scene-ground {
				position: absolute;
				inset: auto 0 0;
				z-index: 2;
				border-top: 1px dashed rgba(35, 143, 67, 0.55);
				pointer-events: none;
			}

			.rotate-handle {
				position: absolute;
				left: 50%;
				top: -30px;
				z-index: 4;
				display: grid;
				width: 18px;
				height: 18px;
				place-items: center;
				border: 2px solid #ffffff;
				border-radius: 50%;
				color: #ffffff;
				background: #238f43;
				box-shadow: 0 1px 4px rgba(23, 25, 23, 0.35);
				cursor: grab;
				pointer-events: auto;
				transform: translateX(-50%);
			}

			.rotate-handle::after {
				position: absolute;
				top: 16px;
				left: 50%;
				width: 1px;
				height: 10px;
				content: "";
				background: #238f43;
			}

			.resize-outline { position: absolute; inset: 0; z-index: 3; border: 1px solid #238f43; pointer-events: none; }
			.resize-handle { position: absolute; z-index: 5; width: 10px; height: 10px; border: 1px solid #fff; background: #238f43; box-shadow: 0 1px 3px rgba(23,25,23,.35); pointer-events: auto; }
			.resize-handle[data-resize-handle="nw"] { left: 0; top: 0; cursor: nwse-resize; transform: translate(-50%,-50%); }
			.resize-handle[data-resize-handle="n"] { left: 50%; top: 0; cursor: ns-resize; transform: translate(-50%,-50%); }
			.resize-handle[data-resize-handle="ne"] { right: 0; top: 0; cursor: nesw-resize; transform: translate(50%,-50%); }
			.resize-handle[data-resize-handle="e"] { right: 0; top: 50%; cursor: ew-resize; transform: translate(50%,-50%); }
			.resize-handle[data-resize-handle="se"] { right: 0; bottom: 0; cursor: nwse-resize; transform: translate(50%,50%); }
			.resize-handle[data-resize-handle="s"] { left: 50%; bottom: 0; cursor: ns-resize; transform: translate(-50%,50%); }
			.resize-handle[data-resize-handle="sw"] { left: 0; bottom: 0; cursor: nesw-resize; transform: translate(-50%,50%); }
			.resize-handle[data-resize-handle="w"] { left: 0; top: 50%; cursor: ew-resize; transform: translate(-50%,-50%); }
			.preview-panel[data-playing] .resize-outline,
			.preview-panel[data-playing] .resize-handle,
			.preview-panel[data-playing] .rotate-handle { display: none; }
			.preview-panel[data-playing] .preview-image { cursor: default; pointer-events: none; }

			.preview-empty {
				position: relative;
				z-index: 5;
				padding: 30px;
				font-size: 0.78rem;
				line-height: 1.5;
				color: #747a74;
				text-align: center;
			}

			.playback {
				padding: 14px;
				border-top: 1px solid #dfe3df;
			}

			.scene-edit-meta {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 10px;
				margin-bottom: 11px;
				font-size: 0.66rem;
				line-height: 1.4;
				color: #687068;
			}

			.transform-status {
				flex: 0 0 auto;
				font-family: "SFMono-Regular", Consolas, monospace;
				color: #3d433d;
			}

			.progress-track {
				height: 5px;
				overflow: hidden;
				border-radius: 5px;
				background: #e3e7e3;
			}

			.progress-fill {
				width: 0;
				height: 100%;
				background: #2db653;
				transition: width 80ms linear;
			}

			.playback-controls {
				display: flex;
				align-items: center;
				gap: 7px;
				margin-top: 12px;
			}

			.play-button,
			.step-button {
				height: 36px;
				border-radius: 5px;
				font-size: 0.75rem;
				font-weight: 680;
			}

			.play-button {
				min-width: 62px;
				border: 1px solid #21853d;
				color: #ffffff;
				background: #238f43;
			}

			.step-button {
				min-width: 48px;
				border: 1px solid #d9ddd9;
				color: #363a36;
				background: #ffffff;
			}

			.fps-control {
				display: flex;
				align-items: center;
				gap: 6px;
				margin-left: auto;
				font-size: 0.7rem;
				font-weight: 650;
				color: #656b65;
			}

			.fps-input {
				width: 52px;
				height: 36px;
				padding: 0 7px;
				border: 1px solid #cfd4cf;
				border-radius: 5px;
			}

			.nudge-control {
				display: flex;
				align-items: center;
				gap: 6px;
				font-size: 0.7rem;
				font-weight: 650;
				color: #656b65;
			}

			.nudge-input {
				width: 46px;
				height: 36px;
				padding: 0 7px;
				border: 1px solid #cfd4cf;
				border-radius: 5px;
			}

			.fullscreen-button {
				flex: 0 0 auto;
				height: 26px;
				padding: 0 9px;
				border: 1px solid #d9ddd9;
				border-radius: 5px;
				background: #fff;
				color: #3d433d;
				font-size: 0.68rem;
				font-weight: 680;
				cursor: pointer;
			}

			.fullscreen-button:hover {
				border-color: #8d948d;
			}

			.fullscreen-row {
				flex: 1 1 0;
				height: 30px;
			}

			.fullscreen-actions { display: flex; gap: 8px; width: 100%; margin-top: 10px; }
			.fullscreen-delete { display: none; color: #b42318; border-color: #e8b4af; }
			.preview-panel:fullscreen .fullscreen-delete { display: block; }
			.preview-panel:fullscreen .fullscreen-delete:hover:not(:disabled) { color: #fff; background: #b42318; border-color: #b42318; }

			.bg-control {
				display: inline-flex;
				align-items: center;
				gap: 6px;
				font-size: 0.66rem;
				font-weight: 650;
				color: #687068;
			}

			.bg-control select {
				max-width: 150px;
				height: 24px;
				padding: 0 4px;
				border: 1px solid #d9ddd9;
				border-radius: 5px;
				background: #fff;
				color: #3d433d;
				font-size: 0.66rem;
			}

			.preview-panel:fullscreen {
				position: static;
				display: grid;
				grid-template-rows: minmax(0, 1fr) auto;
				width: 100vw;
				height: 100vh;
				max-width: 100vw;
				max-height: 100vh;
				padding: 18px;
				border: 0;
				border-radius: 0;
				box-sizing: border-box;
				background: #171917;
			}

			.preview-panel:fullscreen .preview-stage {
				aspect-ratio: auto;
				width: 100%;
				height: 100%;
				min-height: 0;
				background-color: #1d211d;
			}

			.preview-panel:fullscreen .playback {
				border-top: 1px solid #333833;
			}

			.preview-panel:fullscreen .scene-edit-meta,
			.preview-panel:fullscreen .transform-status,
			.preview-panel:fullscreen .playback-meta,
			.preview-panel:fullscreen .fps-control,
			.preview-panel:fullscreen .nudge-control,
			.preview-panel:fullscreen .bg-control,
			.preview-panel:fullscreen .onion-control,
			.preview-panel:fullscreen .loop-control {
				color: #cfd4cf;
			}

			.playback-meta {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 10px;
				margin-top: 11px;
				font-family: "SFMono-Regular", Consolas, monospace;
				font-size: 0.67rem;
				color: #686e68;
			}

			.loop-control {
				display: flex;
				align-items: center;
				gap: 6px;
				font-family: inherit;
				font-size: 0.72rem;
				font-weight: 650;
			}

			.onion-control {
				display: flex;
				align-items: center;
				gap: 6px;
				font-family: inherit;
				font-size: 0.72rem;
				font-weight: 650;
				color: #3d433d;
			}

			.onion-mode {
				display: inline-flex;
				align-items: center;
			}

			.onion-mode select {
				height: 24px;
				padding: 0 4px;
				border: 1px solid #d9ddd9;
				border-radius: 5px;
				background: #fff;
				color: #3d433d;
				font-size: 0.68rem;
			}

			.onion-key {
				display: inline-flex;
				align-items: center;
				gap: 4px;
				margin-left: auto;
				font-family: "SFMono-Regular", Consolas, monospace;
				font-size: 0.62rem;
				color: #767c76;
			}

			.onion-dot {
				width: 7px;
				height: 7px;
				border-radius: 50%;
			}

			.onion-dot.previous { background: #dc5b72; }
			.onion-dot.next { background: #2db653; }

			@media (max-width: 980px) {
				.frame-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
				.sequence-layout { grid-template-columns: 1fr; }
				.preview-panel { position: static; }
				.preview-stage { aspect-ratio: 16 / 9; }
			}

			@media (max-width: 640px) {
				main {
					width: min(100% - 20px, 1240px);
					margin: 10px auto 24px;
				}

				.utility-bar { padding: 0 14px; }
				.panel { padding-left: 15px; padding-right: 15px; }
				.section-head { align-items: flex-start; flex-direction: column; }
				.section-actions { width: 100%; flex-wrap: wrap; }
				.utility-button { flex: 1 1 120px; }
				.frame-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); min-height: 300px; }
				.sequence-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); min-height: 280px; }
				.empty-state { min-height: 296px; padding: 24px; }
				.sequence-grid .empty-state { min-height: 276px; }
				.playback-controls { flex-wrap: wrap; }
				.fps-control { margin-left: 0; }
				.onion-key { width: 100%; margin-left: 0; }
				.scene-edit-meta { align-items: flex-start; flex-direction: column; }
			}

			@media (prefers-reduced-motion: reduce) {
				* { transition-duration: 0.001ms !important; }
			}

		</style>
	</head>
	<body>
		<PipelineHeader active="sequence" />

		<main>
			<frame-sequencer-app class="workbench">
				<section class="panel" aria-labelledby="folder-frames-heading">
					<div class="section-head">
						<div>
							<h2 id="folder-frames-heading">Folder frames <button class="info-tip" type="button" aria-label="Click frames to add or remove them from the animation sequence."><span aria-hidden="true">i</span><span class="info-tip-text" role="tooltip">Click frames to add or remove them from the animation sequence.</span></button></h2>
						</div>
						<div class="section-actions">
							<label class="version-picker" data-version-picker hidden>
								<span>Version</span>
								<select data-version-select aria-label="Choose saved version"></select>
							</label>
							<span data-source-count class="count">0 frames</span>
							<button data-select-all class="utility-button" type="button" disabled>Select all</button>
							<button data-clear-selection class="utility-button" type="button" disabled>Clear selection</button>
						</div>
					</div>
					<div data-source-grid class="frame-grid">
						<div class="empty-state"><p><strong>No frames loaded</strong><span>Frames auto-load from the selected version folder once connected in settings.</span></p></div>
					</div>
				</section>

				<section class="panel" aria-labelledby="sequence-heading">
					<div class="section-head">
						<div>
							<h2 id="sequence-heading">Animation sequence <button class="info-tip" type="button" aria-label="Drag selected frames to reorder them, then play the sequence."><span aria-hidden="true">i</span><span class="info-tip-text" role="tooltip">Drag selected frames to reorder them, then play the sequence.</span></button></h2>
						</div>
						<div class="section-actions">
							<span data-selected-count class="count">0 selected</span>
							<button data-duplicate-frame class="utility-button" type="button" disabled>Duplicate frame</button>
							<button data-save-sequence class="utility-button save-sequence-button" type="button" disabled>Save Sequence</button>
						</div>
					</div>

					<div class="sequence-layout">
						<div data-sequence-grid class="sequence-grid">
							<div class="empty-state"><p><strong>No selected frames</strong><span>Selected folder frames appear here in animation order.</span></p></div>
						</div>

						<aside class="preview-panel" data-preview-panel aria-label="Animation preview">
							<div data-preview-stage class="preview-stage">
								<p data-preview-empty class="preview-empty">Select at least one frame to preview the animation.</p>
								<div data-preview-scene class="preview-scene" hidden>
									<div class="scene-ground" aria-hidden="true"></div>
									<div data-onion-previous-layer class="sprite-layer onion-layer">
										<div class="sprite-box"><img data-onion-previous class="onion-image onion-previous" alt="Previous onion-skin frame" /></div>
									</div>
									<div data-onion-next-layer class="sprite-layer onion-layer">
										<div class="sprite-box"><img data-onion-next class="onion-image onion-next" alt="Next onion-skin frame" /></div>
									</div>
									<div data-preview-layer class="sprite-layer preview-layer">
										<div class="sprite-box">
											<img data-preview-image class="preview-image" alt="Current animation frame" draggable="false" />
											<span class="resize-outline" aria-hidden="true"></span>
											<span class="resize-handle" data-resize-handle="nw" title="Resize top-left"></span><span class="resize-handle" data-resize-handle="n" title="Resize height"></span><span class="resize-handle" data-resize-handle="ne" title="Resize top-right"></span><span class="resize-handle" data-resize-handle="e" title="Resize width"></span><span class="resize-handle" data-resize-handle="se" title="Resize bottom-right"></span><span class="resize-handle" data-resize-handle="s" title="Resize height"></span><span class="resize-handle" data-resize-handle="sw" title="Resize bottom-left"></span><span class="resize-handle" data-resize-handle="w" title="Resize width"></span>
											<span data-rotate-handle class="rotate-handle" title="Drag to rotate" aria-label="Drag to rotate current sprite"></span>
										</div>
									</div>
								</div>
							</div>
							<div class="playback">
				<div class="scene-edit-meta">
					<button class="info-tip" type="button" aria-label="Drag sprite to move; rectangle handles resize; green handle rotates. Hold Shift while resizing to keep aspect ratio, or for precise move and rotate. Arrow keys nudge. Q/E switch frames. W plays/pauses. Ctrl+Z undoes. Double-click resets."><span aria-hidden="true">i</span><span class="info-tip-text" role="tooltip">Rectangle handles resize. Hold Shift to keep aspect ratio; Shift gives precision while moving or rotating. Arrow keys nudge. Q/E switch frames. W plays/pauses. Ctrl+Z undoes. Double-click resets.</span></button>
					<span data-transform-status class="transform-status">X 0% / Y 0% / 100% x 100% / 0deg</span>
					<label class="bg-control">BG
						<select data-canvas-background aria-label="Canvas background">
							<option value="">Checker</option>
						</select>
					</label>
				</div>
								<div class="progress-track" aria-hidden="true"><div data-progress class="progress-fill"></div></div>
								<div class="playback-controls">
									<button data-prev class="step-button" type="button" disabled>Prev</button>
									<button data-play class="play-button" type="button" disabled>Play</button>
									<button data-next class="step-button" type="button" disabled>Next</button>
									<label class="fps-control">FPS <input data-fps class="fps-input" type="number" min="1" max="60" step="1" value="8" inputmode="numeric" /></label>
									<label class="nudge-control">Nudge <input data-nudge-scale class="nudge-input" type="number" min="0.5" max="5" step="0.1" value="1" aria-label="Arrow key nudge scale" /></label>
								</div>
								<div class="playback-meta">
									<span data-frame-status>Frame 0 / 0</span>
									<label class="onion-control"><input data-onion-skin type="checkbox" checked /> Onion skin</label>
									<label class="onion-mode">
										<select data-onion-mode aria-label="Onion skin direction">
											<option value="both">Both</option>
											<option value="prev" selected>Prev only</option>
											<option value="next">Next only</option>
										</select>
									</label>
									<label class="loop-control"><input data-loop type="checkbox" checked /> Loop</label>
								</div>
								<div class="onion-key" aria-hidden="true">
									<span class="onion-dot previous"></span> Previous
									<span class="onion-dot next"></span> Next
								</div>
								<div class="fullscreen-actions">
									<button data-delete-current class="fullscreen-button fullscreen-row fullscreen-delete" type="button" disabled>Delete current frame</button>
									<button data-fullscreen-preview class="fullscreen-button fullscreen-row" type="button">Fullscreen (F)</button>
								</div>
							</div>
						</aside>
					</div>
				</section>
			</frame-sequencer-app>
		</main>

		<script>
			class FrameSequencerApp extends HTMLElement {
				frames = [];
				selectedIds = [];
				currentIndex = 0;
				animationTimer = 0;
				draggedId = '';
				pointerId = null;
				pointerStart = null;
				pointerMoved = false;
				suppressSequenceClick = false;
				sceneGesture = null;
				transformUndoStack = [];
				keyboardNudge = null;
				workspaceReady = false;
				workspaceSaveTimer = 0;
				previewLayoutFrame = 0;
				fpsTouched = false;
				directoryHandle = null;
				versionHandle = null;
				versionFolders = [];
				versionPicker = null;
				versionSelect = null;
				canvasBackgrounds = [];
				canvasBackgroundUrl = '';
				canvasBackgroundSelect = null;

				connectedCallback() {
					this.sourceLabel = '';
					this.sourceGrid = this.querySelector('[data-source-grid]');
					this.sequenceGrid = this.querySelector('[data-sequence-grid]');
					this.sourceCount = this.querySelector('[data-source-count]');
					this.selectedCount = this.querySelector('[data-selected-count]');
					this.selectAllButton = this.querySelector('[data-select-all]');
					this.clearSelectionButton = this.querySelector('[data-clear-selection]');
					this.duplicateFrameButton = this.querySelector('[data-duplicate-frame]');
					this.previewStage = this.querySelector('[data-preview-stage]');
					this.previewScene = this.querySelector('[data-preview-scene]');
					this.previewLayer = this.querySelector('[data-preview-layer]');
					this.onionPreviousLayer = this.querySelector('[data-onion-previous-layer]');
					this.onionNextLayer = this.querySelector('[data-onion-next-layer]');
					this.previewImage = this.querySelector('[data-preview-image]');
					this.onionPreviousImage = this.querySelector('[data-onion-previous]');
					this.onionNextImage = this.querySelector('[data-onion-next]');
					this.previewEmpty = this.querySelector('[data-preview-empty]');
					this.playButton = this.querySelector('[data-play]');
					this.prevButton = this.querySelector('[data-prev]');
					this.nextButton = this.querySelector('[data-next]');
					this.fpsInput = this.querySelector('[data-fps]');
					this.loopInput = this.querySelector('[data-loop]');
					this.onionSkinInput = this.querySelector('[data-onion-skin]');
					this.onionModeInput = this.querySelector('[data-onion-mode]');
					this.nudgeScaleInput = this.querySelector('[data-nudge-scale]');
					this.previewPanel = this.querySelector('[data-preview-panel]');
					this.fullscreenButton = this.querySelector('[data-fullscreen-preview]');
					this.deleteCurrentButton = this.querySelector('[data-delete-current]');
					this.canvasBackgroundSelect = this.querySelector('[data-canvas-background]');
					this.frameStatus = this.querySelector('[data-frame-status]');
					this.progress = this.querySelector('[data-progress]');
					this.transformStatus = this.querySelector('[data-transform-status]');
					this.exportStatus = this.transformStatus;
					this.saveSequenceButton = this.querySelector('[data-save-sequence]');
					this.versionPicker = this.querySelector('[data-version-picker]');
					this.versionSelect = this.querySelector('[data-version-select]');
					this.versionSelect?.addEventListener('change', () => void this.loadVersion(this.versionSelect.value));
					this.saveSequenceButton?.addEventListener('click', () => void this.saveSequence());

					this.sourceGrid?.addEventListener('click', (event) => {
						const button = event.target instanceof Element ? event.target.closest('[data-source-id]') : null;
						if (button instanceof HTMLButtonElement) this.toggleSelection(button.dataset.sourceId || '');
					});

					this.selectAllButton?.addEventListener('click', () => {
						this.stopPlayback();
						this.selectedIds = this.getSourceFrames().map((frame) => frame.id);
						this.currentIndex = 0;
						this.render();
					});

					this.clearSelectionButton?.addEventListener('click', () => {
						this.stopPlayback();
						this.selectedIds = [];
						this.frames = this.frames.filter((frame) => !frame.isSequenceDuplicate);
						this.currentIndex = 0;
						this.render();
					});

					this.duplicateFrameButton?.addEventListener('click', () => this.duplicateCurrentFrame());
					this.playButton?.addEventListener('click', () => this.togglePlayback());
					this.prevButton?.addEventListener('click', () => this.step(-1));
					this.nextButton?.addEventListener('click', () => this.step(1));
					this.onionSkinInput?.addEventListener('change', () => this.updatePreview());
					this.onionSkinInput?.addEventListener('change', () => this.scheduleWorkspaceSave());
					this.onionModeInput?.addEventListener('change', () => this.updatePreview());
					this.onionModeInput?.addEventListener('change', () => this.scheduleWorkspaceSave());
					this.loopInput?.addEventListener('change', () => {
						this.updatePreview();
						this.scheduleWorkspaceSave();
					});
					this.fpsInput?.addEventListener('change', () => {
						this.fpsTouched = true;
						this.fpsInput.value = String(this.getFps());
						if (this.animationTimer) this.startPlayback();
						this.scheduleWorkspaceSave();
					});

					this.sequenceGrid?.addEventListener('click', (event) => {
						if (this.suppressSequenceClick) {
							this.suppressSequenceClick = false;
							return;
						}
						const removeButton = event.target instanceof Element ? event.target.closest('[data-remove-id]') : null;
						if (removeButton instanceof HTMLButtonElement) {
							this.removeSelectedFrame(removeButton.dataset.removeId || '');
							return;
						}
						const frame = event.target instanceof Element ? event.target.closest('[data-sequence-id]') : null;
						if (!(frame instanceof HTMLElement)) return;
						const index = this.selectedIds.indexOf(frame.dataset.sequenceId || '');
						if (index >= 0) {
							this.stopPlayback();
							this.currentIndex = index;
							this.updatePreview();
							this.scheduleWorkspaceSave();
						}
					});

					this.sequenceGrid?.addEventListener('pointerdown', (event) => this.onPointerDown(event));
					this.sequenceGrid?.addEventListener('pointermove', (event) => this.onPointerMove(event));
					this.sequenceGrid?.addEventListener('pointerup', (event) => this.onPointerUp(event));
					this.sequenceGrid?.addEventListener('pointercancel', () => this.clearDragState());
					this.previewScene?.addEventListener('pointerdown', (event) => this.onScenePointerDown(event));
					this.previewScene?.addEventListener('pointermove', (event) => this.onScenePointerMove(event));
					this.previewScene?.addEventListener('pointerup', (event) => this.onScenePointerUp(event));
					this.previewScene?.addEventListener('pointercancel', () => this.finishSceneGesture());
					this.previewImage?.addEventListener('dblclick', (event) => this.resetCurrentTransform(event));
					window.addEventListener('keydown', (event) => this.onTransformKeyDown(event));
					window.addEventListener('keyup', (event) => this.onTransformKeyUp(event));
					window.addEventListener('resize', () => this.schedulePreviewLayout());
					window.addEventListener('pagehide', () => void this.persistWorkspaceState());
					this.fullscreenButton?.addEventListener('click', () => void this.toggleFullscreen());
					this.deleteCurrentButton?.addEventListener('click', () => this.deleteCurrentFrame());
					this.nudgeScaleInput?.addEventListener('change', () => this.scheduleWorkspaceSave());
					this.canvasBackgroundSelect?.addEventListener('change', () => this.applyCanvasBackground(this.canvasBackgroundSelect.value));
					document.addEventListener('fullscreenchange', () => {
						if (this.fullscreenButton) {
							this.fullscreenButton.textContent = document.fullscreenElement === this.previewPanel ? 'Exit Fullscreen (F)' : 'Fullscreen (F)';
						}
						this.schedulePreviewLayout();
					});
					void this.restoreProjectData();
					void this.loadCanvasBackgrounds();

				}

				async restoreFramesDirectory() {
					try {
						if ('showDirectoryPicker' in window) {
							const directory = await this.getStoredDirectoryHandle();
							if (directory) {
								this.directoryHandle = directory;
								this.sourceLabel = directory.name;
								const permission = await this.ensureDirectoryPermission(directory, false);
								if (permission === 'granted') {
									await this.loadDirectoryHandle(directory);
									return;
								}
								this.sourceLabel = `${directory.name} (reconnect from settings)`;
								return;
							}
						}
						const files = await this.getStoredValue('sequencer-files');
						if (files?.length) await this.loadFiles(files);
					} catch {
						this.sourceLabel = 'No frames folder';
					}
				}

				async getRootFolderHandle() {
					try {
						const database = await this.openHandleDatabase();
						const handle = await new Promise((resolve, reject) => {
							const request = database.transaction('handles').objectStore('handles').get('spriteanim-root-handle');
							request.onsuccess = () => resolve(request.result || null);
							request.onerror = () => reject(request.error);
						});
						database.close();
						return handle;
					} catch {
						return null;
					}
				}

				async getAnimationRootFolderHandle() {
					const root = await this.getRootFolderHandle();
					return root ? root.getDirectoryHandle('anim-projects', { create: true }) : null;
				}

				async restoreProjectData() {
					try {
						const project = window.SpriteAnimProject?.getActiveProject?.();
						const activeCycle = window.SpriteAnimProject?.getActiveCycle?.();
						if (!project || !('showDirectoryPicker' in window)) {
							await this.restoreFramesDirectory();
							return;
						}
						const root = await this.getAnimationRootFolderHandle();
						const rootGranted = root && (await this.ensureDirectoryPermission(root, false)) === 'granted';
						if (!rootGranted) {
							await this.restoreFramesDirectory();
							return;
						}
						let projectHandle;
						try {
							projectHandle = await root.getDirectoryHandle(project);
						} catch {
							await this.restoreFramesDirectory();
							return;
						}
						const cycles = [];
						for await (const entry of projectHandle.values()) {
							if (entry.kind === 'directory') cycles.push(entry);
						}
						cycles.sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true, sensitivity: 'base' }));
						if (!cycles.length) {
							await this.restoreFramesDirectory();
							return;
						}
						const selected = cycles.find((cycle) => cycle.name === activeCycle) || cycles[0];
						this.directoryHandle = selected;
						this.sourceLabel = selected.name;
						let editTarget = null;
						try { editTarget = JSON.parse(localStorage.getItem('spriteanim-edit-stage3-sequence') || 'null'); } catch {}
						if (editTarget?.project === project && editTarget?.cycle === selected.name) {
							const stage3 = await this.findSubdirectory(selected, 'stage3 - pivoted frames');
							if (stage3) {
								let source = stage3;
								if (editTarget.sequence) source = await stage3.getDirectoryHandle(editTarget.sequence);
								localStorage.removeItem('spriteanim-edit-stage3-sequence');
								this.versionFolders = [source];
								this.versionHandle = source;
								this.renderVersionPicker([], null);
								await this.loadDirectoryHandle(selected, source, true, !editTarget.sequence);
								return;
							}
						}
						const stage2 = await this.findSubdirectory(selected, 'stage2 - unpivoted frames');
						const versions = await this.listVersionFolders(stage2 || selected);
						this.versionFolders = versions;
						const storedVersion = localStorage.getItem('spriteanim-version:' + selected.name);
						let versionHandle = null;
						// Auto-select the latest timestamped version folder when one exists.
						const newest = versions.find((version) => /^\d{2}-\d{2}-\d{4} \d{2}-\d{2}-\d{2}/.test(version.name)) || null;
						if (newest) {
							versionHandle = newest;
							localStorage.setItem('spriteanim-version:' + selected.name, newest.name);
						} else {
							if (storedVersion) {
								versionHandle = versions.find((version) => version.name === storedVersion) || null;
							}
							if (!versionHandle) {
								const stage3 = await this.findSubdirectory(selected, 'stage3 - pivoted frames');
								versionHandle = stage3 || versions[0] || null;
							}
						}
						this.versionHandle = versionHandle;
						this.renderVersionPicker(versions, versionHandle);
						await this.loadDirectoryHandle(selected, versionHandle);
					} catch {
						await this.restoreFramesDirectory();
					}
				}

				async loadDirectoryHandle(directory, versionFolder, selectAll = false, shallow = false) {
					this.workspaceReady = false;
					this.transformUndoStack = [];
					this.keyboardNudge = null;
					this.clearFrameUrls();
					const entries = [];
					let source = versionFolder || null;
					if (!source) {
						source = await this.findSubdirectory(directory, 'stage3 - pivoted frames') || directory;
					}
					await this.collectDirectoryImages(source, '', entries, !shallow);
					entries.sort((a, b) => this.naturalCompare(a.path, b.path));
					this.frames = entries.map((entry, index) => ({
						id: `frame-${index}-${entry.file.name}`,
						name: entry.file.name,
						path: entry.path,
						sourcePath: entry.path,
						url: URL.createObjectURL(entry.file),
					}));
					await this.restoreWorkspaceState(directory.name);
					if (selectAll) {
						this.selectedIds = this.getSourceFrames().map((frame) => frame.id);
						this.currentIndex = 0;
					}
					this.stopPlayback();
					this.sourceLabel = source.name;
					this.workspaceReady = this.frames.length > 0;
					this.render();
				}

				async listVersionFolders(directory) {
					const timestampRe = /^\d{2}-\d{2}-\d{4} \d{2}-\d{2}-\d{2}( \(\d+\))?$/;
					const all = [];
					for await (const entry of directory.values()) {
						if (entry.kind !== 'directory') continue;
						if (entry.name.startsWith('.') || entry.name.startsWith('_')) continue;
						all.push(entry);
					}
					const stamped = all
						.filter((entry) => timestampRe.test(entry.name))
						.sort((a, b) => b.name.localeCompare(a.name, undefined, { numeric: true, sensitivity: 'base' }));
					const others = all
						.filter((entry) => !timestampRe.test(entry.name))
						.sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true, sensitivity: 'base' }));
					return stamped.concat(others);
				}

				renderVersionPicker(versions, selected) {
					if (!this.versionPicker || !this.versionSelect) return;
					if (!versions.length) {
						this.versionPicker.hidden = true;
						this.versionSelect.replaceChildren();
						return;
					}
					this.versionPicker.hidden = versions.length <= 1;
					this.versionSelect.replaceChildren(...versions.map((version) => {
						const option = document.createElement('option');
						option.value = version.name;
						option.textContent = version.name;
						return option;
					}));
					this.versionSelect.value = selected?.name || versions[0].name;
				}

				async loadVersion(name) {
					const version = this.versionFolders.find((item) => item.name === name);
					if (!version) return;
					this.versionHandle = version;
					if (this.directoryHandle) localStorage.setItem('spriteanim-version:' + this.directoryHandle.name, name);
					await this.loadDirectoryHandle(this.directoryHandle, version);
				}

				async saveSequence() {
					const frames = this.getSelectedFrames();
					if (!frames.length) return;
					const status = this.exportStatus || this.transformStatus;
					const button = this.saveSequenceButton;
					if (button) button.disabled = true;
					try {
						const root = await this.getAnimationRootFolderHandle();
						const project = window.SpriteAnimProject?.getActiveProject?.();
						if (!root || !project || !this.directoryHandle) {
							if (status) status.textContent = 'Connect the project folder in settings first.';
							return;
						}
						const projectHandle = await root.getDirectoryHandle(project);
						let stage3 = this.directoryHandle;
						try {
							stage3 = await this.directoryHandle.getDirectoryHandle('stage3 - pivoted frames', { create: true });
						} catch {}
						const writeOpts = { mode: 'readwrite' };
						let wp = await stage3.queryPermission(writeOpts);
						if (wp !== 'granted') wp = await stage3.requestPermission(writeOpts);
						if (wp !== 'granted') {
							if (status) status.textContent = 'Write access needed to save frames.';
							return;
						}
						const now = new Date();
						const pad = (value) => String(value).padStart(2, '0');
						const base = `${pad(now.getDate())}-${pad(now.getMonth() + 1)}-${now.getFullYear()} ${pad(now.getHours())}-${pad(now.getMinutes())}-${pad(now.getSeconds())}`;
						let name = base;
						let counter = 2;
						for (;;) {
							try {
								await stage3.getDirectoryHandle(name);
								name = `${base} (${counter})`;
								counter += 1;
							} catch {
								break;
							}
						}
						const versionDirectory = await stage3.getDirectoryHandle(name, { create: true });
						const cycleName = (this.directoryHandle.name || 'animation')
							.toLowerCase()
							.replace(/[^a-z0-9]+/g, '-')
							.replace(/^-+|-+$/g, '') || 'animation';
						const preparedFrames = await Promise.all(frames.map(async (frame) => {
							const image = await this.loadFrameImage(frame.url);
							this.measureFrameBounds(frame, image);
							return { frame, image };
						}));
						const scene = {
							width: Math.max(...preparedFrames.map(({ frame }) => frame.width)),
							height: Math.max(...preparedFrames.map(({ frame }) => frame.height)),
						};
						const savedFrames = [];
						for (let index = 0; index < preparedFrames.length; index += 1) {
							const { frame, image } = preparedFrames[index];
							const blob = await this.renderTransformedFrame(frame, image, scene);
							const fileName = `${cycleName}-${String(index + 1).padStart(3, '0')}.png`;
							const file = await versionDirectory.getFileHandle(fileName, { create: true });
							const writable = await file.createWritable();
							await writable.write(blob);
							await writable.close();
							savedFrames.push({
								index: index + 1,
								outputFile: fileName,
								sourceName: frame.name,
								sourcePath: frame.sourcePath || frame.path || frame.name,
								sourceFrameId: frame.id,
								isDuplicate: Boolean(frame.isSequenceDuplicate),
								transform: this.normalizeTransform(frame.transform),
								sourceDimensions: { width: frame.sourceWidth, height: frame.sourceHeight },
								contentBounds: { ...frame.contentBounds },
								outputDimensions: { width: scene.width, height: scene.height },
								fileSizeBytes: blob.size,
							});
							if (status) status.textContent = `Saving ${fileName}...`;
						}
						const fps = this.getFps();
						const manifest = {
							schemaVersion: 1,
							savedAt: now.toISOString(),
							project,
							animationCycle: this.directoryHandle.name,
							versionFolder: name,
							stage: 'stage3 - pivoted frames',
							format: 'image/png',
							fps,
							frameCount: savedFrames.length,
							durationSeconds: savedFrames.length / fps,
							frameDurationMilliseconds: 1000 / fps,
							canvas: { width: scene.width, height: scene.height, transparent: true },
							playback: {
								loop: Boolean(this.loopInput?.checked),
								onionSkinEnabledWhileEditing: Boolean(this.onionSkinInput?.checked),
								onionSkinMode: this.onionModeInput?.value || 'prev',
							},
							frames: savedFrames,
						};
						const manifestFile = await versionDirectory.getFileHandle('sequence.json', { create: true });
						const manifestWritable = await manifestFile.createWritable();
						await manifestWritable.write(JSON.stringify(manifest, null, 2));
						await manifestWritable.close();
						if (status) status.textContent = `${frames.length} frames + sequence.json saved to ${this.directoryHandle.name}/stage3 - pivoted frames/${name}`;
					} catch (error) {
						if (status) status.textContent = error?.name === 'AbortError' ? 'Save cancelled.' : `Save failed: ${error.message}`;
					} finally {
						if (button) button.disabled = false;
					}
				}

				loadFrameImage(url) {
					return new Promise((resolve, reject) => {
						const image = new Image();
						image.onload = () => resolve(image);
						image.onerror = () => reject(new Error('Could not load a selected frame for saving.'));
						image.src = url;
					});
				}

				measureFrameBounds(frame, image) {
					const sourceWidth = image.naturalWidth || 1;
					const sourceHeight = image.naturalHeight || 1;
					const canvas = document.createElement('canvas');
					canvas.width = sourceWidth;
					canvas.height = sourceHeight;
					const context = canvas.getContext('2d', { willReadFrequently: true });
					let bounds = { x: 0, y: 0, width: sourceWidth, height: sourceHeight };
					try {
						context.drawImage(image, 0, 0);
						const pixels = context.getImageData(0, 0, sourceWidth, sourceHeight).data;
						let left = sourceWidth, top = sourceHeight, right = -1, bottom = -1;
						for (let y = 0; y < sourceHeight; y += 1) {
							for (let x = 0; x < sourceWidth; x += 1) {
								if (pixels[(y * sourceWidth + x) * 4 + 3] <= 8) continue;
								left = Math.min(left, x); top = Math.min(top, y);
								right = Math.max(right, x); bottom = Math.max(bottom, y);
							}
						}
						if (right >= left && bottom >= top) bounds = { x: left, y: top, width: right - left + 1, height: bottom - top + 1 };
					} catch {}
					frame.sourceWidth = sourceWidth;
					frame.sourceHeight = sourceHeight;
					frame.contentBounds = bounds;
					frame.width = bounds.width;
					frame.height = bounds.height;
					return bounds;
				}

				renderTransformedFrame(frame, image, scene) {
					const canvas = document.createElement('canvas');
					canvas.width = Math.max(1, Math.round(scene.width));
					canvas.height = Math.max(1, Math.round(scene.height));
					const context = canvas.getContext('2d', { alpha: true });
					if (!context) return Promise.reject(new Error('Canvas unavailable while saving frames.'));
					const transform = this.normalizeTransform(frame.transform);
					context.clearRect(0, 0, canvas.width, canvas.height);
					context.imageSmoothingEnabled = false;
					context.save();
					context.translate(
						canvas.width / 2 + (transform.x / 100) * canvas.width,
						canvas.height / 2 + (transform.y / 100) * canvas.height,
					);
					context.rotate(transform.rotation * (Math.PI / 180));
					context.scale(transform.scaleX, transform.scaleY);
					const bounds = frame.contentBounds || { x: 0, y: 0, width: image.naturalWidth, height: image.naturalHeight };
					context.drawImage(image, -(bounds.x + bounds.width / 2), -(bounds.y + bounds.height / 2));
					context.restore();
					return new Promise((resolve, reject) => {
						canvas.toBlob((blob) => blob ? resolve(blob) : reject(new Error('PNG creation failed.')), 'image/png');
					});
				}

				async findSubdirectory(directory, name) {
					for await (const entry of directory.values()) {
						if (entry.kind === 'directory' && entry.name.toLowerCase() === name.toLowerCase()) return entry;
					}
					return null;
				}

				async collectDirectoryImages(directory, prefix, entries, recursive = true) {
					for await (const entry of directory.values()) {
						const path = prefix ? `${prefix}/${entry.name}` : entry.name;
						if (entry.kind === 'directory' && recursive) {
							await this.collectDirectoryImages(entry, path, entries, true);
						} else if (entry.kind === 'file' && /\.(png|webp|jpe?g|gif)$/i.test(entry.name)) {
							entries.push({ file: await entry.getFile(), path });
						}
					}
				}

				async ensureDirectoryPermission(directory, request) {
					const options = { mode: 'read' };
					if (await directory.queryPermission(options) === 'granted') return 'granted';
					if (!request) return 'prompt';
					return directory.requestPermission(options);
				}

				openHandleDatabase() {
					return new Promise((resolve, reject) => {
						const request = indexedDB.open('spriteanim-v2-handles', 1);
						request.onupgradeneeded = () => request.result.createObjectStore('handles');
						request.onsuccess = () => resolve(request.result);
						request.onerror = () => reject(request.error);
					});
				}

				storageKey(key) {
					return window.SpriteAnimProject?.getStorageKey?.(key) || key;
				}

				async getStoredDirectoryHandle() {
					const storedKey = this.storageKey('samples-directory');
					const database = await this.openHandleDatabase();
					const directory = await new Promise((resolve, reject) => {
						const request = database.transaction('handles').objectStore('handles').get(storedKey);
						request.onsuccess = () => resolve(request.result || null);
						request.onerror = () => reject(request.error);
					});
					database.close();
					return directory;
				}

				async deleteStoredWorkspace() {
					const database = await this.openHandleDatabase();
					await new Promise((resolve, reject) => {
						const transaction = database.transaction('handles', 'readwrite');
						const store = transaction.objectStore('handles');
						store.delete(this.storageKey('sequencer-files'));
						store.delete(this.storageKey('sequencer-workspace'));
						transaction.oncomplete = () => resolve();
						transaction.onerror = () => reject(transaction.error);
					});
					database.close();
				}

				async storeValue(key, value) {
					const storedKey = this.storageKey(key);
					const database = await this.openHandleDatabase();
					await new Promise((resolve, reject) => {
						const transaction = database.transaction('handles', 'readwrite');
						transaction.objectStore('handles').put(value, storedKey);
						transaction.oncomplete = () => resolve();
						transaction.onerror = () => reject(transaction.error);
					});
					database.close();
				}

				async getStoredValue(key) {
					const storedKey = this.storageKey(key);
					const database = await this.openHandleDatabase();
					const value = await new Promise((resolve, reject) => {
						const request = database.transaction('handles').objectStore('handles').get(storedKey);
						request.onsuccess = () => resolve(request.result || null);
						request.onerror = () => reject(request.error);
					});
					database.close();
					return value;
				}

				getSourceSignature() {
					return this.getSourceFrames().map((frame) => frame.sourcePath || frame.path).join('\n');
				}

				async restoreWorkspaceState(sourceName) {
					this.selectedIds = [];
					this.currentIndex = 0;
					const state = await this.getStoredValue('sequencer-workspace');
					if (!state || state.sourceName !== sourceName || state.sourceSignature !== this.getSourceSignature()) return;

					const sources = new Map(this.getSourceFrames().map((frame) => [frame.sourcePath || frame.path, frame]));
					for (const item of state.sequence || []) {
						const source = sources.get(item.sourcePath);
						if (!source) continue;
						if (!item.duplicate) {
							source.transform = this.normalizeTransform(item.transform);
							this.selectedIds.push(source.id);
							continue;
						}
						const duplicate = {
							...source,
							id: `duplicate-${Date.now()}-${Math.random().toString(36).slice(2)}`,
							name: item.name || `${source.name} copy`,
							isSequenceDuplicate: true,
							duplicateOf: source.id,
							sourcePath: item.sourcePath,
							transform: this.normalizeTransform(item.transform),
						};
						this.frames.push(duplicate);
						this.selectedIds.push(duplicate.id);
					}

					this.currentIndex = Math.min(Math.max(0, Number(state.currentIndex) || 0), Math.max(0, this.selectedIds.length - 1));
					if (this.fpsInput && Number(state.fps) > 0) {
						this.fpsInput.value = String(Math.min(60, Math.max(1, Number(state.fps))));
						this.fpsTouched = true;
					}
					if (this.loopInput) this.loopInput.checked = state.loop !== false;
					if (this.onionSkinInput) this.onionSkinInput.checked = state.onionSkin !== false;
					if (this.onionModeInput) {
						const mode = state.onionMode;
						if (mode === 'prev' || mode === 'next' || mode === 'both') this.onionModeInput.value = mode;
					}
					if (this.nudgeScaleInput) {
						const scale = Number(state.nudgeScale);
						if (scale >= 0.5 && scale <= 5) this.nudgeScaleInput.value = String(scale);
					}
				}

				scheduleWorkspaceSave() {
					if (!this.workspaceReady) return;
					window.clearTimeout(this.workspaceSaveTimer);
					this.workspaceSaveTimer = window.setTimeout(() => void this.persistWorkspaceState(), 120);
				}

				async persistWorkspaceState() {
					if (!this.workspaceReady) return;
					const state = {
						sourceName: this.sourceLabel || '',
						sourceSignature: this.getSourceSignature(),
						sequence: this.getSelectedFrames().map((frame) => ({
							sourcePath: frame.sourcePath || frame.path,
							duplicate: Boolean(frame.isSequenceDuplicate),
							name: frame.name,
							transform: this.normalizeTransform(frame.transform),
						})),
						currentIndex: this.currentIndex,
						fps: this.getFps(),
						loop: Boolean(this.loopInput?.checked),
						onionSkin: Boolean(this.onionSkinInput?.checked),
						onionMode: this.onionModeInput?.value || 'prev',
						nudgeScale: Number(this.nudgeScaleInput?.value) || 1,
					};
					try { await this.storeValue('sequencer-workspace', state); } catch {}
				}

				async loadFiles(files) {
					this.workspaceReady = false;
					this.transformUndoStack = [];
					this.keyboardNudge = null;
					this.clearFrameUrls();
					const imageFiles = files
						.filter((file) => file.type.startsWith('image/'))
						.sort((a, b) => this.naturalCompare(a.webkitRelativePath || a.name, b.webkitRelativePath || b.name));

					this.frames = imageFiles.map((file, index) => ({
						id: `frame-${index}-${file.name}`,
						name: file.name,
						path: file.webkitRelativePath || file.name,
						sourcePath: file.webkitRelativePath || file.name,
						url: URL.createObjectURL(file),
					}));
					this.stopPlayback();

					const folderPath = imageFiles[0]?.webkitRelativePath || '';
					const folderName = folderPath.includes('/') ? folderPath.split('/')[0] : 'Selected frames';
					try { await this.storeValue('sequencer-files', imageFiles); } catch {}
					await this.restoreWorkspaceState(folderName);
					this.sourceLabel = imageFiles.length > 0 ? folderName : 'No image frames found';
					this.workspaceReady = imageFiles.length > 0;
					this.render();
				}

				toggleSelection(id) {
					if (!id) return;
					this.stopPlayback();
					const selectedIndex = this.selectedIds.indexOf(id);
					if (selectedIndex >= 0) {
						this.selectedIds.splice(selectedIndex, 1);
						this.currentIndex = Math.min(this.currentIndex, Math.max(0, this.selectedIds.length - 1));
					} else {
						this.selectedIds.push(id);
						this.currentIndex = this.selectedIds.length - 1;
					}
					this.render();
				}

				render() {
					this.renderSourceGrid();
					this.renderSequenceGrid();
					this.updateControls();
					this.updatePreview();
					this.scheduleWorkspaceSave();
				}

				renderSourceGrid() {
					this.sourceGrid.replaceChildren();
					if (this.frames.length === 0) {
						this.sourceGrid.append(this.createEmpty('No frames loaded', 'Choose a folder to populate this grid.'));
						return;
					}

					const sourceFrames = this.getSourceFrames();
					for (let index = 0; index < sourceFrames.length; index += 1) {
						const frame = sourceFrames[index];
						const selectedIndex = this.selectedIds.indexOf(frame.id);
						const selected = selectedIndex >= 0;
						const button = document.createElement('button');
						button.className = 'source-frame';
						button.type = 'button';
						button.dataset.sourceId = frame.id;
						button.setAttribute('aria-pressed', String(selected));
						button.setAttribute('aria-label', selected
							? `Remove ${frame.name} from sequence position ${selectedIndex + 1}`
							: `Select ${frame.name}`);
						button.append(
							this.createImage(frame),
							this.createCaption(frame, index + 1),
							this.createSelectionBadge(selectedIndex + 1),
						);
						this.sourceGrid.append(button);
					}
				}

				renderSequenceGrid() {
					this.sequenceGrid.replaceChildren();
					const selectedFrames = this.getSelectedFrames();
					if (selectedFrames.length === 0) {
						this.sequenceGrid.append(this.createEmpty('No selected frames', 'Selected folder frames appear here in animation order.'));
						return;
					}

					for (let index = 0; index < selectedFrames.length; index += 1) {
						const frame = selectedFrames[index];
						const figure = document.createElement('figure');
						figure.className = 'sequence-frame';
						figure.draggable = false;
						figure.dataset.sequenceId = frame.id;
						figure.setAttribute('aria-label', `Animation frame ${index + 1}: ${frame.name}. Drag to reorder.`);
						const order = document.createElement('span');
						order.className = 'order-badge';
						order.textContent = String(index + 1);
						const handle = document.createElement('span');
						handle.className = 'drag-handle';
						handle.textContent = '::';
						handle.setAttribute('aria-hidden', 'true');
						const remove = document.createElement('button');
						remove.className = 'remove-frame';
						remove.type = 'button';
						remove.dataset.removeId = frame.id;
						remove.textContent = 'X';
						remove.setAttribute('aria-label', `Remove sequence frame ${index + 1}: ${frame.name}`);
						figure.append(order, handle, remove, this.createImage(frame), this.createCaption(frame, index + 1));
						this.sequenceGrid.append(figure);
					}
				}

				createImage(frame) {
					const image = document.createElement('img');
					image.className = 'frame-image';
					image.src = frame.url;
					image.alt = frame.name;
					image.draggable = false;
					image.addEventListener('load', () => {
						this.measureFrameBounds(frame, image);
						this.schedulePreviewLayout();
					}, { once: true });
					return image;
				}

				createCaption(frame, number) {
					const caption = document.createElement('div');
					caption.className = 'frame-caption';
					const file = document.createElement('span');
					file.className = 'frame-file';
					file.textContent = frame.name;
					const index = document.createElement('span');
					index.textContent = String(number).padStart(3, '0');
					caption.append(file, index);
					return caption;
				}

				createSelectionBadge(position) {
					const check = document.createElement('span');
					check.className = 'selection-check';
					check.textContent = position > 0 ? `#${position}` : '';
					check.setAttribute('aria-hidden', 'true');
					return check;
				}

				createEmpty(title, message) {
					const empty = document.createElement('div');
					empty.className = 'empty-state';
					const copy = document.createElement('p');
					const strong = document.createElement('strong');
					strong.textContent = title;
					const detail = document.createElement('span');
					detail.textContent = message;
					copy.append(strong, detail);
					empty.append(copy);
					return empty;
				}

				onPointerDown(event) {
					if (event.button !== 0) return;
					if (event.target instanceof Element && event.target.closest('[data-remove-id]')) return;
					const frame = event.target instanceof Element ? event.target.closest('[data-sequence-id]') : null;
					if (!(frame instanceof HTMLElement)) return;
					this.stopPlayback();
					this.draggedId = frame.dataset.sequenceId || '';
					this.pointerId = event.pointerId;
					this.pointerStart = { x: event.clientX, y: event.clientY };
					this.pointerMoved = false;
					frame.setPointerCapture?.(event.pointerId);
				}

				removeSelectedFrame(id) {
					const index = this.selectedIds.indexOf(id);
					if (index < 0) return;
					this.stopPlayback();
					this.selectedIds.splice(index, 1);
					const frame = this.frames.find((item) => item.id === id);
					if (frame?.isSequenceDuplicate) this.frames = this.frames.filter((item) => item.id !== id);
					this.currentIndex = Math.min(this.currentIndex, Math.max(0, this.selectedIds.length - 1));
					this.render();
				}

				deleteCurrentFrame() {
					const id = this.selectedIds[this.currentIndex];
					if (id) this.removeSelectedFrame(id);
				}

				duplicateCurrentFrame() {
					const selectedFrames = this.getSelectedFrames();
					const frame = selectedFrames[this.currentIndex];
					if (!frame) return;
					this.stopPlayback();
					const copyNumber = this.frames.filter((item) => item.duplicateOf === (frame.duplicateOf || frame.id)).length + 1;
					const duplicate = {
						...frame,
						id: `duplicate-${Date.now()}-${Math.random().toString(36).slice(2)}`,
						name: `${frame.name} copy ${copyNumber}`,
						isSequenceDuplicate: true,
						duplicateOf: frame.duplicateOf || frame.id,
						sourcePath: frame.sourcePath || frame.path,
						transform: { ...this.normalizeTransform(frame.transform) },
					};
					this.frames.push(duplicate);
					this.selectedIds.splice(this.currentIndex + 1, 0, duplicate.id);
					this.currentIndex += 1;
					this.exportStatus.textContent = `Duplicated frame into sequence position ${this.currentIndex + 1}.`;
					this.render();
				}

				onPointerMove(event) {
					if (event.pointerId !== this.pointerId || !this.pointerStart) return;
					const distance = Math.hypot(event.clientX - this.pointerStart.x, event.clientY - this.pointerStart.y);
					if (!this.pointerMoved && distance < 6) return;
					this.pointerMoved = true;
					event.preventDefault();
					const dragged = this.sequenceGrid.querySelector(`[data-sequence-id="${CSS.escape(this.draggedId)}"]`);
					if (dragged instanceof HTMLElement) dragged.dataset.dragging = 'true';
					const target = document.elementFromPoint(event.clientX, event.clientY);
					const frame = target instanceof Element ? target.closest('[data-sequence-id]') : null;
					if (!(frame instanceof HTMLElement) || frame.dataset.sequenceId === this.draggedId) return;
					for (const item of this.sequenceGrid.querySelectorAll('[data-drop-target]')) item.removeAttribute('data-drop-target');
					frame.dataset.dropTarget = 'true';
				}

				onPointerUp(event) {
					if (event.pointerId !== this.pointerId) return;
					const target = document.elementFromPoint(event.clientX, event.clientY);
					const frame = target instanceof Element ? target.closest('[data-sequence-id]') : null;
					const targetId = frame instanceof HTMLElement ? frame.dataset.sequenceId || '' : '';
					const fromIndex = this.selectedIds.indexOf(this.draggedId);
					const toIndex = this.selectedIds.indexOf(targetId);
					if (this.pointerMoved && fromIndex >= 0 && toIndex >= 0 && fromIndex !== toIndex) {
						const [moved] = this.selectedIds.splice(fromIndex, 1);
						this.selectedIds.splice(toIndex, 0, moved);
						this.currentIndex = toIndex;
						this.suppressSequenceClick = true;
					}
					const shouldRender = this.pointerMoved;
					this.clearDragState();
					if (shouldRender) this.render();
				}

				clearDragState() {
					this.draggedId = '';
					this.pointerId = null;
					this.pointerStart = null;
					this.pointerMoved = false;
					for (const item of this.sequenceGrid.querySelectorAll('[data-dragging], [data-drop-target]')) {
						item.removeAttribute('data-dragging');
						item.removeAttribute('data-drop-target');
					}
				}

				onScenePointerDown(event) {
					if (event.button !== 0) return;
					const target = event.target instanceof Element ? event.target : null;
					const type = target?.closest('[data-rotate-handle]') ? 'rotate'
						: target?.closest('[data-resize-handle]') ? 'resize'
						: target?.closest('[data-preview-image]') ? 'move' : '';
					if (!type) return;
					const frame = this.getSelectedFrames()[this.currentIndex];
					if (!frame || !(this.previewScene instanceof HTMLElement)) return;
					this.stopPlayback();
					const transform = this.normalizeTransform(frame.transform);
					const imageRect = this.previewImage.getBoundingClientRect();
					const centerX = imageRect.left + imageRect.width / 2;
					const centerY = imageRect.top + imageRect.height / 2;
					const resizeHandle = target?.closest('[data-resize-handle]')?.getAttribute('data-resize-handle') || '';
					const scene = this.getSceneDimensions();
					const sceneRect = this.previewScene.getBoundingClientRect();
					this.sceneGesture = {
						type,
						precision: event.shiftKey,
						pointerId: event.pointerId,
						frame,
						startX: event.clientX,
						startY: event.clientY,
						startTransform: transform,
						startAngle: Math.atan2(event.clientY - centerY, event.clientX - centerX),
						resizeHandle,
						baseWidth: ((Number(frame.width) || scene.width) / scene.width) * sceneRect.width,
						baseHeight: ((Number(frame.height) || scene.height) / scene.height) * sceneRect.height,
						changed: false,
					};
					this.previewScene.setPointerCapture?.(event.pointerId);
					event.preventDefault();
				}

				onScenePointerMove(event) {
					const gesture = this.sceneGesture;
					if (!gesture || event.pointerId !== gesture.pointerId || !(this.previewScene instanceof HTMLElement)) return;
					const rect = this.previewScene.getBoundingClientRect();
					if (!rect.width || !rect.height) return;
					const sensitivity = gesture.type === 'resize' ? 1 : event.shiftKey ? 0.2 : 1;
					let transform;
					if (gesture.type === 'move') {
						transform = {
							...gesture.startTransform,
							x: gesture.startTransform.x + ((event.clientX - gesture.startX) / rect.width) * 100 * sensitivity,
							y: gesture.startTransform.y + ((event.clientY - gesture.startY) / rect.height) * 100 * sensitivity,
						};
					} else if (gesture.type === 'rotate') {
						const imageRect = this.previewImage.getBoundingClientRect();
						const centerX = imageRect.left + imageRect.width / 2;
						const centerY = imageRect.top + imageRect.height / 2;
						const angle = Math.atan2(event.clientY - centerY, event.clientX - centerX);
						let delta = (angle - gesture.startAngle) * (180 / Math.PI);
						if (delta > 180) delta -= 360;
						if (delta < -180) delta += 360;
						transform = { ...gesture.startTransform, rotation: gesture.startTransform.rotation + delta * sensitivity };
					} else {
						const radians = gesture.startTransform.rotation * (Math.PI / 180);
						const dx = event.clientX - gesture.startX;
						const dy = event.clientY - gesture.startY;
						const localX = dx * Math.cos(radians) + dy * Math.sin(radians);
						const localY = -dx * Math.sin(radians) + dy * Math.cos(radians);
						const handle = gesture.resizeHandle;
						const horizontal = handle.includes('e') ? 1 : handle.includes('w') ? -1 : 0;
						const vertical = handle.includes('s') ? 1 : handle.includes('n') ? -1 : 0;
						transform = {
							...gesture.startTransform,
							scaleX: horizontal ? gesture.startTransform.scaleX + (2 * horizontal * localX / gesture.baseWidth) * sensitivity : gesture.startTransform.scaleX,
							scaleY: vertical ? gesture.startTransform.scaleY + (2 * vertical * localY / gesture.baseHeight) * sensitivity : gesture.startTransform.scaleY,
						};
						if (event.shiftKey) {
							const startX = gesture.startTransform.scaleX;
							const startY = gesture.startTransform.scaleY;
							const factorX = horizontal ? transform.scaleX / startX : 1;
							const factorY = vertical ? transform.scaleY / startY : 1;
							let factor = horizontal && vertical
								? Math.abs(factorX - 1) >= Math.abs(factorY - 1) ? factorX : factorY
								: horizontal ? factorX : factorY;
							factor = Math.min(10 / startX, 10 / startY, Math.max(0.1 / startX, 0.1 / startY, factor));
							transform.scaleX = startX * factor;
							transform.scaleY = startY * factor;
						}
					}
					gesture.frame.transform = this.normalizeTransform(transform);
					gesture.changed = !this.transformsEqual(gesture.frame.transform, gesture.startTransform);
					this.applySpriteLayer(this.previewLayer, gesture.frame);
					this.updateTransformStatus(gesture.frame);
					this.scheduleWorkspaceSave();
					event.preventDefault();
				}

				onScenePointerUp(event) {
					if (!this.sceneGesture || event.pointerId !== this.sceneGesture.pointerId) return;
					this.finishSceneGesture();
				}

				finishSceneGesture() {
					if (!this.sceneGesture) return;
					if (this.sceneGesture.changed) {
						this.pushTransformUndo(this.sceneGesture.frame, this.sceneGesture.startTransform);
						this.exportStatus.textContent = `Adjusted frame ${this.currentIndex + 1} in the scene.`;
					}
					this.sceneGesture = null;
					this.scheduleWorkspaceSave();
				}

				resetCurrentTransform(event) {
					event.preventDefault();
					const frame = this.getSelectedFrames()[this.currentIndex];
					if (!frame) return;
					this.stopPlayback();
					const transform = this.normalizeTransform(frame.transform);
					if (this.transformsEqual(transform, { x: 0, y: 0, rotation: 0, scaleX: 1, scaleY: 1 })) return;
					this.pushTransformUndo(frame, transform);
					frame.transform = { x: 0, y: 0, rotation: 0, scaleX: 1, scaleY: 1 };
					this.updatePreview();
					this.exportStatus.textContent = `Reset frame ${this.currentIndex + 1} scene position.`;
					this.scheduleWorkspaceSave();
				}

				onTransformKeyDown(event) {
					if (this.isEditableTarget(event.target)) return;
					if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'z' && this.transformUndoStack.length > 0) {
						event.preventDefault();
						this.undoTransform();
						return;
					}
					const key = event.key.toLowerCase();
					if (key === 'q') {
						event.preventDefault();
						this.stopPlayback();
						this.step(-1);
						return;
					}
					if (key === 'e') {
						event.preventDefault();
						this.stopPlayback();
						this.step(1);
						return;
					}
					if (key === 'f') {
						event.preventDefault();
						void this.toggleFullscreen();
						return;
					}
					if (key === 'w') {
						event.preventDefault();
						this.togglePlayback();
						return;
					}
					const movement = {
						ArrowLeft: [-1, 0],
						ArrowRight: [1, 0],
						ArrowUp: [0, -1],
						ArrowDown: [0, 1],
					}[event.key];
					if (!movement) return;
					const frame = this.getSelectedFrames()[this.currentIndex];
					if (!frame) return;
					event.preventDefault();
					this.stopPlayback();
					if (!this.keyboardNudge || this.keyboardNudge.frameId !== frame.id) {
						this.pushTransformUndo(frame, this.normalizeTransform(frame.transform));
						this.keyboardNudge = { frameId: frame.id };
					}
					const scale = Math.max(0.5, Math.min(5, Number(this.nudgeScaleInput?.value) || 1));
					const step = (event.shiftKey ? 0.1 : 1) * (scale / 5);
					const transform = this.normalizeTransform(frame.transform);
					frame.transform = this.normalizeTransform({
						...transform,
						x: transform.x + movement[0] * step,
						y: transform.y + movement[1] * step,
					});
					this.applySpriteLayer(this.previewLayer, frame);
					this.updateTransformStatus(frame);
					this.updateOnionFrames(this.getSelectedFrames());
					this.exportStatus.textContent = `Nudged frame ${this.currentIndex + 1} with arrow keys.`;
					this.scheduleWorkspaceSave();
				}

				onTransformKeyUp(event) {
					if (event.key.startsWith('Arrow')) this.keyboardNudge = null;
				}

				isEditableTarget(target) {
					return target instanceof HTMLElement && Boolean(target.closest('input, textarea, select, [contenteditable="true"]'));
				}

				transformsEqual(first, second) {
					const a = this.normalizeTransform(first);
					const b = this.normalizeTransform(second);
					return Math.abs(a.x - b.x) < 0.0001
						&& Math.abs(a.y - b.y) < 0.0001
						&& Math.abs(a.scaleX - b.scaleX) < 0.0001
						&& Math.abs(a.scaleY - b.scaleY) < 0.0001
						&& Math.abs(a.rotation - b.rotation) < 0.0001;
				}

				pushTransformUndo(frame, transform) {
					if (!frame) return;
					this.transformUndoStack.push({ frameId: frame.id, transform: { ...this.normalizeTransform(transform) } });
					if (this.transformUndoStack.length > 100) this.transformUndoStack.shift();
				}

				undoTransform() {
					this.stopPlayback();
					let entry = this.transformUndoStack.pop();
					let frame = entry ? this.frames.find((item) => item.id === entry.frameId) : null;
					while (entry && !frame) {
						entry = this.transformUndoStack.pop();
						frame = entry ? this.frames.find((item) => item.id === entry.frameId) : null;
					}
					if (!entry || !frame) return;
					frame.transform = { ...entry.transform };
					this.keyboardNudge = null;
					this.updatePreview();
					this.exportStatus.textContent = `Undid frame ${this.selectedIds.indexOf(frame.id) + 1} transform.`;
					this.scheduleWorkspaceSave();
				}

				togglePlayback() {
					if (this.animationTimer) this.stopPlayback();
					else this.startPlayback();
				}

				startPlayback() {
					if (this.selectedIds.length === 0) return;
					this.stopPlayback(false);
					this.playbackActive = true;
					if (this.previewPanel) this.previewPanel.dataset.playing = '';
					if (this.onionSkinInput) this.onionSkinInput.disabled = true;
					if (this.onionModeInput) this.onionModeInput.disabled = true;
					this.hideOnionFrames();
					this.playButton.textContent = 'Pause';
					const delay = Math.max(16, Math.round(1000 / this.getFps()));
					this.animationTimer = window.setInterval(() => {
						const isLast = this.currentIndex >= this.selectedIds.length - 1;
						if (isLast && !this.loopInput.checked) {
							this.stopPlayback();
							return;
						}
						this.currentIndex = isLast ? 0 : this.currentIndex + 1;
						this.updatePreview();
					}, delay);
				}

				stopPlayback(resetLabel = true) {
					if (this.animationTimer) window.clearInterval(this.animationTimer);
					this.animationTimer = 0;
					const wasPlaying = this.playbackActive;
					this.playbackActive = false;
					if (this.previewPanel) delete this.previewPanel.dataset.playing;
					if (this.onionSkinInput) this.onionSkinInput.disabled = false;
					if (this.onionModeInput) this.onionModeInput.disabled = false;
					if (resetLabel && this.playButton) {
						this.playButton.textContent = 'Play';
						this.scheduleWorkspaceSave();
					}
					if (wasPlaying) this.updateOnionFrames(this.getSelectedFrames());
				}

				step(direction) {
					if (this.selectedIds.length === 0) return;
					this.stopPlayback();
					this.currentIndex = (this.currentIndex + direction + this.selectedIds.length) % this.selectedIds.length;
					this.updatePreview();
					this.scheduleWorkspaceSave();
				}

				async toggleFullscreen() {
					if (!this.previewPanel) return;
					try {
						if (document.fullscreenElement === this.previewPanel) {
							await document.exitFullscreen();
						} else {
							await this.previewPanel.requestFullscreen();
						}
					} catch (error) {
						if (this.exportStatus) this.exportStatus.textContent = `Fullscreen unavailable: ${error.message}`;
					}
				}

				async loadCanvasBackgrounds() {
					if (!this.canvasBackgroundSelect) return;
					const select = this.canvasBackgroundSelect;
					const saved = localStorage.getItem('spriteanim-canvas-bg') || '';
					select.replaceChildren();
					const checker = document.createElement('option');
					checker.value = '';
					checker.textContent = 'Checker';
					select.append(checker);
					this.canvasBackgrounds = [];
					try {
						const root = await this.getRootFolderHandle();
						if (!root) return;
						const config = await root.getDirectoryHandle('.config');
						const folder = await config.getDirectoryHandle('canvas-backgrounds');
						for await (const entry of folder.values()) {
							if (entry.kind === 'file' && /\.(png|webp|jpe?g|gif)$/i.test(entry.name)) {
								this.canvasBackgrounds.push({ name: entry.name, file: await entry.getFile() });
							}
						}
						this.canvasBackgrounds.sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true, sensitivity: 'base' }));
						for (const background of this.canvasBackgrounds) {
							const option = document.createElement('option');
							option.value = background.name;
							option.textContent = background.name;
							select.append(option);
						}
						if (this.canvasBackgrounds.some((item) => item.name === saved)) {
							select.value = saved;
						} else {
							select.value = this.canvasBackgrounds.length ? this.canvasBackgrounds[0].name : '';
						}
					} catch {
						// backgrounds folder unavailable; only the checker option stays
					}
					this.applyCanvasBackground(select.value);
				}

				applyCanvasBackground(name) {
					const stage = this.previewStage;
					if (!stage) return;
					if (this.canvasBackgroundUrl) {
						URL.revokeObjectURL(this.canvasBackgroundUrl);
						this.canvasBackgroundUrl = '';
					}
					const background = this.canvasBackgrounds.find((item) => item.name === name);
					if (!background) {
						stage.style.backgroundImage = '';
						stage.style.backgroundSize = '';
						stage.style.backgroundPosition = '';
						return;
					}
					this.canvasBackgroundUrl = URL.createObjectURL(background.file);
					stage.style.backgroundImage = `url("${this.canvasBackgroundUrl}")`;
					stage.style.backgroundSize = 'cover';
					stage.style.backgroundPosition = 'center';
					localStorage.setItem('spriteanim-canvas-bg', name);
				}

				updatePreview() {
					const selectedFrames = this.getSelectedFrames();
					for (const item of this.sequenceGrid.querySelectorAll('[data-sequence-id]')) {
						item.removeAttribute('data-current');
					}
					if (selectedFrames.length === 0) {
						this.previewScene.hidden = true;
						this.previewImage.removeAttribute('src');
						this.hideOnionFrames();
						this.previewEmpty.hidden = false;
						this.frameStatus.textContent = 'Frame 0 / 0';
						this.transformStatus.textContent = 'X 0% / Y 0% / 0deg';
						this.progress.style.width = '0%';
						return;
					}

					if (this.fpsInput && !this.fpsTouched) {
						this.fpsInput.value = String(Math.min(60, Math.max(1, selectedFrames.length || 1)));
					}
					this.currentIndex = Math.min(this.currentIndex, selectedFrames.length - 1);
					const frame = selectedFrames[this.currentIndex];
					this.previewImage.src = frame.url;
					this.previewImage.alt = `Preview ${frame.name}`;
					this.previewImage.onload = () => {
						this.measureFrameBounds(frame, this.previewImage);
						this.layoutPreviewScene();
						this.applySpriteLayer(this.previewLayer, frame);
					};
					this.previewScene.hidden = false;
					this.previewEmpty.hidden = true;
					this.layoutPreviewScene();
					this.applySpriteLayer(this.previewLayer, frame);
					this.updateOnionFrames(selectedFrames);
					const currentTile = this.sequenceGrid.querySelector(`[data-sequence-id="${CSS.escape(frame.id)}"]`);
					if (currentTile instanceof HTMLElement) currentTile.dataset.current = 'true';
					this.frameStatus.textContent = `Frame ${this.currentIndex + 1} / ${selectedFrames.length}`;
					this.updateTransformStatus(frame);
					this.progress.style.width = `${((this.currentIndex + 1) / selectedFrames.length) * 100}%`;
				}

				normalizeTransform(transform) {
					return {
						x: Math.min(100, Math.max(-100, Number(transform?.x) || 0)),
						y: Math.min(100, Math.max(-100, Number(transform?.y) || 0)),
						rotation: Number(transform?.rotation) || 0,
						scaleX: Math.min(10, Math.max(0.1, Number(transform?.scaleX) || 1)),
						scaleY: Math.min(10, Math.max(0.1, Number(transform?.scaleY) || 1)),
					};
				}

				getSceneDimensions() {
					let width = 0;
					let height = 0;
					for (const frame of this.getSelectedFrames()) {
						width = Math.max(width, Number(frame.width) || 0);
						height = Math.max(height, Number(frame.height) || 0);
					}
					return { width: width || 1, height: height || 1 };
				}

				schedulePreviewLayout() {
					if (this.previewLayoutFrame) return;
					this.previewLayoutFrame = window.requestAnimationFrame(() => {
						this.previewLayoutFrame = 0;
						if (!this.previewScene?.hidden) this.updatePreview();
					});
				}

				layoutPreviewScene() {
					if (!(this.previewStage instanceof HTMLElement) || !(this.previewScene instanceof HTMLElement)) return;
					const stage = this.previewStage.getBoundingClientRect();
					if (!stage.width || !stage.height) return;
					const scene = this.getSceneDimensions();
					const sceneRatio = scene.width / scene.height;
					const stageRatio = stage.width / stage.height;
					if (sceneRatio >= stageRatio) {
						this.previewScene.style.width = '100%';
						this.previewScene.style.height = `${Math.min(100, (stage.width / sceneRatio / stage.height) * 100)}%`;
					} else {
						this.previewScene.style.height = '100%';
						this.previewScene.style.width = `${Math.min(100, (stage.height * sceneRatio / stage.width) * 100)}%`;
					}
				}

				applySpriteLayer(layer, frame) {
					if (!(layer instanceof HTMLElement) || !frame) return;
					const transform = this.normalizeTransform(frame.transform);
					const box = layer.querySelector('.sprite-box');
					const scene = this.getSceneDimensions();
					const width = Number(frame.width) || scene.width;
					const height = Number(frame.height) || scene.height;
					const image = layer.querySelector('img');
					const bounds = frame.contentBounds;
					layer.style.transform = `translate(${transform.x}%, ${transform.y}%)`;
					if (box instanceof HTMLElement) {
						box.style.width = `${(width / scene.width) * 100 * transform.scaleX}%`;
						box.style.height = `${(height / scene.height) * 100 * transform.scaleY}%`;
						box.style.transform = `translate(-50%, -50%) rotate(${transform.rotation}deg)`;
						if (image instanceof HTMLElement && bounds && frame.sourceWidth && frame.sourceHeight) {
							image.style.position = 'absolute';
							image.style.width = `${(frame.sourceWidth / bounds.width) * 100}%`;
							image.style.height = `${(frame.sourceHeight / bounds.height) * 100}%`;
							image.style.left = `${-(bounds.x / bounds.width) * 100}%`;
							image.style.top = `${-(bounds.y / bounds.height) * 100}%`;
						}
					}
				}

				updateTransformStatus(frame) {
					const transform = this.normalizeTransform(frame?.transform);
					this.transformStatus.textContent = `X ${transform.x.toFixed(1)}% / Y ${transform.y.toFixed(1)}% / ${(transform.scaleX * 100).toFixed(0)}% x ${(transform.scaleY * 100).toFixed(0)}% / ${transform.rotation.toFixed(1)}deg`;
				}

				updateOnionFrames(selectedFrames) {
					if (this.playbackActive || !this.onionSkinInput?.checked || selectedFrames.length < 2) {
						this.hideOnionFrames();
						return;
					}

					const wraps = this.loopInput?.checked;
					const previousIndex = this.currentIndex > 0
						? this.currentIndex - 1
						: wraps ? selectedFrames.length - 1 : -1;
					const nextIndex = this.currentIndex < selectedFrames.length - 1
						? this.currentIndex + 1
						: wraps ? 0 : -1;

					const mode = this.onionModeInput?.value || 'prev';
					const showPrevious = mode === 'both' || mode === 'prev';
					const showNext = mode === 'both' || mode === 'next';
					this.setOnionFrame(this.onionPreviousLayer, this.onionPreviousImage, showPrevious && previousIndex >= 0 ? selectedFrames[previousIndex] : null);
					this.setOnionFrame(this.onionNextLayer, this.onionNextImage, showNext && nextIndex >= 0 ? selectedFrames[nextIndex] : null);
				}

				setOnionFrame(layer, image, frame) {
					if (!(image instanceof HTMLImageElement)) return;
					if (!frame) {
						if (layer instanceof HTMLElement) layer.hidden = true;
						image.removeAttribute('src');
						return;
					}
					image.src = frame.url;
					image.alt = `${image === this.onionPreviousImage ? 'Previous' : 'Next'} onion-skin frame: ${frame.name}`;
					if (layer instanceof HTMLElement) {
						layer.hidden = false;
						this.applySpriteLayer(layer, frame);
					}
				}

				hideOnionFrames() {
					this.setOnionFrame(this.onionPreviousLayer, this.onionPreviousImage, null);
					this.setOnionFrame(this.onionNextLayer, this.onionNextImage, null);
				}

				updateControls() {
					const sourceFrames = this.getSourceFrames();
					const hasFrames = sourceFrames.length > 0;
					const hasSelection = this.selectedIds.length > 0;
					this.sourceCount.textContent = `${sourceFrames.length} frame${sourceFrames.length === 1 ? '' : 's'}`;
					this.selectedCount.textContent = `${this.selectedIds.length} selected`;
					this.selectAllButton.disabled = !hasFrames || sourceFrames.every((frame) => this.selectedIds.includes(frame.id));
					this.clearSelectionButton.disabled = !hasSelection;
					this.playButton.disabled = !hasSelection;
					this.prevButton.disabled = !hasSelection;
					this.nextButton.disabled = !hasSelection;
					this.duplicateFrameButton.disabled = !hasSelection;
					if (this.deleteCurrentButton) this.deleteCurrentButton.disabled = !hasSelection;
					if (this.saveSequenceButton) this.saveSequenceButton.disabled = !hasSelection;
				}


				getSelectedFrames() {
					const frameMap = new Map(this.frames.map((frame) => [frame.id, frame]));
					return this.selectedIds.map((id) => frameMap.get(id)).filter(Boolean);
				}

				getSourceFrames() {
					return this.frames.filter((frame) => !frame.isSequenceDuplicate);
				}

				getFps() {
					return Math.min(60, Math.max(1, Math.round(Number(this.fpsInput.value) || 8)));
				}

				naturalCompare(a, b) {
					return a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' });
				}

				clearFrameUrls() {
					for (const url of new Set(this.frames.map((frame) => frame.url))) URL.revokeObjectURL(url);
				}

				async clear() {
					this.stopPlayback();
					this.workspaceReady = false;
					this.transformUndoStack = [];
					this.keyboardNudge = null;
					window.clearTimeout(this.workspaceSaveTimer);
					try { await this.deleteStoredWorkspace(); } catch {}
					this.clearFrameUrls();
					this.frames = [];
					this.selectedIds = [];
					this.currentIndex = 0;
					this.directoryHandle = null;
					this.sourceLabel = '';
					this.render();
				}
			}

			customElements.define('frame-sequencer-app', FrameSequencerApp);
		</script>
	</body>
</html>
