---
const pageTitle = 'Frame Sequencer';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Load, select, reorder, and play local animation frames." />
		<title>{pageTitle}</title>
		<style is:global>
			:root {
				font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
				color: #171917;
				background: #f4f5f4;
				font-synthesis: none;
			}

			* { box-sizing: border-box; }
			[hidden] { display: none !important; }

			body {
				min-width: 320px;
				min-height: 100vh;
				margin: 0;
				background: #f4f5f4;
			}

			button,
			input { font: inherit; }

			button { cursor: pointer; }

			button:disabled {
				cursor: not-allowed;
				opacity: 0.45;
			}

			button:focus-visible,
			input:focus-visible,
			label:focus-within {
				outline: 2px solid #171917;
				outline-offset: 2px;
			}

			.utility-bar {
				display: flex;
				align-items: center;
				justify-content: space-between;
				height: 52px;
				padding: 0 clamp(16px, 3vw, 40px);
				color: #f8faf8;
				background: #171917;
			}

			.brand {
				margin: 0;
				font-size: 0.875rem;
				font-weight: 680;
			}

			.local-status {
				display: flex;
				align-items: center;
				gap: 8px;
				font-size: 0.75rem;
				color: #bec4be;
			}

			.local-dot {
				width: 7px;
				height: 7px;
				border-radius: 50%;
				background: #52d273;
				box-shadow: 0 0 0 3px rgba(82, 210, 115, 0.14);
			}

			main {
				width: min(1240px, calc(100% - 32px));
				margin: clamp(24px, 5vw, 64px) auto;
			}

			.workbench {
				border: 1px solid #d9ddd9;
				border-radius: 8px;
				background: #ffffff;
				box-shadow: 0 16px 48px rgba(20, 24, 20, 0.07);
			}

			.workbench-head,
			.folder-row,
			.section-head {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 20px;
			}

			.workbench-head {
				align-items: flex-start;
				padding: 24px 26px 20px;
				border-bottom: 1px solid #e4e7e4;
			}

			h1,
			h2,
			p { margin-top: 0; }

			h1 {
				margin-bottom: 0;
				font-size: clamp(1.25rem, 2vw, 1.6rem);
				line-height: 1.2;
			}

			h2 {
				margin-bottom: 0;
				font-size: 0.95rem;
				line-height: 1.3;
			}

			.intro {
				max-width: 650px;
				margin: 7px 0 0;
				font-size: 0.875rem;
				line-height: 1.55;
				color: #656b65;
			}

			.clear-button,
			.utility-button {
				min-height: 36px;
				padding: 0 13px;
				border: 1px solid #d9ddd9;
				border-radius: 6px;
				color: #363a36;
				background: #ffffff;
				font-size: 0.78rem;
				font-weight: 650;
			}

			.clear-button:hover:not(:disabled),
			.utility-button:hover:not(:disabled) { border-color: #8d948d; }

			.unity-button {
				display: inline-flex;
				min-height: 36px;
				align-items: center;
				justify-content: center;
				padding: 0 13px;
				border: 1px solid #21853d;
				border-radius: 6px;
				color: #ffffff;
				background: #238f43;
				font-size: 0.78rem;
				font-weight: 700;
			}

			.unity-button:hover:not(:disabled) { background: #1d7938; }

			.unity-button:disabled {
				cursor: not-allowed;
				opacity: 0.48;
			}

			.export-status {
				flex-basis: 100%;
				margin: -1px 0 0;
				font-family: "SFMono-Regular", Consolas, monospace;
				font-size: 0.67rem;
				line-height: 1.45;
				color: #687068;
				text-align: right;
			}

			.folder-row {
				padding: 20px 26px;
				border-bottom: 1px solid #e4e7e4;
				background: #fbfcfb;
			}

			.folder-picker {
				display: flex;
				align-items: center;
				gap: 14px;
				min-width: 0;
			}

			.folder-mark {
				display: grid;
				flex: 0 0 42px;
				width: 42px;
				height: 42px;
				place-items: center;
				border: 1px solid #d9ddd9;
				border-radius: 6px;
				background: #ffffff;
				font-size: 1rem;
				font-weight: 760;
			}

			.folder-copy { min-width: 0; }

			.folder-name {
				display: block;
				overflow: hidden;
				margin-bottom: 4px;
				font-size: 0.875rem;
				font-weight: 680;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			.folder-meta {
				display: block;
				font-size: 0.75rem;
				color: #747a74;
			}

			.choose-label {
				display: inline-flex;
				align-items: center;
				min-height: 36px;
				padding: 0 13px;
				border-radius: 5px;
				color: #ffffff;
				background: #252825;
				font-size: 0.78rem;
				font-weight: 680;
				white-space: nowrap;
				border: 0;
			}

			.folder-input {
				position: absolute;
				width: 1px;
				height: 1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
			}

			.panel {
				padding: 20px 26px 26px;
				border-bottom: 1px solid #e4e7e4;
			}

			.panel:last-child { border-bottom: 0; }

			.section-head { margin-bottom: 14px; }

			.section-copy {
				margin: 4px 0 0;
				font-size: 0.75rem;
				color: #747a74;
			}

			.section-actions {
				display: flex;
				gap: 8px;
				align-items: center;
			}

			.count {
				font-family: "SFMono-Regular", Consolas, monospace;
				font-size: 0.7rem;
				color: #6f756f;
				white-space: nowrap;
			}

			.frame-grid {
				display: grid;
				grid-template-columns: repeat(5, minmax(0, 1fr));
				gap: 10px;
				align-content: start;
				min-height: 330px;
				max-height: 54vh;
				overflow: auto;
				padding: 2px 4px 2px 2px;
				scrollbar-gutter: stable;
			}

			.empty-state {
				display: grid;
				grid-column: 1 / -1;
				min-height: 326px;
				place-items: center;
				border: 1px solid #e1e4e1;
				background:
					linear-gradient(45deg, #f8f9f8 25%, transparent 25%),
					linear-gradient(-45deg, #f8f9f8 25%, transparent 25%),
					linear-gradient(45deg, transparent 75%, #f8f9f8 75%),
					linear-gradient(-45deg, transparent 75%, #f8f9f8 75%);
				background-position: 0 0, 0 10px, 10px -10px, -10px 0;
				background-size: 20px 20px;
				color: #747a74;
				text-align: center;
			}

			.empty-state strong {
				display: block;
				margin-bottom: 5px;
				color: #424742;
				font-size: 0.875rem;
			}

			.empty-state span { font-size: 0.78rem; }

			.source-frame,
			.sequence-frame {
				position: relative;
				min-width: 0;
				margin: 0;
				padding: 0;
				border: 1px solid #dfe3df;
				border-radius: 5px;
				overflow: hidden;
				color: #171917;
				background: #ffffff;
				text-align: left;
			}

			.source-frame {
				transition: border-color 130ms ease, box-shadow 130ms ease, background 130ms ease;
			}

			.source-frame:hover { border-color: #8d948d; }

			.source-frame[aria-pressed="true"] {
				border-color: #238f43;
				background: #f3fbf5;
				box-shadow: 0 0 0 2px rgba(35, 143, 67, 0.18);
			}

			.selection-check {
				position: absolute;
				top: 7px;
				right: 7px;
				display: none;
				min-width: 28px;
				height: 22px;
				padding: 0 6px;
				place-items: center;
				border-radius: 4px;
				color: #ffffff;
				background: #238f43;
				font-size: 0.72rem;
				font-weight: 800;
				box-shadow: 0 1px 4px rgba(0, 0, 0, 0.22);
			}

			.source-frame[aria-pressed="true"] .selection-check { display: grid; }

			.frame-image,
			.preview-image {
				display: block;
				width: 100%;
				object-fit: contain;
				background-color: #ffffff;
				background-image:
					linear-gradient(45deg, #e5e8e5 25%, transparent 25%),
					linear-gradient(-45deg, #e5e8e5 25%, transparent 25%),
					linear-gradient(45deg, transparent 75%, #e5e8e5 75%),
					linear-gradient(-45deg, transparent 75%, #e5e8e5 75%);
				background-position: 0 0, 0 8px, 8px -8px, -8px 0;
				background-size: 16px 16px;
			}

			.frame-image { aspect-ratio: 16 / 10; }

			.frame-caption {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 8px;
				padding: 7px 8px;
				border-top: 1px solid #e4e7e4;
				font-family: "SFMono-Regular", Consolas, monospace;
				font-size: 0.65rem;
				color: #626862;
			}

			.frame-file {
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			.sequence-layout {
				display: grid;
				grid-template-columns: minmax(0, 1.55fr) minmax(280px, 0.7fr);
				gap: 18px;
				align-items: start;
			}

			.sequence-grid {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 10px;
				align-content: start;
				min-height: 310px;
				max-height: 54vh;
				overflow: auto;
				padding: 2px 4px 2px 2px;
				scrollbar-gutter: stable;
			}

			.sequence-grid .empty-state { min-height: 306px; }

			.sequence-frame {
				cursor: grab;
				touch-action: none;
				user-select: none;
				transition: opacity 120ms ease, transform 120ms ease, border-color 120ms ease;
			}

			.sequence-frame:active { cursor: grabbing; }

			.sequence-frame[data-dragging="true"] {
				opacity: 0.4;
				transform: scale(0.98);
			}

			.sequence-frame[data-drop-target="true"] {
				border-color: #238f43;
				box-shadow: 0 0 0 2px rgba(35, 143, 67, 0.18);
			}

			.sequence-frame[data-current="true"] {
				border-color: #238f43;
				box-shadow: 0 0 0 2px rgba(35, 143, 67, 0.16);
			}

			.order-badge,
			.drag-handle,
			.remove-frame {
				position: absolute;
				top: 7px;
				z-index: 1;
				display: grid;
				height: 23px;
				place-items: center;
				border-radius: 4px;
				color: #ffffff;
				background: rgba(23, 25, 23, 0.84);
				font-family: "SFMono-Regular", Consolas, monospace;
				font-size: 0.65rem;
			}

			.order-badge {
				left: 7px;
				min-width: 26px;
				padding: 0 6px;
			}

			.drag-handle {
				right: 38px;
				width: 27px;
				font-weight: 800;
			}

			.remove-frame {
				right: 7px;
				width: 27px;
				padding: 0;
				border: 0;
				font-family: inherit;
				font-size: 0.82rem;
				font-weight: 760;
			}

			.remove-frame:hover { background: #a12828; }

			.preview-panel {
				position: sticky;
				top: 16px;
				border: 1px solid #dfe3df;
				border-radius: 6px;
				overflow: hidden;
				background: #ffffff;
			}

			.preview-stage {
				display: grid;
				aspect-ratio: 1 / 1;
				place-items: center;
				isolation: isolate;
				overflow: hidden;
				background-color: #ffffff;
				background-image:
					linear-gradient(45deg, #e5e8e5 25%, transparent 25%),
					linear-gradient(-45deg, #e5e8e5 25%, transparent 25%),
					linear-gradient(45deg, transparent 75%, #e5e8e5 75%),
					linear-gradient(-45deg, transparent 75%, #e5e8e5 75%);
				background-position: 0 0, 0 10px, 10px -10px, -10px 0;
				background-size: 20px 20px;
			}

			.preview-image,
			.onion-image {
				grid-area: 1 / 1;
				max-width: 100%;
				max-height: 100%;
				background: transparent;
				object-fit: contain;
				pointer-events: none;
			}

			.preview-image {
				position: relative;
				z-index: 2;
			}

			.onion-image {
				z-index: 1;
				opacity: 0.24;
			}

			.onion-previous {
				filter: sepia(1) saturate(7) hue-rotate(125deg);
			}

			.onion-next {
				filter: sepia(1) saturate(7) hue-rotate(305deg);
			}

			.preview-empty {
				padding: 30px;
				font-size: 0.78rem;
				line-height: 1.5;
				color: #747a74;
				text-align: center;
			}

			.playback {
				padding: 14px;
				border-top: 1px solid #dfe3df;
			}

			.progress-track {
				height: 5px;
				overflow: hidden;
				border-radius: 5px;
				background: #e3e7e3;
			}

			.progress-fill {
				width: 0;
				height: 100%;
				background: #2db653;
				transition: width 80ms linear;
			}

			.playback-controls {
				display: flex;
				align-items: center;
				gap: 7px;
				margin-top: 12px;
			}

			.play-button,
			.step-button {
				height: 36px;
				border-radius: 5px;
				font-size: 0.75rem;
				font-weight: 680;
			}

			.play-button {
				min-width: 62px;
				border: 1px solid #21853d;
				color: #ffffff;
				background: #238f43;
			}

			.step-button {
				min-width: 48px;
				border: 1px solid #d9ddd9;
				color: #363a36;
				background: #ffffff;
			}

			.fps-control {
				display: flex;
				align-items: center;
				gap: 6px;
				margin-left: auto;
				font-size: 0.7rem;
				font-weight: 650;
				color: #656b65;
			}

			.fps-input {
				width: 52px;
				height: 36px;
				padding: 0 7px;
				border: 1px solid #cfd4cf;
				border-radius: 5px;
			}

			.playback-meta {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 10px;
				margin-top: 11px;
				font-family: "SFMono-Regular", Consolas, monospace;
				font-size: 0.67rem;
				color: #686e68;
			}

			.loop-control {
				display: flex;
				align-items: center;
				gap: 6px;
				font-family: inherit;
				font-size: 0.72rem;
				font-weight: 650;
			}

			.onion-control {
				display: flex;
				align-items: center;
				gap: 6px;
				font-family: inherit;
				font-size: 0.72rem;
				font-weight: 650;
				color: #3d433d;
			}

			.onion-key {
				display: inline-flex;
				align-items: center;
				gap: 4px;
				margin-left: auto;
				font-family: "SFMono-Regular", Consolas, monospace;
				font-size: 0.62rem;
				color: #767c76;
			}

			.onion-dot {
				width: 7px;
				height: 7px;
				border-radius: 50%;
			}

			.onion-dot.previous { background: #20a7a0; }
			.onion-dot.next { background: #dc5b72; }

			@media (max-width: 980px) {
				.frame-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
				.sequence-layout { grid-template-columns: 1fr; }
				.preview-panel { position: static; }
				.preview-stage { aspect-ratio: 16 / 9; }
			}

			@media (max-width: 640px) {
				main {
					width: min(100% - 20px, 1240px);
					margin: 10px auto 24px;
				}

				.utility-bar { padding: 0 14px; }
				.workbench-head,
				.folder-row,
				.panel { padding-left: 15px; padding-right: 15px; }
				.workbench-head { align-items: center; }
				.folder-row { align-items: flex-start; flex-direction: column; }
				.folder-picker { width: 100%; }
				.choose-label { width: 100%; justify-content: center; }
				.section-head { align-items: flex-start; flex-direction: column; }
				.section-actions { width: 100%; flex-wrap: wrap; }
				.utility-button { flex: 1 1 120px; }
				.unity-button { flex: 1 1 150px; }
				.export-status { text-align: left; }
				.frame-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); min-height: 300px; }
				.sequence-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); min-height: 280px; }
				.empty-state { min-height: 296px; padding: 24px; }
				.sequence-grid .empty-state { min-height: 276px; }
				.playback-controls { flex-wrap: wrap; }
				.fps-control { margin-left: 0; }
				.onion-key { width: 100%; margin-left: 0; }
			}

			@media (prefers-reduced-motion: reduce) {
				* { transition-duration: 0.001ms !important; }
			}
		</style>
	</head>
	<body>
		<header class="utility-bar">
			<p class="brand">Frame Sequencer</p>
			<div class="local-status"><span class="local-dot"></span>Local processing</div>
		</header>

		<main>
			<frame-sequencer-app class="workbench">
				<div class="workbench-head">
					<div>
						<h1>Build frame animation</h1>
						<p class="intro">Load a folder of image frames, select the ones you need, arrange their order, and preview the animation locally.</p>
					</div>
					<button data-clear class="clear-button" type="button" disabled>Clear</button>
				</div>

				<section class="folder-row" aria-label="Frame folder">
					<div class="folder-picker">
						<div class="folder-mark" aria-hidden="true">DIR</div>
						<div class="folder-copy">
							<strong data-folder-name class="folder-name">No folder selected</strong>
							<span data-folder-meta class="folder-meta">Choose a folder containing PNG, WebP, JPEG, or GIF frames.</span>
						</div>
					</div>
					<button data-folder-picker class="choose-label" type="button">Choose frames folder</button>
					<input data-folder-input class="folder-input" type="file" accept="image/*" multiple webkitdirectory directory hidden />
				</section>

				<section class="panel" aria-labelledby="folder-frames-heading">
					<div class="section-head">
						<div>
							<h2 id="folder-frames-heading">Folder frames</h2>
							<p class="section-copy">Click frames to add or remove them from the animation sequence.</p>
						</div>
						<div class="section-actions">
							<span data-source-count class="count">0 frames</span>
							<button data-select-all class="utility-button" type="button" disabled>Select all</button>
							<button data-clear-selection class="utility-button" type="button" disabled>Clear selection</button>
						</div>
					</div>
					<div data-source-grid class="frame-grid">
						<div class="empty-state"><p><strong>No frames loaded</strong><span>Choose a folder to populate this grid.</span></p></div>
					</div>
				</section>

				<section class="panel" aria-labelledby="sequence-heading">
					<div class="section-head">
						<div>
							<h2 id="sequence-heading">Animation sequence</h2>
							<p class="section-copy">Drag selected frames to reorder them, then play the sequence.</p>
						</div>
						<div class="section-actions">
							<span data-selected-count class="count">0 selected</span>
							<button data-duplicate-frame class="utility-button" type="button" disabled>Duplicate frame</button>
							<button data-save-unity class="unity-button" type="button" disabled>Save for Unity</button>
							<p data-export-status class="export-status" aria-live="polite">Select frames to enable export.</p>
						</div>
					</div>

					<div class="sequence-layout">
						<div data-sequence-grid class="sequence-grid">
							<div class="empty-state"><p><strong>No selected frames</strong><span>Selected folder frames appear here in animation order.</span></p></div>
						</div>

						<aside class="preview-panel" aria-label="Animation preview">
							<div data-preview-stage class="preview-stage">
								<p data-preview-empty class="preview-empty">Select at least one frame to preview the animation.</p>
								<img data-onion-previous class="onion-image onion-previous" alt="Previous onion-skin frame" hidden />
								<img data-onion-next class="onion-image onion-next" alt="Next onion-skin frame" hidden />
								<img data-preview-image class="preview-image" alt="Current animation frame" hidden />
							</div>
							<div class="playback">
								<div class="progress-track" aria-hidden="true"><div data-progress class="progress-fill"></div></div>
								<div class="playback-controls">
									<button data-prev class="step-button" type="button" disabled>Prev</button>
									<button data-play class="play-button" type="button" disabled>Play</button>
									<button data-next class="step-button" type="button" disabled>Next</button>
									<label class="fps-control">FPS <input data-fps class="fps-input" type="number" min="1" max="60" step="1" value="8" inputmode="numeric" /></label>
								</div>
								<div class="playback-meta">
									<span data-frame-status>Frame 0 / 0</span>
									<label class="onion-control"><input data-onion-skin type="checkbox" checked /> Onion skin</label>
									<label class="loop-control"><input data-loop type="checkbox" checked /> Loop</label>
								</div>
								<div class="onion-key" aria-hidden="true">
									<span class="onion-dot previous"></span> Previous
									<span class="onion-dot next"></span> Next
								</div>
							</div>
						</aside>
					</div>
				</section>
			</frame-sequencer-app>
		</main>

		<script>
			class FrameSequencerApp extends HTMLElement {
				frames = [];
				selectedIds = [];
				currentIndex = 0;
				animationTimer = 0;
				draggedId = '';
				pointerId = null;
				pointerStart = null;
				pointerMoved = false;
				suppressSequenceClick = false;
				workspaceReady = false;
				workspaceSaveTimer = 0;

				connectedCallback() {
					this.folderButton = this.querySelector('[data-folder-picker]');
					this.folderInput = this.querySelector('[data-folder-input]');
					this.folderName = this.querySelector('[data-folder-name]');
					this.folderMeta = this.querySelector('[data-folder-meta]');
					this.sourceGrid = this.querySelector('[data-source-grid]');
					this.sequenceGrid = this.querySelector('[data-sequence-grid]');
					this.sourceCount = this.querySelector('[data-source-count]');
					this.selectedCount = this.querySelector('[data-selected-count]');
					this.selectAllButton = this.querySelector('[data-select-all]');
					this.clearSelectionButton = this.querySelector('[data-clear-selection]');
					this.clearButton = this.querySelector('[data-clear]');
					this.duplicateFrameButton = this.querySelector('[data-duplicate-frame]');
					this.saveUnityButton = this.querySelector('[data-save-unity]');
					this.exportStatus = this.querySelector('[data-export-status]');
					this.previewImage = this.querySelector('[data-preview-image]');
					this.onionPreviousImage = this.querySelector('[data-onion-previous]');
					this.onionNextImage = this.querySelector('[data-onion-next]');
					this.previewEmpty = this.querySelector('[data-preview-empty]');
					this.playButton = this.querySelector('[data-play]');
					this.prevButton = this.querySelector('[data-prev]');
					this.nextButton = this.querySelector('[data-next]');
					this.fpsInput = this.querySelector('[data-fps]');
					this.loopInput = this.querySelector('[data-loop]');
					this.onionSkinInput = this.querySelector('[data-onion-skin]');
					this.frameStatus = this.querySelector('[data-frame-status]');
					this.progress = this.querySelector('[data-progress]');

					this.folderButton?.addEventListener('click', () => this.chooseFramesDirectory());
					this.folderInput?.addEventListener('change', (event) => {
						const input = event.currentTarget;
						if (input instanceof HTMLInputElement && input.files) this.loadFiles([...input.files]);
					});

					this.sourceGrid?.addEventListener('click', (event) => {
						const button = event.target instanceof Element ? event.target.closest('[data-source-id]') : null;
						if (button instanceof HTMLButtonElement) this.toggleSelection(button.dataset.sourceId || '');
					});

					this.selectAllButton?.addEventListener('click', () => {
						this.stopPlayback();
						this.selectedIds = this.getSourceFrames().map((frame) => frame.id);
						this.currentIndex = 0;
						this.render();
					});

					this.clearSelectionButton?.addEventListener('click', () => {
						this.stopPlayback();
						this.selectedIds = [];
						this.frames = this.frames.filter((frame) => !frame.isSequenceDuplicate);
						this.currentIndex = 0;
						this.render();
					});

					this.clearButton?.addEventListener('click', () => this.clear());
					this.duplicateFrameButton?.addEventListener('click', () => this.duplicateCurrentFrame());
					this.saveUnityButton?.addEventListener('click', () => this.saveForUnity());
					this.playButton?.addEventListener('click', () => this.togglePlayback());
					this.prevButton?.addEventListener('click', () => this.step(-1));
					this.nextButton?.addEventListener('click', () => this.step(1));
					this.onionSkinInput?.addEventListener('change', () => this.updatePreview());
					this.onionSkinInput?.addEventListener('change', () => this.scheduleWorkspaceSave());
					this.loopInput?.addEventListener('change', () => {
						this.updatePreview();
						this.scheduleWorkspaceSave();
					});
					this.fpsInput?.addEventListener('change', () => {
						this.fpsInput.value = String(this.getFps());
						if (this.animationTimer) this.startPlayback();
						this.scheduleWorkspaceSave();
					});

					this.sequenceGrid?.addEventListener('click', (event) => {
						if (this.suppressSequenceClick) {
							this.suppressSequenceClick = false;
							return;
						}
						const removeButton = event.target instanceof Element ? event.target.closest('[data-remove-id]') : null;
						if (removeButton instanceof HTMLButtonElement) {
							this.removeSelectedFrame(removeButton.dataset.removeId || '');
							return;
						}
						const frame = event.target instanceof Element ? event.target.closest('[data-sequence-id]') : null;
						if (!(frame instanceof HTMLElement)) return;
						const index = this.selectedIds.indexOf(frame.dataset.sequenceId || '');
						if (index >= 0) {
							this.stopPlayback();
							this.currentIndex = index;
							this.updatePreview();
							this.scheduleWorkspaceSave();
						}
					});

					this.sequenceGrid?.addEventListener('pointerdown', (event) => this.onPointerDown(event));
					this.sequenceGrid?.addEventListener('pointermove', (event) => this.onPointerMove(event));
					this.sequenceGrid?.addEventListener('pointerup', (event) => this.onPointerUp(event));
					this.sequenceGrid?.addEventListener('pointercancel', () => this.clearDragState());
					window.addEventListener('pagehide', () => void this.persistWorkspaceState());
					void this.restoreFramesDirectory();

				}

				async chooseFramesDirectory() {
					if (!('showDirectoryPicker' in window)) {
						this.folderInput?.click();
						return;
					}

					try {
						let directory = this.directoryHandle || await this.getStoredDirectoryHandle();
						if (directory) {
							const permission = await this.ensureDirectoryPermission(directory, true);
							if (permission === 'granted') {
								this.directoryHandle = directory;
								await this.loadDirectoryHandle(directory);
								return;
							}
						}

						directory = await window.showDirectoryPicker({ mode: 'readwrite' });
						this.directoryHandle = directory;
						await this.storeDirectoryHandle(directory);
						await this.loadDirectoryHandle(directory);
					} catch (error) {
						if (!(error instanceof DOMException && error.name === 'AbortError')) {
							this.folderMeta.textContent = error instanceof Error ? error.message : 'Could not open folder.';
						}
					}
				}

				async restoreFramesDirectory() {
					try {
						if ('showDirectoryPicker' in window) {
							const directory = await this.getStoredDirectoryHandle();
							if (directory) {
								this.directoryHandle = directory;
								this.folderName.textContent = directory.name;
								this.clearButton.disabled = false;
								const permission = await this.ensureDirectoryPermission(directory, false);
								if (permission === 'granted') {
									await this.loadDirectoryHandle(directory);
									return;
								}
								this.folderButton.textContent = 'Reconnect remembered folder';
								this.folderMeta.textContent = 'Folder remembered. Reconnect once only if browser permission expired.';
								return;
							}
						}
						const files = await this.getStoredValue('sequencer-files');
						if (files?.length) await this.loadFiles(files);
					} catch {
						this.folderMeta.textContent = 'Choose a folder containing PNG, WebP, JPEG, or GIF frames.';
					}
				}

				async loadDirectoryHandle(directory) {
					this.workspaceReady = false;
					this.clearFrameUrls();
					const entries = [];
					await this.collectDirectoryImages(directory, '', entries);
					entries.sort((a, b) => this.naturalCompare(a.path, b.path));
					this.frames = entries.map((entry, index) => ({
						id: `frame-${index}-${entry.file.name}`,
						name: entry.file.name,
						path: entry.path,
						sourcePath: entry.path,
						url: URL.createObjectURL(entry.file),
					}));
					await this.restoreWorkspaceState(directory.name);
					this.stopPlayback();
					this.folderName.textContent = this.frames.length > 0 ? directory.name : 'No image frames found';
					this.folderMeta.textContent = this.frames.length > 0
						? `${this.frames.length} image frame${this.frames.length === 1 ? '' : 's'} loaded. Read/write access remembered.`
						: 'No PNG, WebP, JPEG, or GIF frames found in this folder.';
					this.folderButton.textContent = 'Change frames folder';
					this.clearButton.disabled = false;
					this.workspaceReady = this.frames.length > 0;
					this.render();
				}

				async collectDirectoryImages(directory, prefix, entries) {
					for await (const entry of directory.values()) {
						const path = prefix ? `${prefix}/${entry.name}` : entry.name;
						if (entry.kind === 'directory') {
							await this.collectDirectoryImages(entry, path, entries);
						} else if (entry.kind === 'file' && /\.(png|webp|jpe?g|gif)$/i.test(entry.name)) {
							entries.push({ file: await entry.getFile(), path });
						}
					}
				}

				async ensureDirectoryPermission(directory, request) {
					const options = { mode: 'readwrite' };
					if (await directory.queryPermission(options) === 'granted') return 'granted';
					if (!request) return 'prompt';
					return directory.requestPermission(options);
				}

				openHandleDatabase() {
					return new Promise((resolve, reject) => {
						const request = indexedDB.open('spriteanim-v2-handles', 1);
						request.onupgradeneeded = () => request.result.createObjectStore('handles');
						request.onsuccess = () => resolve(request.result);
						request.onerror = () => reject(request.error);
					});
				}

				async storeDirectoryHandle(directory) {
					const database = await this.openHandleDatabase();
					await new Promise((resolve, reject) => {
						const transaction = database.transaction('handles', 'readwrite');
						transaction.objectStore('handles').put(directory, 'frames-directory');
						transaction.oncomplete = () => resolve();
						transaction.onerror = () => reject(transaction.error);
					});
					database.close();
				}

				async getStoredDirectoryHandle() {
					const database = await this.openHandleDatabase();
					const directory = await new Promise((resolve, reject) => {
						const request = database.transaction('handles').objectStore('handles').get('frames-directory');
						request.onsuccess = () => resolve(request.result || null);
						request.onerror = () => reject(request.error);
					});
					database.close();
					return directory;
				}

				async deleteStoredWorkspace() {
					const database = await this.openHandleDatabase();
					await new Promise((resolve, reject) => {
						const transaction = database.transaction('handles', 'readwrite');
						const store = transaction.objectStore('handles');
						store.delete('frames-directory');
						store.delete('sequencer-files');
						store.delete('sequencer-workspace');
						transaction.oncomplete = () => resolve();
						transaction.onerror = () => reject(transaction.error);
					});
					database.close();
				}

				async storeValue(key, value) {
					const database = await this.openHandleDatabase();
					await new Promise((resolve, reject) => {
						const transaction = database.transaction('handles', 'readwrite');
						transaction.objectStore('handles').put(value, key);
						transaction.oncomplete = () => resolve();
						transaction.onerror = () => reject(transaction.error);
					});
					database.close();
				}

				async getStoredValue(key) {
					const database = await this.openHandleDatabase();
					const value = await new Promise((resolve, reject) => {
						const request = database.transaction('handles').objectStore('handles').get(key);
						request.onsuccess = () => resolve(request.result || null);
						request.onerror = () => reject(request.error);
					});
					database.close();
					return value;
				}

				getSourceSignature() {
					return this.getSourceFrames().map((frame) => frame.sourcePath || frame.path).join('\n');
				}

				async restoreWorkspaceState(sourceName) {
					this.selectedIds = [];
					this.currentIndex = 0;
					const state = await this.getStoredValue('sequencer-workspace');
					if (!state || state.sourceName !== sourceName || state.sourceSignature !== this.getSourceSignature()) return;

					const sources = new Map(this.getSourceFrames().map((frame) => [frame.sourcePath || frame.path, frame]));
					for (const item of state.sequence || []) {
						const source = sources.get(item.sourcePath);
						if (!source) continue;
						if (!item.duplicate) {
							this.selectedIds.push(source.id);
							continue;
						}
						const duplicate = {
							...source,
							id: `duplicate-${Date.now()}-${Math.random().toString(36).slice(2)}`,
							name: item.name || `${source.name} copy`,
							isSequenceDuplicate: true,
							duplicateOf: source.id,
							sourcePath: item.sourcePath,
						};
						this.frames.push(duplicate);
						this.selectedIds.push(duplicate.id);
					}

					this.currentIndex = Math.min(Math.max(0, Number(state.currentIndex) || 0), Math.max(0, this.selectedIds.length - 1));
					if (this.fpsInput) this.fpsInput.value = String(Math.min(60, Math.max(1, Number(state.fps) || 8)));
					if (this.loopInput) this.loopInput.checked = state.loop !== false;
					if (this.onionSkinInput) this.onionSkinInput.checked = state.onionSkin !== false;
				}

				scheduleWorkspaceSave() {
					if (!this.workspaceReady) return;
					window.clearTimeout(this.workspaceSaveTimer);
					this.workspaceSaveTimer = window.setTimeout(() => void this.persistWorkspaceState(), 120);
				}

				async persistWorkspaceState() {
					if (!this.workspaceReady) return;
					const state = {
						sourceName: this.folderName.textContent || '',
						sourceSignature: this.getSourceSignature(),
						sequence: this.getSelectedFrames().map((frame) => ({
							sourcePath: frame.sourcePath || frame.path,
							duplicate: Boolean(frame.isSequenceDuplicate),
							name: frame.name,
						})),
						currentIndex: this.currentIndex,
						fps: this.getFps(),
						loop: Boolean(this.loopInput?.checked),
						onionSkin: Boolean(this.onionSkinInput?.checked),
					};
					try { await this.storeValue('sequencer-workspace', state); } catch {}
				}

				async loadFiles(files) {
					this.workspaceReady = false;
					this.clearFrameUrls();
					const imageFiles = files
						.filter((file) => file.type.startsWith('image/'))
						.sort((a, b) => this.naturalCompare(a.webkitRelativePath || a.name, b.webkitRelativePath || b.name));

					this.frames = imageFiles.map((file, index) => ({
						id: `frame-${index}-${file.name}`,
						name: file.name,
						path: file.webkitRelativePath || file.name,
						sourcePath: file.webkitRelativePath || file.name,
						url: URL.createObjectURL(file),
					}));
					this.stopPlayback();

					const folderPath = imageFiles[0]?.webkitRelativePath || '';
					const folderName = folderPath.includes('/') ? folderPath.split('/')[0] : 'Selected frames';
					try { await this.storeValue('sequencer-files', imageFiles); } catch {}
					await this.restoreWorkspaceState(folderName);
					this.folderName.textContent = imageFiles.length > 0 ? folderName : 'No image frames found';
					this.folderMeta.textContent = imageFiles.length > 0
						? `${imageFiles.length} image frame${imageFiles.length === 1 ? '' : 's'} loaded locally`
						: 'Choose a folder containing PNG, WebP, JPEG, or GIF frames.';
					this.clearButton.disabled = imageFiles.length === 0;
					this.workspaceReady = imageFiles.length > 0;
					this.render();
				}

				toggleSelection(id) {
					if (!id) return;
					this.stopPlayback();
					const selectedIndex = this.selectedIds.indexOf(id);
					if (selectedIndex >= 0) {
						this.selectedIds.splice(selectedIndex, 1);
						this.currentIndex = Math.min(this.currentIndex, Math.max(0, this.selectedIds.length - 1));
					} else {
						this.selectedIds.push(id);
						this.currentIndex = this.selectedIds.length - 1;
					}
					this.render();
				}

				render() {
					this.renderSourceGrid();
					this.renderSequenceGrid();
					this.updateControls();
					this.updatePreview();
					this.scheduleWorkspaceSave();
				}

				renderSourceGrid() {
					this.sourceGrid.replaceChildren();
					if (this.frames.length === 0) {
						this.sourceGrid.append(this.createEmpty('No frames loaded', 'Choose a folder to populate this grid.'));
						return;
					}

					const sourceFrames = this.getSourceFrames();
					for (let index = 0; index < sourceFrames.length; index += 1) {
						const frame = sourceFrames[index];
						const selectedIndex = this.selectedIds.indexOf(frame.id);
						const selected = selectedIndex >= 0;
						const button = document.createElement('button');
						button.className = 'source-frame';
						button.type = 'button';
						button.dataset.sourceId = frame.id;
						button.setAttribute('aria-pressed', String(selected));
						button.setAttribute('aria-label', selected
							? `Remove ${frame.name} from sequence position ${selectedIndex + 1}`
							: `Select ${frame.name}`);
						button.append(
							this.createImage(frame),
							this.createCaption(frame, index + 1),
							this.createSelectionBadge(selectedIndex + 1),
						);
						this.sourceGrid.append(button);
					}
				}

				renderSequenceGrid() {
					this.sequenceGrid.replaceChildren();
					const selectedFrames = this.getSelectedFrames();
					if (selectedFrames.length === 0) {
						this.sequenceGrid.append(this.createEmpty('No selected frames', 'Selected folder frames appear here in animation order.'));
						return;
					}

					for (let index = 0; index < selectedFrames.length; index += 1) {
						const frame = selectedFrames[index];
						const figure = document.createElement('figure');
						figure.className = 'sequence-frame';
						figure.draggable = false;
						figure.dataset.sequenceId = frame.id;
						figure.setAttribute('aria-label', `Animation frame ${index + 1}: ${frame.name}. Drag to reorder.`);
						const order = document.createElement('span');
						order.className = 'order-badge';
						order.textContent = String(index + 1);
						const handle = document.createElement('span');
						handle.className = 'drag-handle';
						handle.textContent = '::';
						handle.setAttribute('aria-hidden', 'true');
						const remove = document.createElement('button');
						remove.className = 'remove-frame';
						remove.type = 'button';
						remove.dataset.removeId = frame.id;
						remove.textContent = 'X';
						remove.setAttribute('aria-label', `Remove sequence frame ${index + 1}: ${frame.name}`);
						figure.append(order, handle, remove, this.createImage(frame), this.createCaption(frame, index + 1));
						this.sequenceGrid.append(figure);
					}
				}

				createImage(frame) {
					const image = document.createElement('img');
					image.className = 'frame-image';
					image.src = frame.url;
					image.alt = frame.name;
					image.draggable = false;
					return image;
				}

				createCaption(frame, number) {
					const caption = document.createElement('div');
					caption.className = 'frame-caption';
					const file = document.createElement('span');
					file.className = 'frame-file';
					file.textContent = frame.name;
					const index = document.createElement('span');
					index.textContent = String(number).padStart(3, '0');
					caption.append(file, index);
					return caption;
				}

				createSelectionBadge(position) {
					const check = document.createElement('span');
					check.className = 'selection-check';
					check.textContent = position > 0 ? `#${position}` : '';
					check.setAttribute('aria-hidden', 'true');
					return check;
				}

				createEmpty(title, message) {
					const empty = document.createElement('div');
					empty.className = 'empty-state';
					const copy = document.createElement('p');
					const strong = document.createElement('strong');
					strong.textContent = title;
					const detail = document.createElement('span');
					detail.textContent = message;
					copy.append(strong, detail);
					empty.append(copy);
					return empty;
				}

				onPointerDown(event) {
					if (event.button !== 0) return;
					if (event.target instanceof Element && event.target.closest('[data-remove-id]')) return;
					const frame = event.target instanceof Element ? event.target.closest('[data-sequence-id]') : null;
					if (!(frame instanceof HTMLElement)) return;
					this.stopPlayback();
					this.draggedId = frame.dataset.sequenceId || '';
					this.pointerId = event.pointerId;
					this.pointerStart = { x: event.clientX, y: event.clientY };
					this.pointerMoved = false;
					frame.setPointerCapture?.(event.pointerId);
				}

				removeSelectedFrame(id) {
					const index = this.selectedIds.indexOf(id);
					if (index < 0) return;
					this.stopPlayback();
					this.selectedIds.splice(index, 1);
					const frame = this.frames.find((item) => item.id === id);
					if (frame?.isSequenceDuplicate) this.frames = this.frames.filter((item) => item.id !== id);
					this.currentIndex = Math.min(this.currentIndex, Math.max(0, this.selectedIds.length - 1));
					this.render();
				}

				duplicateCurrentFrame() {
					const selectedFrames = this.getSelectedFrames();
					const frame = selectedFrames[this.currentIndex];
					if (!frame) return;
					this.stopPlayback();
					const copyNumber = this.frames.filter((item) => item.duplicateOf === (frame.duplicateOf || frame.id)).length + 1;
					const duplicate = {
						...frame,
						id: `duplicate-${Date.now()}-${Math.random().toString(36).slice(2)}`,
						name: `${frame.name} copy ${copyNumber}`,
						isSequenceDuplicate: true,
						duplicateOf: frame.duplicateOf || frame.id,
						sourcePath: frame.sourcePath || frame.path,
					};
					this.frames.push(duplicate);
					this.selectedIds.splice(this.currentIndex + 1, 0, duplicate.id);
					this.currentIndex += 1;
					this.exportStatus.textContent = `Duplicated frame into sequence position ${this.currentIndex + 1}.`;
					this.render();
				}

				onPointerMove(event) {
					if (event.pointerId !== this.pointerId || !this.pointerStart) return;
					const distance = Math.hypot(event.clientX - this.pointerStart.x, event.clientY - this.pointerStart.y);
					if (!this.pointerMoved && distance < 6) return;
					this.pointerMoved = true;
					event.preventDefault();
					const dragged = this.sequenceGrid.querySelector(`[data-sequence-id="${CSS.escape(this.draggedId)}"]`);
					if (dragged instanceof HTMLElement) dragged.dataset.dragging = 'true';
					const target = document.elementFromPoint(event.clientX, event.clientY);
					const frame = target instanceof Element ? target.closest('[data-sequence-id]') : null;
					if (!(frame instanceof HTMLElement) || frame.dataset.sequenceId === this.draggedId) return;
					for (const item of this.sequenceGrid.querySelectorAll('[data-drop-target]')) item.removeAttribute('data-drop-target');
					frame.dataset.dropTarget = 'true';
				}

				onPointerUp(event) {
					if (event.pointerId !== this.pointerId) return;
					const target = document.elementFromPoint(event.clientX, event.clientY);
					const frame = target instanceof Element ? target.closest('[data-sequence-id]') : null;
					const targetId = frame instanceof HTMLElement ? frame.dataset.sequenceId || '' : '';
					const fromIndex = this.selectedIds.indexOf(this.draggedId);
					const toIndex = this.selectedIds.indexOf(targetId);
					if (this.pointerMoved && fromIndex >= 0 && toIndex >= 0 && fromIndex !== toIndex) {
						const [moved] = this.selectedIds.splice(fromIndex, 1);
						this.selectedIds.splice(toIndex, 0, moved);
						this.currentIndex = toIndex;
						this.suppressSequenceClick = true;
					}
					const shouldRender = this.pointerMoved;
					this.clearDragState();
					if (shouldRender) this.render();
				}

				clearDragState() {
					this.draggedId = '';
					this.pointerId = null;
					this.pointerStart = null;
					this.pointerMoved = false;
					for (const item of this.sequenceGrid.querySelectorAll('[data-dragging], [data-drop-target]')) {
						item.removeAttribute('data-dragging');
						item.removeAttribute('data-drop-target');
					}
				}

				togglePlayback() {
					if (this.animationTimer) this.stopPlayback();
					else this.startPlayback();
				}

				startPlayback() {
					if (this.selectedIds.length === 0) return;
					this.stopPlayback(false);
					this.playButton.textContent = 'Pause';
					const delay = Math.max(16, Math.round(1000 / this.getFps()));
					this.animationTimer = window.setInterval(() => {
						const isLast = this.currentIndex >= this.selectedIds.length - 1;
						if (isLast && !this.loopInput.checked) {
							this.stopPlayback();
							return;
						}
						this.currentIndex = isLast ? 0 : this.currentIndex + 1;
						this.updatePreview();
					}, delay);
				}

				stopPlayback(resetLabel = true) {
					if (this.animationTimer) window.clearInterval(this.animationTimer);
					this.animationTimer = 0;
					if (resetLabel && this.playButton) {
						this.playButton.textContent = 'Play';
						this.scheduleWorkspaceSave();
					}
				}

				step(direction) {
					if (this.selectedIds.length === 0) return;
					this.stopPlayback();
					this.currentIndex = (this.currentIndex + direction + this.selectedIds.length) % this.selectedIds.length;
					this.updatePreview();
					this.scheduleWorkspaceSave();
				}

				updatePreview() {
					const selectedFrames = this.getSelectedFrames();
					for (const item of this.sequenceGrid.querySelectorAll('[data-sequence-id]')) {
						item.removeAttribute('data-current');
					}
					if (selectedFrames.length === 0) {
						this.previewImage.hidden = true;
						this.previewImage.removeAttribute('src');
						this.hideOnionFrames();
						this.previewEmpty.hidden = false;
						this.frameStatus.textContent = 'Frame 0 / 0';
						this.progress.style.width = '0%';
						return;
					}

					this.currentIndex = Math.min(this.currentIndex, selectedFrames.length - 1);
					const frame = selectedFrames[this.currentIndex];
					this.previewImage.src = frame.url;
					this.previewImage.alt = `Preview ${frame.name}`;
					this.previewImage.hidden = false;
					this.previewEmpty.hidden = true;
					this.updateOnionFrames(selectedFrames);
					const currentTile = this.sequenceGrid.querySelector(`[data-sequence-id="${CSS.escape(frame.id)}"]`);
					if (currentTile instanceof HTMLElement) currentTile.dataset.current = 'true';
					this.frameStatus.textContent = `Frame ${this.currentIndex + 1} / ${selectedFrames.length}`;
					this.progress.style.width = `${((this.currentIndex + 1) / selectedFrames.length) * 100}%`;
				}

				updateOnionFrames(selectedFrames) {
					if (!this.onionSkinInput?.checked || selectedFrames.length < 2) {
						this.hideOnionFrames();
						return;
					}

					const wraps = this.loopInput?.checked;
					const previousIndex = this.currentIndex > 0
						? this.currentIndex - 1
						: wraps ? selectedFrames.length - 1 : -1;
					const nextIndex = this.currentIndex < selectedFrames.length - 1
						? this.currentIndex + 1
						: wraps ? 0 : -1;

					this.setOnionFrame(this.onionPreviousImage, previousIndex >= 0 ? selectedFrames[previousIndex] : null);
					this.setOnionFrame(this.onionNextImage, nextIndex >= 0 ? selectedFrames[nextIndex] : null);
				}

				setOnionFrame(image, frame) {
					if (!(image instanceof HTMLImageElement)) return;
					if (!frame) {
						image.hidden = true;
						image.removeAttribute('src');
						return;
					}
					image.src = frame.url;
					image.alt = `${image === this.onionPreviousImage ? 'Previous' : 'Next'} onion-skin frame: ${frame.name}`;
					image.hidden = false;
				}

				hideOnionFrames() {
					this.setOnionFrame(this.onionPreviousImage, null);
					this.setOnionFrame(this.onionNextImage, null);
				}

				updateControls() {
					const sourceFrames = this.getSourceFrames();
					const hasFrames = sourceFrames.length > 0;
					const hasSelection = this.selectedIds.length > 0;
					this.sourceCount.textContent = `${sourceFrames.length} frame${sourceFrames.length === 1 ? '' : 's'}`;
					this.selectedCount.textContent = `${this.selectedIds.length} selected`;
					this.selectAllButton.disabled = !hasFrames || sourceFrames.every((frame) => this.selectedIds.includes(frame.id));
					this.clearSelectionButton.disabled = !hasSelection;
					this.playButton.disabled = !hasSelection;
					this.prevButton.disabled = !hasSelection;
					this.nextButton.disabled = !hasSelection;
					this.duplicateFrameButton.disabled = !hasSelection;
					this.saveUnityButton.disabled = !hasSelection;
					if (!hasSelection) this.exportStatus.textContent = 'Select frames to enable export.';
				}

				async saveForUnity() {
					if (this.selectedIds.length === 0) return;
					this.stopPlayback();
					this.saveUnityButton.disabled = true;
					this.exportStatus.textContent = 'Building Unity sprite sheet...';

					try {
						const unityPackage = await this.buildUnityPackage();
						await this.saveUnityFiles(unityPackage);
						this.exportStatus.textContent = `Saved ${unityPackage.frameCount} frames at ${unityPackage.fps} FPS for Unity.`;
					} catch (error) {
						if (error instanceof DOMException && error.name === 'AbortError') {
							this.exportStatus.textContent = 'Save cancelled.';
						} else {
							this.exportStatus.textContent = error instanceof Error ? error.message : 'Unity export failed.';
						}
					} finally {
						this.saveUnityButton.disabled = this.selectedIds.length === 0;
					}
				}

				async buildUnityPackage() {
					const selectedFrames = this.getSelectedFrames();
					const images = await Promise.all(selectedFrames.map((frame) => this.loadImage(frame.url)));
					const cellWidth = Math.max(...images.map((image) => image.naturalWidth));
					const cellHeight = Math.max(...images.map((image) => image.naturalHeight));
					const layout = this.findSheetLayout(selectedFrames.length, cellWidth, cellHeight);
					const canvas = document.createElement('canvas');
					canvas.width = layout.columns * cellWidth;
					canvas.height = layout.rows * cellHeight;
					const context = canvas.getContext('2d', { alpha: true });
					if (!context) throw new Error('Canvas context unavailable.');
					context.imageSmoothingEnabled = false;

					const frames = images.map((image, index) => {
						const column = index % layout.columns;
						const row = Math.floor(index / layout.columns);
						const offsetX = Math.floor((cellWidth - image.naturalWidth) / 2);
						const offsetY = cellHeight - image.naturalHeight;
						context.drawImage(image, column * cellWidth + offsetX, row * cellHeight + offsetY);
						return {
							index: index + 1,
							source: selectedFrames[index].name,
							column,
							row,
							x: column * cellWidth,
							y: row * cellHeight,
							width: cellWidth,
							height: cellHeight,
							sourceWidth: image.naturalWidth,
							sourceHeight: image.naturalHeight,
							offsetX,
							offsetY,
						};
					});

					const sheetBlob = await new Promise((resolve) => canvas.toBlob(resolve, 'image/png'));
					if (!(sheetBlob instanceof Blob)) throw new Error('Sprite sheet export failed.');
					const baseName = this.safeFileName(this.folderName.textContent || 'character-animation');
					const fps = this.getFps();
					const metadata = {
						format: 'video-to-animation-unity-sprite-sheet',
						version: 1,
						name: baseName,
						frameCount: selectedFrames.length,
						fps,
						loop: Boolean(this.loopInput.checked),
						anchor: 'bottom-center',
						sheet: {
							file: `${baseName}-spritesheet.png`,
							width: canvas.width,
							height: canvas.height,
							columns: layout.columns,
							rows: layout.rows,
							cellWidth,
							cellHeight,
						},
						unityImport: {
							textureType: 'Sprite (2D and UI)',
							spriteMode: 'Multiple',
							slice: `Grid by Cell Size: ${cellWidth} x ${cellHeight}`,
							pivot: 'Bottom Center',
							animationSampleRate: fps,
						},
						frames,
					};
					return {
						baseName,
						frameCount: selectedFrames.length,
						fps,
						sheetBlob,
						metadataBlob: new Blob([JSON.stringify(metadata, null, 2)], { type: 'application/json' }),
						metadata,
					};
				}

				loadImage(url) {
					return new Promise((resolve, reject) => {
						const image = new Image();
						image.onload = () => resolve(image);
						image.onerror = () => reject(new Error('Could not read one of the selected frames.'));
						image.src = url;
					});
				}

				findSheetLayout(frameCount, cellWidth, cellHeight) {
					const maxTextureSize = 8192;
					let best = null;
					for (let columns = 1; columns <= frameCount; columns += 1) {
						if (frameCount % columns !== 0) continue;
						const rows = frameCount / columns;
						const width = columns * cellWidth;
						const height = rows * cellHeight;
						if (width > maxTextureSize || height > maxTextureSize) continue;
						const score = Math.max(width, height) + Math.abs(width - height) * 0.15;
						if (!best || score < best.score || (score === best.score && width > best.width)) {
							best = { columns, rows, score, width };
						}
					}
					if (!best) throw new Error('Frames cannot fit an exact 8192px Unity grid. Use smaller frames or a different frame count.');
					return best;
				}

				async saveUnityFiles(unityPackage) {
					if ('showDirectoryPicker' in window) {
						let directory = this.directoryHandle || await this.getStoredDirectoryHandle();
						if (!directory || await this.ensureDirectoryPermission(directory, true) !== 'granted') {
							directory = await window.showDirectoryPicker({ mode: 'readwrite' });
						}
						this.directoryHandle = directory;
						await this.storeDirectoryHandle(directory);
						await Promise.all([
							this.writeFile(directory, `${unityPackage.baseName}-spritesheet.png`, unityPackage.sheetBlob),
							this.writeFile(directory, `${unityPackage.baseName}-sequence.json`, unityPackage.metadataBlob),
						]);
						return;
					}
					this.downloadBlob(`${unityPackage.baseName}-spritesheet.png`, unityPackage.sheetBlob);
					window.setTimeout(() => this.downloadBlob(`${unityPackage.baseName}-sequence.json`, unityPackage.metadataBlob), 150);
				}

				async writeFile(directory, name, blob) {
					const handle = await directory.getFileHandle(name, { create: true });
					const writable = await handle.createWritable();
					await writable.write(blob);
					await writable.close();
				}

				downloadBlob(name, blob) {
					const url = URL.createObjectURL(blob);
					const link = document.createElement('a');
					link.href = url;
					link.download = name;
					link.click();
					window.setTimeout(() => URL.revokeObjectURL(url), 1000);
				}

				safeFileName(value) {
					return value
						.trim()
						.toLowerCase()
						.replace(/[^a-z0-9]+/g, '-')
						.replace(/^-+|-+$/g, '') || 'character-animation';
				}

				getSelectedFrames() {
					const frameMap = new Map(this.frames.map((frame) => [frame.id, frame]));
					return this.selectedIds.map((id) => frameMap.get(id)).filter(Boolean);
				}

				getSourceFrames() {
					return this.frames.filter((frame) => !frame.isSequenceDuplicate);
				}

				getFps() {
					return Math.min(60, Math.max(1, Math.round(Number(this.fpsInput.value) || 8)));
				}

				naturalCompare(a, b) {
					return a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' });
				}

				clearFrameUrls() {
					for (const url of new Set(this.frames.map((frame) => frame.url))) URL.revokeObjectURL(url);
				}

				async clear() {
					this.stopPlayback();
					this.workspaceReady = false;
					window.clearTimeout(this.workspaceSaveTimer);
					try { await this.deleteStoredWorkspace(); } catch {}
					this.clearFrameUrls();
					this.frames = [];
					this.selectedIds = [];
					this.currentIndex = 0;
					this.directoryHandle = null;
					if (this.folderInput) this.folderInput.value = '';
					this.folderName.textContent = 'No folder selected';
					this.folderMeta.textContent = 'Choose a folder containing PNG, WebP, JPEG, or GIF frames.';
					this.folderButton.textContent = 'Choose frames folder';
					this.clearButton.disabled = true;
					this.render();
				}
			}

			customElements.define('frame-sequencer-app', FrameSequencerApp);
		</script>
	</body>
</html>
